{% if settings.breadcrumbs_enable %}
  {%- liquid
    if template contains 'article'
      assign class_br = 'breadcrumb_inner'
    elsif template contains 'product'
      assign class_br = 'breadcrumb_product'
    elsif template contains 'collection'
      assign class_br = 'breadcrumb_collection'
    elsif template contains 'blog'
      assign class_br = 'breadcrumb_inner'
    else
      assign class_br = 'breadcrumb_inner'
    endif
    if collection.image != blank
      assign breadcrumb_bg_img = collection.image | image_url: width: 1920
    elsif settings.breadcrumb_collection_image != blank
      assign breadcrumb_bg_img = settings.breadcrumb_collection_image | image_url: width: 1920
    endif
  -%}
  <section id="NovBreadcrumbs" class="{{ class_br }}{% if collection.handle == 'flash-deals' %} collection-deal{% endif %}{% if class_br == 'breadcrumb_collection' and settings.breadcrumb_collection_border %} bd-t{% endif %}">
    <div class="container position-relative">
      {% if class_br != 'breadcrumb_product' %}
        <div class="headingBreacrumb text-uppercase f_pr font-500 mb-5 position-relative">
          {% if template contains 'collection' %}
            {% if collection.handle == 'all' or request.path == '/collections/all' %}
              Shop
            {% else %}
              {{ collection.title }}
            {% endif %}
          {% elsif template contains 'product' %}
            {{ product.title }}
          {% elsif template contains 'blog' %}
            {{ blog.title }}
          {% elsif template contains 'article' %}
            {{ article.title }}
          {% elsif template contains 'page' %}
            {{ page.title }}
          {% else %}
            {{ page_title }}
          {% endif %}
        </div>
        <h1 class="headingBreacrumb text-uppercase f_pr font-500 mb-5 position-relative d-none">{{ page_title }}</h1>
      {% endif %}
      <ol class="breadcrumb">
        <li class="list-inline-item">
          <a href="{{ routes.root_url }}" class="item-breacrumb item-home">{{ 'general.breadcrumbs.home' | t }}</a>
        </li>
        {% if template contains 'article' %}
          <li class="list-inline-item"><a href="{{ blog.url }}" class="item-breacrumb">{{ blog.title }}</a></li>
          <li class="list-inline-item"><span class="item-breacrumb">{{ article.title }}</span></li>
        {% elsif template contains 'product' %}
          {% if collection %}
            {% if collection.handle %}
              {% capture url %}/collections/{{ collection.handle }}{% endcapture %}
              <li class="list-inline-item">
                <a href="{{ url }}" class="item-breacrumb">
                  {%- if collection.handle == 'all' or request.path == '/collections/all' -%}Shop{%- else -%}{{ collection.title }}{%- endif -%}
                </a>
              </li>
            {% endif %}
          {% endif %}
          <li class="list-inline-item"><span class="item-breacrumb">{{ product.title }}</span></li>
        {% elsif template contains 'collection' and collection.handle %}
          {% if current_tags %}
            {% capture url %}/collections/{{ collection.handle }}{% endcapture %}
            <li class="list-inline-item">
              <a href="{{ url }}" class="item-breacrumb">
                {%- if collection.handle == 'all' or request.path == '/collections/all' -%}Shop{%- else -%}{{ collection.title }}{%- endif -%}
              </a>
            </li>
            <li class="list-inline-item"><span class="item-breacrumb">{{ current_tags | join: " + " }}</span></li>
          {% else %}
            <li class="list-inline-item">
              <span class="item-breacrumb">
                {%- if collection.handle == 'all' or request.path == '/collections/all' -%}Shop{%- else -%}{{ collection.title }}{%- endif -%}
              </span>
            </li>
          {% endif %}
        {% elsif template contains 'blog' %}
          {% if current_tags %}
            <li class="list-inline-item"><a href="{{ blog.url }}" class="item-breacrumb">{{ blog.title }}</a></li>
            <li class="list-inline-item"><span class="item-breacrumb">{{ current_tags | join: " + " }}</span></li>
          {% else %}
            <li class="list-inline-item"><span class="item-breacrumb">{{ blog.title }}</span></li>
          {% endif %}
        {% elsif template contains 'page' %}
          <li class="list-inline-item"><span class="item-breacrumb">{{ page.title }}</span></li>
        {% else %}
          <li class="list-inline-item">
            {% if custom_pagetitle != blank %}
              <span class="item-breacrumb">{{ custom_pagetitle }}</span>
            {% else %}
              <span class="item-breacrumb">{{ page_title }}</span>
            {% endif %}
          </li>
        {% endif %}
      </ol>
      {% if collection.handle == 'flash-deals' and template.name contains 'collection' %}
        <div class="breadcrumb-deal d-flex align-items-center">
          {% if settings.icon_deal != blank %}
            <img src="{{ settings.icon_deal | image_url: width: 35 }}" class="breadcrumb-deal-i" width="35" height="35" style="height: auto;">
          {% endif %}
          {% if settings.countdown_deal_t != blank %}
            <div class="breadcrumb-deal-t font-800 f_pr c_h">{{ settings.countdown_deal_t }}</div>
          {% endif %}
          <div class="countdownfree" data-countdown="{{ settings.countdown_deal }}" data-show-days="{{ settings.show_day }}" data-restart="{{ settings.restart }}"></div>
        </div>
      {% endif %}
    </div>
  </section>

  {% style %}
    {% if template contains 'collection' and breadcrumb_bg_img != blank %}
      #NovBreadcrumbs {
        background-image: url('{{ breadcrumb_bg_img }}');
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
      }
    {% endif %}
    
    {% if template contains 'product' and settings.breadcrumb_product_image != blank %}
      #NovBreadcrumbs {
        background-image: url('{{ settings.breadcrumb_product_image | image_url: width: 1920 }}');
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
      }
    {% endif %}
    
    {% unless template contains 'product' or template contains 'collection' %}
      {% if settings.breadcrumb_inner_image != blank %}
        #NovBreadcrumbs.breadcrumb_inner {
          background-image: url('{{ settings.breadcrumb_inner_image | image_url: width: 2560 }}');
          background-position: center;
          background-size: cover;
          background-repeat: no-repeat;
        }
      {% endif %}
    {% endunless %}
  {% endstyle %}
{% endif %}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ shop.url }}"
      }
      {% if collection %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": "{{ collection.title | escape }}",
        "item": "{{ shop.url }}/collections/{{ collection.handle }}"
      }
      {% endif %}
      {% if product %}
      ,{
        "@type": "ListItem",
        "position": 3,
        "name": "{{ product.title | escape }}",
        "item": "{{ shop.url }}{{ product.url }}"
      }
      {% endif %}
    ]
  }
  </script>