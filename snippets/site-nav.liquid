<ul class="site-nav d-flex align-items-center">
  {% for link in linklists[mainmenu].links %}
    {%- assign is_mega = false -%}
    {%- assign is_icon = false -%}
    {%- assign three_level_nav = false -%}
    {%- assign child_list_handle = link.title | handleize -%}

    {% if linklists[child_list_handle].links != blank %}
      {% for childlink in linklists[child_list_handle].links %}
        {% assign grand_child_list_handle = childlink.title | handleize %}
        {% if linklists[grand_child_list_handle].links != blank %}
          {%- assign three_level_nav = true -%}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% for block in section.blocks %}
      {% if block.type == 'megamenu' %}
        {% assign menu_item = link.title %}
        {% if block.settings.title == menu_item %}
          <li class="nav--lv1 parent--lv1 site-nav--Megamenu{% if link.active %} site-nav--active{% endif %}">
            <a class="site-nav__link--main {{ section.settings.menu_ff }}" href="{{ link.url }}" title="{{ link.title }}">
              {% if block.settings.icon_menu != blank %}
              <div class="site-nav--icon">
                <img class="img-fluid" src="{{ block.settings.icon_menu | image_url: width: 50 }}" width="50" height="{{ 50 | divided_by: block.settings.icon_menu.aspect_ratio | round }}" alt="image" />
              </div>
              {% endif %}
              <div class="site-nav--title">
                <span>{{- link.title -}}</span>
                {% render 'icon-arrow-down' %}
              </div>
            </a>
            <div class="nav-dropdown--lv1 megaMenu{% if block.settings.type_width == 'full' %} site-nav--fw{% endif %} color-{{ color }}" style="{% if block.settings.img_bg != blank %}background-image: url({{ block.settings.img_bg | image_url: width: 1024 }});background-repeat: no-repeat;background-size: cover;{% endif %}--width: {{ block.settings.custom_width | default: 1440 }}px;">
              <div class="site-nav__mega--content{% if block.settings.type_width == 'full' %}{% if section.settings.container == 'container-full' %} container-fluid{% else %} container{% endif %}{% endif %}">
                <div class="row">
                  {% if block.settings.collection_enable %}
                    <div class="{{ block.settings.collection_xl }} site--nav-collection">
                      {% for i in (1..5) %}
                        {%- assign name_collec_id = 'name_collec_' | append: i -%}
                        {%- assign link_id = 'link_' | append: i -%}
                        {% if block.settings[name_collec_id] != blank %}
                          <div class="nav--collec-item">
                            <a href="{{ block.settings[link_id] }}">
                              <span>{{ block.settings[name_collec_id] }}</span>
                              <i class="zmdi zmdi-chevron-right"></i>
                            </a>
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% endif %}
                  <div class="{{ block.settings.novmenu_xl }}">
                    <div class="row">
                      {% for novLink1 in linklists[child_list_handle].links %}
                      {% assign link_handle = novLink1.title | handleize %}
                      <div class="{{ block.settings.submenu_xl }} {{ block.settings.submenu_lg }} mb-md-20">
                        <ul class="site-nav--MenuLinks p-0">
                          <li{% if three_level_nav %} class="site-nav__link--title{% if block.settings.show_title == false %} hidden{% endif %}"{% endif %}>
                            <a href="{{ novLink1.url }}">{{ novLink1.title }}</a>
                          </li>
                          {% for novLink2 in linklists[link_handle].links %}
                            <li>
                              <a href="{{ novLink2.url }}" class="site-nav__link">{{ novLink2.title }}</a>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                      {% endfor %}
                    </div>
                  </div>

                  {% for i in (1..3) %}
                    {%- assign novmenu_banner_enable_id = 'novmenu_banner_enable' | append: i -%}
                    {%- assign banner_xl_id = 'banner_xl_' | append: i -%}
                    {%- assign class_bn_id = 'class_bn' | append: i -%}
                    {%- assign novmenu_banner_link_id = 'novmenu_banner_link' | append: i -%}
                    {%- assign novmenu_banner_id = 'novmenu_banner' | append: i -%}
                    {%- assign novmenu_banner_text_id = 'novmenu_banner_text' | append: i -%}
                    {%- assign novmenu_banner_text_color_id = 'novmenu_banner_text_color' | append: i -%}
                    
                    {% if block.settings[novmenu_banner_enable_id] %}
                      <div class="{{ block.settings[banner_xl_id] }}{% if block.settings[class_bn_id] != blank %} {{ block.settings[class_bn_id] }}{% endif %}">
                        <div class="novMenuBanner position-relative {{ novmenu_banner_text_id }}" style="border-radius: {{ block.settings.banner_br }}px; overflow: hidden;">
                          {% if block.settings[novmenu_banner_link_id] != blank %}<a href="{{ block.settings[novmenu_banner_link_id] }}">{% endif %}
                            {% if block.settings[novmenu_banner_id] != blank %}
                              {% render 'nov-imgset', image: block.settings[novmenu_banner_id] %}
                            {% else %}
                              {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                              {{ 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                            {% endif %}
                          {% if block.settings[novmenu_banner_link_id] != blank %}</a>{% endif %}
                          {% if block.settings[novmenu_banner_text_id] != blank %}
                            <div class="position-absolute top-center text-center color-title fs-20 font-700 color-{{ block.settings[novmenu_banner_text_color_id] }} w-100 p-2">
                              {{ block.settings[novmenu_banner_text_id] }}
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}

                  {% if block.settings.product_enable %}
                    <div class="{{ block.settings.product_xl }} nav--product mt-sm-30" data-section-type="nov-slick">
                      <div class="site-nav--title__product">
                        <span>{{ block.settings.title_product }}</span>
                      </div>
                      <div class="nov-slick-carousel grid--view-items row spacing-10" data-autoplay="{{ block.settings.autoplay }}" data-loop="true" data-row="1" data-items_xxl="1" data-nav="false" data-dots="false">
                        {% for product in block.settings.product_list %}
                          <div class="item sp-item">
                            <div class="item-product mb-0{% if settings.show_border_product %} h_bd{% endif %}{% if settings.show_background_product %} bg{% endif %}">
                              <div class="thumbnail-container">
                                {% assign img_url = product.featured_image %}
                                <div class="card_media relative overflow-hidden" style="aspect-ratio: {{ settings.aspect_product_image }}">
                                  <img class="product__thumbnail"
                                  src="{{ img_url | image_url: width: 260 }}"
                                  srcset="{{ img_url | image_url: width: 360 }} 360w, {{ img_url | image_url: width: 540 }} 540w, {{ img_url | image_url: width: 720 }} 720w, {{ img_url | image_url: width: 900 }} 900w, {{ img_url | image_url: width: 1080 }} 1080w, {{ img_url | image_url: width: 1400 }} 1400w"
                                  sizes="(max-width: 768px) 50vw, (max-width: 992px) 33vw, (max-width: 1200px) 25vw, 20vw"
                                  alt="{{ img_url.alt }}"
                                  width="{{ img_url.width }}"
                                  height="{{ img_url.height }}"
                                  loading="lazy"
                                  style="height: auto;">
                                  <a href="{{ product.url }}" class="absolute t-0 l-0 z-2 w-100 h-100"></a>
                                </div>
                              </div>
                              <div class="product__info">
                                <div class="product__title {{ settings.title_product_line }}">
                                  <a href="{{ product.url }}">{{ product.title }}</a>
                                </div>
                                <div class="product__price price-box price-st d-flex align-items-center">
                                  {% render 'nov-product-price', product: product %}
                                </div>
                              </div>
                            </div>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}

                  {% if block.settings.blog_enable %}
                    <div class="{{ block.settings.blog_xl }} nav--blog mt-sm-30" data-section-type="nav-blog-slick">
                      <div class="site-nav--title__blog">
                        <span>{{ block.settings.title_blog }}</span>
                      </div>
                      <div class="nav-blog-slick-carousel grid--view-items row spacing-10" 
                        data-autoplay="{{ block.settings.autoplay_blog }}" 
                        data-loop="true" 
                        data-row="2" 
                        data-items_xxl="1" 
                        data-nav="false" 
                        data-dots="false">
                        {% assign blog_limit = block.settings.blog_limit %}
                        {% assign blog = blogs[block.settings.blog] %}
                        {% for article in blog.articles limit: blog_limit %}
                          <div class="item sp-item">
                            <div class="item-blog d-flex align-items-center mb-15">
                              <div class="article__card position-relative overflow_hidden h-100">
                                {% render 'nov-imgset', image: article.image %}
                                <a href="{{ article.url }}" class="absolute t-0 l-0 z-2 w-100 h-100"></a>
                              </div>
                              <div class="article__info">
                                <div class="article__title line-clamp-2 mb-5">
                                  <a href="{{ article.url }}" class="fs-14 fs-md-12 font-700 lh-22 color-title">{{ article.title }}</a>
                                </div>
                                {% if block.settings.author_enable and block.settings.date_enable %}
                                  <div class="article_cs d-flex align-items-center justify-content-between">
                                    {% if block.settings.author_enable %}
                                      <span class="article__author fs-10 font-400 lh-20 text-uppercase d-flex align-items-center">
                                        {% render 'icon-account' %}
                                        {{ article.author }}
                                      </span>
                                    {% endif %}
                                    {% if block.settings.date_enable %}
                                      <span class="article__date fs-10 font-400 lh-20 text-uppercase">{{ article.published_at | date: "%B" }} {{ article.published_at | date: "%d" }}, {{ article.published_at | date: "%Y" }}</span>
                                    {% endif %}
                                  </div>
                                {% endif %}
                                {% if block.settings.comment_enable %}
                                  <div class="article__comment d-flex align-items-center fs-10 font-400 lh-20 text-uppercase">
                                    {% render 'icon-comment' %}
                                    <span>{{ 'blogs.comments.comments_with_count.other' | t: count: article.comments_count }}</span>
                                  </div>
                                {% endif %}
                              </div>
                            </div>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          </li>
          {% assign is_mega = true %}
          {% break %}
        {% endif %}
      {% endif %}
      {% if block.type == 'icon_menu' %}
        {% assign menu_item = link.title %}
        {% if block.settings.title == menu_item %}
          {% if linklists[child_list_handle].links != blank %}
            <li class="nav--lv1 parent--lv1 site-nav--Default{{ class_hidden }}{% if active %} site-nav--active{% endif %}{% if forloop.last %} last{% endif %}">
              <a href="{{ link.url }}" class="site-nav__link--main d-flex align-items-center {{ section.settings.menu_ff }}" title="{{ link.title }}">
                {% if block.settings.icon_menu != blank %}
                  <div class="site-nav--icon">
                    <img class="img-fluid" src="{{ block.settings.icon_menu | image_url: width: 50 }}" width="50" height="{{ 50 | divided_by: block.settings.icon_menu.aspect_ratio | round }}" alt="image" alt="{{ block.settings.icon_menu.alt }}" />
                  </div>
                {% endif %}
                <div class="site-nav--title">
                {{- link.title -}}
                </div>
              </a>
              <div class="nav-dropdown--lv1 MenuDefault color-{{ color }}">
                {% if three_level_nav %}
                  {% if linklists[child_list_handle].links != blank %}
                    <ul>
                      {% for childlink in linklists[child_list_handle].links %}
                        {% assign grand_child_list_handle = childlink.title | handle %}
                        <li class="nav--lv2 parent--lv2">
                          <a href="{{ childlink.url }}" class="site-nav__link--second site-nav__link">
                            <span>{{ childlink.title | escape }}</span>
                            {% if linklists[grand_child_list_handle].links != blank %}
                            <span class="site-nav--direc"><i class="zmdi zmdi-chevron-right"></i></span>
                            {% endif %}
                          </a>
                          {% if linklists[grand_child_list_handle].links != blank %}
                          <div class="nav-dropdown--lv2">
                            <ul>
                              {% for grandchildlink in linklists[grand_child_list_handle].links %}
                                <li>
                                  <a href="{{ grandchildlink.url }}" class="site-nav__link">{{ grandchildlink.title | escape }}</a>
                                </li>
                              {% endfor %}
                            </ul>
                          </div>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                {% else %}
                  <ul>
                    {% for childlink in linklists[child_list_handle].links %}
                      <li {% if childlink.active %}class="site-nav--active"{% endif %}>
                        <a href="{{ childlink.url }}" class="site-nav__link">{{ childlink.title | escape }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            </li>
          {% else %}
            <li class="nav--lv1{% if active %} site-nav--active{% endif %}{{ class_hidden }}{% if forloop.last %} last{% endif %}">
              <a href="{{ link.url }}" class="site-nav__link--main d-flex align-items-center {{ section.settings.menu_ff }}" title="{{ link.title }}">
                {% if block.settings.icon_menu != blank %}
                  <div class="site-nav--icon">
                    <img class="img-fluid" src="{{ block.settings.icon_menu | image_url: width: 50 }}" width="50" height="{{ 50 | divided_by: block.settings.icon_menu.aspect_ratio | round }}" alt="image" style="height: auto" alt=""/>
                  </div>
                {% endif %}
                <div class="site-nav--title">
                  {{- link.title -}}
                </div>
              </a>
            </li>
          {% endif %}
          {% assign is_icon = true %}
          {% break %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {% if is_mega == false and is_icon == false %}
      {% if linklists[child_list_handle].links != blank %}
        <li class="nav--lv1 parent--lv1 site-nav--Default{% if link.active %} site-nav--active{% endif %}">
          <a href="{{ link.url }}" class="site-nav__link--main {{ section.settings.menu_ff }}" title="{{ link.title }}">
            <span class="site-nav--title">{{- link.title -}}</span>
            {% render 'icon-arrow-down' %}
          </a>
          <div class="nav-dropdown--lv1 MenuDefault color-{{ color }}">
            {% if three_level_nav %}
              {% if linklists[child_list_handle].links != blank %}
                <ul>
                  {% for childlink in linklists[child_list_handle].links %}
                    {% assign grand_child_list_handle = childlink.title | handle %}
                    <li class="nav--lv2 parent--lv2">
                      <a href="{{ childlink.url }}" class="site-nav__link--second site-nav__link">
                        <span>{{ childlink.title | escape }}</span>
                        {% if linklists[grand_child_list_handle].links != blank %}
                        <span class="site-nav--direc"><i class="zmdi zmdi-chevron-right"></i></span>
                        {% endif %}
                      </a>
                      {% if linklists[grand_child_list_handle].links != blank %}
                      <div class="nav-dropdown--lv2">
                        <ul>
                          {% for grandchildlink in linklists[grand_child_list_handle].links %}
                            <li>
                              <a href="{{ grandchildlink.url }}" class="site-nav__link">{{ grandchildlink.title | escape }}</a>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            {% else %}
              <ul>
                {% for childlink in linklists[child_list_handle].links %}
                  <li {% if childlink.active %}class="site-nav--active"{% endif %}>
                    <a href="{{ childlink.url }}" class="site-nav__link">{{ childlink.title | escape }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </li>
      {% else %}
        <li class="nav--lv1{% if link.active %} site-nav--active{% endif %}">
          <a href="{{ link.url }}" class="site-nav__link--main {{ section.settings.menu_ff }}" title="{{ link.title }}">
            <span class="site-nav--title">{{ link.title }}</span>
          </a>
        </li>
      {% endif %}
    {% endif %}
  {% endfor %}
</ul>
