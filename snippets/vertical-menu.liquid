<div id="desktopVerticalMenu">
  <ul class="site-nav-vertical list-unstyled" style="color: {{ section.settings.color }};font-size: {{ section.settings.font_size | append: 'px' }};font-weight: {{ section.settings.font_weight }};text-transform: {{ section.settings.text_transform }};line-height: {% if section.settings.line_height == 1 %}1{% else %}{{ section.settings.line_height | append: 'px' }}{% endif %};--line-height-mb: 1.5;--padding: {{ section.settings.padding | append: 'px' }};">
    {% for link in linklists[vertical_menu].links %}
      {% liquid
        assign is_mega = false
        assign is_icon = false
        assign child_list_handle = link.title | handleize
        assign child_links = link.links
        if child_links == empty or child_links == blank
          assign child_links = linklists[child_list_handle].links
        endif

        assign three_level_nav = false
        if link.levels >= 2
          assign three_level_nav = true
        else
          for childlink in child_links
            assign grand_child_handle = childlink.title | handleize
            if childlink.links != blank or linklists[grand_child_handle].links != blank
              assign three_level_nav = true
              break
            endif
          endfor
        endif
      %}

      {% for block in section.blocks %}
        {% liquid
          assign block_title = block.settings.title | default: block.settings.name_item
        %}

        {% comment %}======================== MEGAMENU =============================={% endcomment %}
        {% if block.type == 'megamenu' and block_title == link.title %}
          {% assign is_mega = true %}
          <li class="nav--lv1{% if child_links != blank %} parent--lv1{% endif %} site-nav--Megamenu{% if link.active %} site-nav--active{% endif %}" style="--td: {{ forloop.parentloop.index | times: 0.2 }}s">
            <a class="site-nav__link--main" href="{{ link.url }}" title="{{ link.title }}">
              {% if block.settings.show_icon and block.settings.icon_menu != blank %}
                <div class="site-nav--icon" style="--icon-width: {{ block.settings.icon_width | append: 'px' }};">
                  <img class="img-fluid" src="{{ block.settings.icon_menu | image_url: width: 50 }}" width="50" height="50" alt="{{ block.settings.icon_menu.alt | default: link.title }}" loading="lazy" />
                </div>
              {% endif %}
              <div class="site-nav--title"><span>{{ link.title }}</span></div>
              {% if child_links != blank %}
                <div class="nav-direc">{% render 'icon-arrow-next' %}</div>
              {% endif %}
            </a>
            {% if child_links != blank %}
              <div class="nav-dropdown--lv1 megaMenu{% if block.settings.type_width == 'full' %} site-nav--fw{% endif %}" style="{% if block.settings.img_bg != blank %}background-image: url({{ block.settings.img_bg | image_url: width: 1024 }});background-repeat: no-repeat;background-size: cover;{% endif %}--width: {{ block.settings.custom_width | default: 1170 | append: 'px' }};">
                <div class="site-nav__mega--content row">
                  {% if block.settings.collection_enable %}
                    <div class="{{ block.settings.collection_xl }} site--nav-collection mb-md-30">
                      {% for i in (1..5) %}
                        {% liquid
                          assign name_collec_id = 'name_collec_' | append: i
                          assign link_id = 'link_' | append: i
                          assign collec_name = block.settings[name_collec_id]
                          assign collec_link = block.settings[link_id]
                        %}
                        {% if collec_name != blank %}
                          <div class="nav--collec-item">
                            <a href="{{ collec_link }}">
                              <span>{{ collec_name }}</span>
                              {% render 'icon-arrow-next' %}
                            </a>
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% endif %}

                  <div class="{{ block.settings.novmenu_xl }} pt-15">
                    <div class="row spacing-0">
                      {% for novLink1 in child_links %}
                        {% liquid
                          assign link_handle = novLink1.title | handleize
                          assign grand_links = novLink1.links
                          if grand_links == empty or grand_links == blank
                            assign grand_links = linklists[link_handle].links
                          endif
                        %}
                        <div class="{{ block.settings.submenu_xl }}{% if three_level_nav %} mb-20{% endif %}">
                          <ul class="site-nav--MenuLinks" style="font-size: {{ block.settings.font_size | append: 'px' }};font-weight: {{ block.settings.font_weight }};text-transform: {{ block.settings.text_transform }};line-height: {% if block.settings.line_height == 1 %}1{% else %}{{ block.settings.line_height | append: 'px' }}{% endif %};--line-height-mb: 1.5;--padding: {{ block.settings.padding | append: 'px' }};">
                            <li{% if three_level_nav %} class="site-nav__link--title{% if block.settings.show_title == false %} hidden{% endif %}"{% endif %} {% if three_level_nav %}style="font-size: {{ block.settings.font_size_title | append: 'px' }};font-weight: {{ block.settings.font_weight_title }};text-transform: {{ block.settings.text_transform_title }};line-height: {% if block.settings.line_height_title == 1 %}1{% else %}{{ block.settings.line_height_title | append: 'px' }}{% endif %};--line-height-mb: 1.5;"{% endif %}>
                              <a href="{{ novLink1.url }}" class="d-inline-flex relative"><span>{{ novLink1.title }}</span></a>
                            </li>
                            {% for novLink2 in grand_links %}
                              <li>
                                <a href="{{ novLink2.url }}" class="site-nav__link d-inline-flex relative"><span>{{ novLink2.title }}</span></a>
                              </li>
                            {% endfor %}
                          </ul>
                        </div>
                      {% endfor %}
                    </div>
                  </div>

                  {% for i in (1..3) %}
                    {% liquid
                      assign banner_enable_id = 'novmenu_banner_enable' | append: i
                      assign banner_enable    = block.settings[banner_enable_id]
                      assign banner_xl_id     = 'banner_xl_' | append: i
                      assign banner_xl        = block.settings[banner_xl_id]
                      assign class_bn_id      = 'class_bn' | append: i
                      assign class_bn         = block.settings[class_bn_id]
                      assign banner_link_id   = 'novmenu_banner_link' | append: i
                      assign banner_link      = block.settings[banner_link_id]
                      assign banner_img_id    = 'novmenu_banner' | append: i
                      assign banner_img       = block.settings[banner_img_id]
                      assign banner_text_id   = 'novmenu_banner_text' | append: i
                      assign banner_text      = block.settings[banner_text_id]
                      assign banner_color_id  = 'novmenu_banner_text_color' | append: i
                      assign banner_color     = block.settings[banner_color_id]
                    %}
                    
                    {% if banner_enable %}
                      <div class="{{ banner_xl }}{% if class_bn != blank %} {{ class_bn }}{% endif %}">
                        <div class="novMenuBanner position-relative {{ banner_text }}" style="--border-radius: {{ block.settings.banner_br | append: 'px' }};--padding: {{ block.settings.padding | append: 'px' }};">
                          {% if banner_link != blank %}<a href="{{ banner_link }}">{% endif %}
                            {% if banner_img != blank %}
                              {% render 'nov-imgset', image: banner_img %}
                            {% else %}
                              {% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture %}
                              {{ 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                            {% endif %}
                          {% if banner_link != blank %}</a>{% endif %}
                          {% if banner_text != blank %}
                            <div class="position-absolute top-center text-center color-title fs-20 font-700 color-{{ banner_color }} w-100 p-2">
                              {{ banner_text }}
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}

                  {% if block.settings.product_enable %}
                    <div class="{{ block.settings.product_xl }} nav--product mt-sm-30">
                      <div class="site-nav--title__product">
                        <span>{{ block.settings.title_product }}</span>
                      </div>
                      <div class="megamenu-product-slider grid--view-items row" data-autoplay="{{ block.settings.autoplay }}">
                        {% for product in block.settings.product_list %}
                          <div class="item col">
                            <div class="item-product mb-0{% if settings.show_border_product %} h_bd{% endif %}{% if settings.show_background_product %} bg{% endif %}">
                              <div class="thumbnail-container">
                                <a href="{{ product.url }}">
                                  <div class="card_media relative overflow-hidden" style="aspect-ratio: {{ settings.aspect_product_image }}">
                                    <img class="product__thumbnail lazyload"
                                      src="{{ product.featured_image | image_url: width: 180 }}"
                                      data-srcset="{{ product.featured_image | image_url: width: 380 }} 380w, {{ product.featured_image | image_url: width: 580 }} 580w, {{ product.featured_image | image_url: width: 768 }} 768w, {{ product.featured_image | image_url: width: 900 }} 900w"
                                      data-sizes="auto" alt="{{ product.featured_image.alt | default: product.title }}"
                                      width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" loading="lazy">
                                  </div>
                                </a>
                              </div>
                              <div class="product__info">
                                <div class="product__title {{ settings.title_product_line }}">
                                  <a href="{{ product.url }}">{{ product.title }}</a>
                                </div>
                                <div class="product__price price-st">
                                  {% render 'product-price', product: product %}
                                </div>
                              </div>
                            </div>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </li>
          {% break %}
        {% endif %}

        {% comment %}======================== ICONMENU =============================={% endcomment %}
        {% if block.type == 'icon_menu' and block_title == link.title %}
          {% assign is_icon = true %}
          <li class="nav--lv1{% if child_links != blank %} parent--lv1{% endif %} site-nav--Iconmenu{% if link.active %} site-nav--active{% endif %}" style="--td: {{ forloop.parentloop.index0 | times: 0.1 }}s;">
            <a href="{{ link.url }}" class="site-nav__link--main d-flex align-items-center" title="{{ link.title }}">
              {% if block.settings.show_icon and block.settings.icon_menu != blank %}
                <div class="site-nav--icon" style="--icon-width: {{ block.settings.icon_width | append: 'px' }};">
                  <img class="img-fluid" src="{{ block.settings.icon_menu | image_url: width: 50 }}" width="50" height="50" alt="{{ block.settings.icon_menu.alt | default: link.title }}" loading="lazy" />
                </div>
              {% endif %}
              <div class="site-nav--title">
                <span>{{ link.title }}</span>
              </div>
              {% if child_links != blank %}
              <div class="nav-direc">{% render 'icon-arrow-next' %}</div>
              {% endif %}
            </a>
            {% if child_links != blank %}
              <div class="nav-dropdown--lv1 MenuDefault" style="font-size: {{ block.settings.font_size | append: 'px' }};font-weight: {{ block.settings.font_weight }};text-transform: {{ block.settings.text_transform }};line-height: {% if block.settings.line_height == 1 %}1{% else %}{{ block.settings.line_height | append: 'px' }}{% endif %};--line-height-mb: 1.5;--padding: {{ block.settings.padding | append: 'px' }};">
                {% if three_level_nav %}
                  <ul class="site-nav--MenuLinks">
                    <li class="site-nav__link--title{% if block.settings.show_title == false %} hidden{% endif %}" style="font-size: {{ block.settings.font_size_title | append: 'px' }};font-weight: {{ block.settings.font_weight_title }};text-transform: {{ block.settings.text_transform_title }};line-height: {% if block.settings.line_height_title == 1 %}1{% else %}{{ block.settings.line_height_title | append: 'px' }}{% endif %};--line-height-mb: 1.5;">
                      <span>{{ link.title }}</span>
                    </li>
                    {% for childlink in child_links %}
                      {% liquid
                        assign grand_child_handle = childlink.title | handleize
                        assign grand_links = childlink.links
                        if grand_links == empty or grand_links == blank
                          assign grand_links = linklists[grand_child_handle].links
                        endif
                      %}
                      <li class="nav--lv2 parent--lv2">
                        <a href="{{ childlink.url }}" class="site-nav__link--second site-nav__link d-inline-flex relative w-100">
                          <span class="second_link">{{ childlink.title | escape }}</span>
                          {% if grand_links != blank %}
                            <span class="nav-direc">{% render 'icon-arrow-next' %}</span>
                          {% endif %}
                        </a>
                        {% if grand_links != blank %}
                          <div class="nav-dropdown--lv2">
                            <ul class="site-nav--MenuLinks">
                              {% for grandchildlink in grand_links %}
                                <li>
                                  <a href="{{ grandchildlink.url }}" class="site-nav__link d-inline-flex relative"><span>{{ grandchildlink.title | escape }}</span></a>
                                </li>
                              {% endfor %}
                            </ul>
                          </div>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                {% else %}
                  <ul class="site-nav--MenuLinks">
                    <li class="site-nav__link--title{% if block.settings.show_title == false %} hidden{% endif %}">
                      <span>{{ link.title }}</span>
                    </li>
                    {% for childlink in child_links %}
                      <li{% if childlink.active %} class="site-nav--active"{% endif %}>
                        <a href="{{ childlink.url }}" class="site-nav__link relative"><span>{{ childlink.title | escape }}</span></a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            {% endif %}
          </li>
          {% break %}
        {% endif %}
      {% endfor %}

      {% comment %}======================== DEFAULT MENU =============================={% endcomment %}
      {% if is_mega == false and is_icon == false %}
        <li class="nav--lv1{% if child_links != blank %} parent--lv1{% endif %} site-nav--Default{% if link.active %} site-nav--active{% endif %}" style="--td: {{ forloop.index | times: 0.2 }}s">
          <a href="{{ link.url }}" class="site-nav__link--main">
            <span class="site-nav--title">{{ link.title }}</span>
            {% if child_links != blank %}
            <div class="nav-direc">{% render 'icon-arrow-next' %}</div>
            {% endif %}
          </a>
          {% if child_links != blank %}
            <div class="nav-dropdown--lv1 MenuDefault">
              {% if three_level_nav %}
                <ul class="site-nav--MenuLinks">
                  <li class="site-nav__link--title">
                    <span>{{ link.title }}</span>
                  </li>
                  {% for childlink in child_links %}
                    {% liquid
                      assign grand_child_handle = childlink.title | handleize
                      assign grand_links = childlink.links
                      if grand_links == empty or grand_links == blank
                        assign grand_links = linklists[grand_child_handle].links
                      endif
                    %}
                    <li class="nav--lv2{% if grand_links != blank %} parent--lv2{% endif %}">
                      <a href="{{ childlink.url }}" class="site-nav__link--second site-nav__link">
                        <span class="second_link">{{ childlink.title }}</span>
                        {% if grand_links != blank %}
                          <span class="nav-direc">{% render 'icon-arrow-next' %}</span>
                        {% endif %}
                      </a>
                      {% if grand_links != blank %}
                        <div class="nav-dropdown--lv2">
                          <ul class="site-nav--MenuLinks">
                            <li class="site-nav__link--title">
                              <span>{{ childlink.title }}</span>
                            </li>
                            {% for grandchildlink in grand_links %}
                              <li>
                                <a href="{{ grandchildlink.url }}" class="site-nav__link relative"><span>{{ grandchildlink.title }}</span></a>
                              </li>
                            {% endfor %}
                          </ul>
                        </div>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                <ul>
                  <li class="site-nav__link--title">
                    <span>{{ link.title }}</span>
                  </li>
                  {% for childlink in child_links %}
                    <li{% if childlink.active %} class="site-nav--active"{% endif %}>
                      <a href="{{ childlink.url }}" class="site-nav__link{% if forloop.last %} site-nav__link--last{% endif %}">{{ childlink.title | escape }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endif %}
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>