<div id="desktopVerticalMenu">
  <ul class="site-nav-vertical list-unstyled" data-act_index="{{ act_index }}" data-limit="{{ limit }}" style="--icon-width: {{ icon_width }}px; --object: {{ icon_object }}">
    {% for link in linklists[vertical_menu].links %}
      {%- assign is_mega = false -%}
      {%- assign is_icon = false -%}
      {%- assign three_level_nav = false -%}
      {%- assign child_list_handle = link.title | handleize -%}

      {% for childlink in linklists[child_list_handle].links %}
        {% assign grand_child_list_handle = childlink.title | handleize %}
        {% if linklists[grand_child_list_handle].links != blank %}
          {%- assign three_level_nav = true -%}
        {% endif %}
      {% endfor %}

      {% comment %}======================== MEGAMENU =============================={% endcomment %}
        {% for block in section.blocks %}
          {% if block.type == 'megamenu' %}
            {% assign menu_item = link.title %}                                                 
            {% if block.settings.title == menu_item %}
              <li class="nav--lv1 parent--lv1 site-nav--Megamenu{% if link.active %} site-nav--active{% endif %}" style="--td:{{ forloop.index | times: '0.2' | append: 's' }}">
                <a class="site-nav__link--main" href="{{ link.url }}" title="{{ link.title }}">
                  {% if block.settings.icon_menu != blank %}
                    <div class="site-nav--icon">
                      <img class="img-fluid" src="{{ block.settings.icon_menu | image_url: width: 50 }}" width="50" height="50" alt="{{ block.settings.icon_menu.alt | default: 'icon_menu' }}" />
                    </div>
                  {% endif %}
                  <div class="site-nav--title">
                    {{ link.title }}
                  </div>
                  <div class="nav-direc">
                    {% render 'icon-arrow-next' %}
                  </div>
                </a>
                <div class="nav-dropdown--lv1 megaMenu{% if block.settings.type_width == 'full' %} site-nav--fw{% endif %}" style="{% if block.settings.img_bg != blank %}background-image: url({{ block.settings.img_bg | image_url: width: 1024 }});background-repeat: no-repeat;background-size: cover;{% endif %}--width: {{ block.settings.custom_width | default: 1170 }}px;">
                  <div class="site-nav__mega--content row">
                    {% if block.settings.collection_enable %}
                      <div class="{{ block.settings.collection_xl }} site--nav-collection mb-md-30">
                        {% for i in (1..5) %}
                          {%- assign name_collec_id = 'name_collec_' | append: i -%}
                          {%- assign link_id = 'link_' | append: i -%}
                          {% if block.settings[name_collec_id] != blank %}
                            <div class="nav--collec-item">
                              <a href="{{ block.settings[link_id] }}">
                                <span>{{ block.settings[name_collec_id] }}</span>
                                {% render 'icon-arrow-next' %}
                              </a>
                            </div>
                          {% endif %}
                        {% endfor %}
                      </div>
                    {% endif %}
                    <div class="{{ block.settings.novmenu_xl }}">
                      <div class="row">
                        {% for novLink1 in linklists[child_list_handle].links %}
                        {% assign link_handle = novLink1.title | handleize %}
                        <div class="{{ block.settings.submenu_xl }} mb-15">
                          <ul class="site-nav--MenuLinks p-0">
                            <li{% if three_level_nav %} class="site-nav__link--title{% if block.settings.show_title == false %} hidden{% endif %}"{% endif %}>
                              <a href="{{ novLink1.url }}">{{ novLink1.title }}</a>
                            </li>
                            {% for novLink2 in linklists[link_handle].links %}
                              <li>
                                <a href="{{ novLink2.url }}" class="site-nav__link">{{ novLink2.title }}</a>
                              </li>
                            {% endfor %}
                          </ul>
                        </div>
                        {% endfor %}
                      </div>
                    </div>

                    {% for i in (1..3) %}
                      {%- assign novmenu_banner_enable_id = 'novmenu_banner_enable' | append: i -%}
                      {%- assign banner_xl_id = 'banner_xl_' | append: i -%}
                      {%- assign class_bn_id = 'class_bn' | append: i -%}
                      {%- assign novmenu_banner_link_id = 'novmenu_banner_link' | append: i -%}
                      {%- assign novmenu_banner_id = 'novmenu_banner' | append: i -%}
                      {%- assign novmenu_banner_text_id = 'novmenu_banner_text' | append: i -%}
                      {%- assign novmenu_banner_text_color_id = 'novmenu_banner_text_color' | append: i -%}
                      
                      {% if block.settings[novmenu_banner_enable_id] %}
                        <div class="{{ block.settings[banner_xl_id] }}{% if block.settings[class_bn_id] != blank %} {{ block.settings[class_bn_id] }}{% endif %}">
                          <div class="novMenuBanner position-relative {{ novmenu_banner_text_id }}" style="border-radius: {{ block.settings.banner_br }}px; overflow: hidden;">
                            {% if block.settings[novmenu_banner_link_id] != blank %}<a href="{{ block.settings[novmenu_banner_link_id] }}">{% endif %}
                              {% if block.settings[novmenu_banner_id] != blank %}
                                {% render 'nov-aspect-image', image: block.settings[novmenu_banner_id] %}
                              {% else %}
                                {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                                {{ 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                              {% endif %}
                            {% if block.settings[novmenu_banner_link_id] != blank %}</a>{% endif %}
                            {% if block.settings[novmenu_banner_text_id] != blank %}
                              <div class="position-absolute top-center text-center color-title fs-20 font-700 color-{{ block.settings[novmenu_banner_text_color_id] }} w-100 p-2">
                                {{ block.settings[novmenu_banner_text_id] }}
                              </div>
                            {% endif %}
                          </div>
                        </div>
                      {% endif %}
                    {% endfor %}

                    {% if block.settings.product_enable %}
                      <div class="{{ block.settings.product_xl }} nav--product mt-sm-30">
                        <div class="site-nav--title__product">
                          <span>{{ block.settings.title_product }}</span>
                        </div>
                        <div class="megamenu-product-slider grid--view-items row" data-autoplay= "{{ block.settings.autoplay }}">
                          {% for product in block.settings.product_list %}
                            <div class="item col">
                              <div class="item-product mb-0{% if settings.show_border_product %} h_bd{% endif %}{% if settings.show_background_product %} bg{% endif %}">
                                <div class="thumbnail-container">
                                  <a href="{{ product.url }}">
                                    {% assign img_url = product.featured_image %}
                                    <div class="card_media relative overflow-hidden" style="aspect-ratio: {{ settings.aspect_product_image }}">
                                      <img class="product__thumbnail lazyload"
                                        src="{{ img_url | image_url: width: 180 }}"
                                        data-srcset="{{ img_url | image_url: width: 380 }} 380w,{{ img_url | image_url: width: 580 }} 580w,{{ img_url |image_url: width: 768 }} 768w,{{ img_url | image_url: width: 900 }} 900w" data-sizes="auto" alt="{{ img_url.alt }}"  width="{{ img_url.width }}" height="{{ img_url.height }}" loading="lazy">
                                    </div>
                                  </a>
                                </div>
                                <div class="product__info">
                                  <div class="product__title {{ settings.title_product_line }}">
                                    <a href="{{ product.url }}">{{ product.title }}</a>
                                  </div>
                                  <div class="product__price price-st">
                                    {% render 'product-price', product: product %}
                                  </div>
                                </div>
                              </div>
                            </div>
                          {% endfor %}
                        </div>
                      </div>
                    {% endif %}
                    
                  </div>
                </div>
              </li>
              {% assign is_mega = true %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% comment %}======================== ENDMEGAMENU =============================={% endcomment %}

      {% comment %}======================== ICONMENU =============================={% endcomment %}
        {% for block in section.blocks %}
          {% if block.type == 'icon_menu' %}
            {% assign menu_item = link.title %}
            {% if block.settings.name_item == menu_item and block.type == 'icon_menu' %}
              {% if linklists[child_list_handle].links != blank %}
                <li class="nav--lv1 parent--lv1 site-nav--Default{% if active %} site-nav--active{% endif %}" style="--td:{{ forloop.index0 | times: '0.1' | append: 's' }}">
                  <a href="{{ link.url }}" class="site-nav__link--main d-flex align-items-center" title="{{ link.title }}">
                    {% if block.settings.icon_menu != blank %}
                      <div class="site-nav--icon">
                        <img class="img-fluid" src="{{ block.settings.icon_menu | image_url: width: 50 }}" width="50" height="50" alt="{{ block.settings.icon_menu.alt | default: 'icon_menu' }}" />
                      </div>
                    {% endif %}
                    <div class="site-nav--title">
                      {{ link.title }}
                    </div>
                    <div class="nav-direc">{% render 'icon-arrow-next' %}</div>
                  </a>
                  <div class="nav-dropdown--lv1 MenuDefault">
                    {% if three_level_nav %}
                      {% if linklists[child_list_handle].links != blank %}
                        <ul>
                          <li class="site-nav__link--title{% if block.settings.show_title == false %} hidden{% endif %}">
                            <span>{{ link.title }}</span>
                          </li>
                          {% for childlink in linklists[child_list_handle].links %}
                            {% assign grand_child_list_handle = childlink.title | handle %}
                            <li class="nav--lv2 parent--lv2">
                              <a href="{{ childlink.url }}" class="site-nav__link--second site-nav__link">
                                <span class="second_link">{{ childlink.title | escape }}</span>
                                {% if linklists[grand_child_list_handle].links != blank %}
                                <span class="site-nav--direc d-none">{% render 'icon-arrow-next' %}</span>
                                {% endif %}
                              </a>
                              {% if linklists[grand_child_list_handle].links != blank %}
                              <div class="nav-dropdown--lv2">
                                <ul>
                                  {% for grandchildlink in linklists[grand_child_list_handle].links %}
                                    <li>
                                      <a href="{{ grandchildlink.url }}" class="site-nav__link">{{ grandchildlink.title | escape }}</a>
                                    </li>
                                  {% endfor %}
                                </ul>
                              </div>
                              {% endif %}
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    {% else %}
                      <ul>
                        <li class="site-nav__link--title{% if block.settings.show_title == false %} hidden{% endif %}">
                          <span>{{ link.title }}</span>
                        </li>
                        {% for childlink in linklists[child_list_handle].links %}
                          <li {% if childlink.active %}class="site-nav--active"{% endif %}>
                            <a href="{{ childlink.url }}" class="site-nav__link">{{ childlink.title | escape }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                </li>
              {% else %}
                <li class="nav--lv1{% if active %} site-nav--active{% endif %}">
                  <a href="{{ link.url }}" class="site-nav__link--main d-flex align-items-center" title="{{ link.title }}">
                    {% if block.settings.icon_menu != blank %}
                      <div class="site-nav--icon">
                        <img class="img-fluid" src="{{ block.settings.icon_menu | image_url: width: 50 }}" width="50" height="50" alt="{{ block.settings.icon_menu.alt | default: 'icon_menu' }}" />
                      </div>
                    {% endif %}
                    <div class="site-nav--title">
                      {{ link.title }}
                    </div>
                  </a>
                </li>
              {% endif %}
              {% assign is_icon = true %}
              {% break %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% comment %}======================== ENDICONMENU =============================={% endcomment %}

      {% if is_mega == false and is_icon == false %}
        {% if linklists[child_list_handle].links != blank %}
          <li class="nav--lv1 parent--lv1 site-nav--Default{% if link.active %} site-nav--active{% endif %}" style="--td:{{ forloop.index | times: '0.2' | append: 's' }}">
            <a href="{{ link.url }}" class="site-nav__link--main">
              {% for block in section.blocks %}
                {% if block.settings.title == link.title and block.settings.icon_menu != blank %}
                  <span class="site-nav--icon">
                    <img class="img-fluid" src="{{ block.settings.icon_menu | image_url: width: 50 }}"
                    width="50"
                    height="50"
                    alt="{{ block.settings.icon_menu.alt | default: 'icon' }}"
                    />
                  </span>
                  {% break %}
                {% endif %}
              {% endfor %}
              <span class="site-nav--title">{{ link.title }}</span>
              <div class="nav-direc">{% render 'icon-arrow-next' %}</div>
            </a>
            <div class="nav-dropdown--lv1 MenuDefault">
              {% if three_level_nav %}
                {% if linklists[child_list_handle].links != blank %}
                  <ul>
                    <li class="site-nav__link--title{% if block.settings.show_title == false %} hidden{% endif %}">
                      <span>{{ link.title }}</span>
                    </li>
                    {% for childlink in linklists[child_list_handle].links %}
                      {% assign grand_child_list_handle = childlink.title | handle %}
                      <li class="nav--lv2{% if linklists[grand_child_list_handle].links != blank %} parent--lv2{% endif %}">
                        <a href="{{ childlink.url }}" class="site-nav__link--second site-nav__link">
                          <span class="second_link">{{ childlink.title }}</span>
                          {% if linklists[grand_child_list_handle].links != blank %}
                          <span class="nav-direc">{% render 'icon-arrow-next' %}</span>
                          {% endif %}
                        </a>
                        {% if linklists[grand_child_list_handle].links != blank %}
                          <div class="nav-dropdown--lv2">
                            <ul>
                              <li class="site-nav__link--title{% if block.settings.show_title == false %} hidden{% endif %}">
                                <span>{{ childlink.title }}</span>
                              </li>
                              {% for grandchildlink in linklists[grand_child_list_handle].links %}
                                <li>
                                  <a href="{{ grandchildlink.url }}" class="site-nav__link">{{ grandchildlink.title }}</a>
                                </li>
                              {% endfor %}
                            </ul>
                          </div>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              {% else %}
                <ul>
                  <li class="site-nav__link--title{% if block.settings.show_title == false %} hidden{% endif %}">
                    <span>{{ link.title }}</span>
                  </li>
                  {% for childlink in linklists[child_list_handle].links %}
                    <li {% if childlink.active %}class="site-nav--active"{% endif %}>
                      <a href="{{ childlink.url }}" class="site-nav__link{% if forloop.last %} site-nav__link--last{% endif %}">{{ childlink.title | escape }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </li>
        {% else %}
          <li class="nav--lv1{% if link.active %} site-nav--active{% endif %}" style="--td:{{ forloop.index | times: '0.2' | append: 's' }}">
            <a href="{{ link.url }}" class="site-nav__link--main" title="{{ link.title }}">
            {% for block in section.blocks %}
              {% if block.settings.title == link.title and block.settings.icon_menu != blank %}
                <span class="site-nav--icon">
                  <img class="img-fluid" src="{{ block.settings.icon_menu | image_url: width: 50 }}"
                  width="50"
                  height="50"
                  alt="{{ block.settings.icon_menu.alt | default: 'icon' }}"
                  style="height: auto" 
                  />
                </span>
                {% break %}
              {% endif %}
            {% endfor %}
            <div class="site-nav--title">
            {{ link.title }}
            </div>
            </a>
          </li>
        {% endif %}
      {% endif %}
    {% endfor %}
    {% if limit < linklists[vertical_menu].links.size %}
      <li class="btn-more nov_btn_act pointer d-flex align-items-center">
        <span class="see-more">{{ 'layout.vertical_menu.see_more' | t }}</span>
        <span class="see-less">{{ 'layout.vertical_menu.see_less' | t }}</span>
      </li>
    {% endif %}
  </ul>
</div>