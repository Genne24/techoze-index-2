{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}

{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .title-policy {
    letter-spacing: {{ sst.t_letter_spacing }}px;
  }
  #shopify-section-{{ section.id }} .policy-icon {
    min-width: {{ sst.width_icon }}px;
    max-width: {{ sst.width_icon }}px;
    min-height: {{ sst.height_icon }}px;
    max-height: {{ sst.height_icon }}px;
  }
  #shopify-section-{{ section.id }} .bg-icon .policy-icon {
    width: {{ sst.bg_icon_w }}px;
    min-width: {{ sst.bg_icon_w }}px;
    height: {{ sst.bg_icon_w }}px;
    border-radius: {{ sst.bd_radius_icon }}px;
  }
  #shopify-section-{{ section.id }} .policy__item--content {
    border-radius: {{ sst.bd_radius }}px;
    {% if sst.show_bgitem %}
      padding-inline: clamp(10px, 9.5%, 40px);
    {% endif %}
    {% if sst.box_shadow %}
      box-shadow: 0px 4px 12px rgba(0,0,0,0.1);
    {% endif %}
    {%- if sst.pt > 40 -%}
      padding-top: {{ sst.pt | times: 0.5 | round: 0 }}px;
    {% else %}
      padding-top: {{ sst.pt | times: 0.8 | round: 0 }}px;
    {%- endif %}
    {%- if sst.pb > 40 -%}
      padding-bottom: {{ sst.pb | times: 0.5 | round: 0 }}px;
    {% else %}
      padding-bottom: {{ sst.pb | times: 0.8 | round: 0 }}px;
    {%- endif %}
    {%- if sst.ph > 40 -%}
      padding-inline: {{ sst.ph | times: 0.5 | round: 0 }}px;
    {% else %}
      padding-inline: {{ sst.ph | times: 0.8 | round: 0 }}px;
    {%- endif %}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .policy__item--content {
      {%- if sst.pt > 40 -%}
        padding-top: {{ sst.pt | times: 0.7 | round: 0 }}px;
      {%- endif %}
      {%- if sst.pb > 40 -%}
        padding-bottom: {{ sst.pb | times: 0.7 | round: 0 }}px;
      {%- endif %}
      {%- if sst.ph > 40 -%}
        padding-inline: {{ sst.ph | times: 0.7 | round: 0 }}px;
      {%- endif %}  
    }
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .policy__item--content {
      padding-top: {{ sst.pt }}px;
      padding-bottom: {{ sst.pb }}px;
      padding-inline: {{ sst.ph }}px;
    }
  }
  @media(max-width: 1199px) {
    {% if sst.bg_icon_w  > 100 %}
      #shopify-section-{{ section.id }} .bg-icon .policy-icon {
        width: {{ sst.bg_icon_w | times: 0.7 | round: 0 }}px;
        min-width: {{ sst.bg_icon_w | times: 0.7 | round: 0 }}px;
        height: {{ sst.bg_icon_w | times: 0.7 | round: 0 }}px;
      }
    {% endif %}
    {% if sst.width_icon >= 60 or sst.height_icon >= 60 %}
      #shopify-section-{{ section.id }} .policy-icon {
        min-width: {{ sst.width_icon | times: 0.8 | round: 0 }}px;
        min-height: {{ sst.height_icon | times: 0.8 | round: 0 }}px;
        max-width: {{ sst.width_icon | times: 0.8 | round: 0 }}px;
        max-height: {{ sst.height_icon | times: 0.8 | round: 0 }}px;
      }
    {% endif %}
  }
  {% if sst.show_border_right_item %}
    #shopify-section-{{ section.id }} .item-bd-right {
      --color-border-right: {{ sst.c_border_item }};
    }
  {% endif %}
  {% if sst.show_border_item %}
    #shopify-section-{{ section.id }} .show-border .policy__item--content {
      border-color: {{ sst.c_border_item }};
    }
  {% endif %}
  {% for block in section.blocks %}
    #shopify-section-{{ section.id }} .block-{{ forloop.index }} .desc-policy {
      max-width: {{ block.settings.mw }}px;
    }
    {% if sst.show_bg_icon or sst.show_border_icon %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} .policy-icon {
        {% if sst.show_bg_icon %}
          background-color: {{ block.settings.bg_icon }};
          {% if sst.bg_icon_img != blank %}
            background-image: url("{{ sst.bg_icon_img | image_url: width: 500 }}");
            background-size: contain;
            background-repeat: no-repeat;
          {% endif %}
        {% endif %}
        {% if sst.show_border_icon %}
          border: 1px solid {{ block.settings.border_icon }};
        {% endif %}
      }
    {% endif %}
    {% if sst.show_border_right_icon %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} .bd-l {
        border-color: {{ block.settings.border_icon }};
        padding-inline-start: 3rem;
      }
    {% endif %}
    {% if sst.show_bgitem %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} {
        background-color: {{ block.settings.bg_item }}; 
      }
    {% endif %}
  {% endfor %}
  {% if sst.bg_icon_shadow %}
    #shopify-section-{{ section.id }} .policy-icon {
      box-shadow: 0 0 36px rgba({{ sst.shadow_color | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, {{ sst.shadow_opacity }}%);
    }
  {% endif %}
{% endstyle %}
<div class="color-{{ sst.color_section }}{{ bg_class_full }} {{ sst.dots_color }} position-relative">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}">
      {% render 'heading-section', sub_position: sst.subheading_position %}
      <div class="row spacing-{{ sst.spacing }} spacing-lg-15">
        {% for block in section.blocks %}
          {% assign bst = block.settings %}
          <div class="nov-policy-item sp-item {% render 'number-to-col', xxl: sst.xxl, xl: sst.xl, lg: sst.lg, md: sst.md, sm: sst.sm, xs: sst.xs  %}
            {%- if sst.show_bg_icon -%} bg-icon{%- endif -%}
            {% if sst.show_border_item %} show-border{%- endif -%}
            {% if bst.class != blank %} {{ bst.class }}{%- endif -%}
            {% if sst.bg_icon_shadow %} show-icon-shadow{%- endif -%}
            {% if sst.show_border_right_item %} item-bd-right{%- endif -%}
            {% if sst.icon_animate %} icon_animate{%- endif -%}
            {% if settings.animate %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animate %} data-cascade style="--animation-order: {{ forloop.index0 }};"{% endif %}
           >
            {% if sst.style == 'style1' or sst.style == 'style3' %}
              <div class="policy__item--content position-relative h-100 style1 block-{{ forloop.index }} d-flex align-items-start d-sm-block text-left{% if sst.style == 'style1' %} text-sm-center{% endif %}">
                {% if bst.policy_icon != blank %}
                  <div class="policy-icon d-inline-flex align-items-center justify-content-center mb-20 position-relative">
                    {% render 'nov-imgset', image: bst.policy_icon, class: 'w-100 no-ef' %}
                  </div>
                {% endif %}
                <div class="heading--policy position-relative">
                  {% if bst.title_policy != blank %}
                    <div class="title-policy color-title fs-{{ sst.text_fz }} fs-lg-{{ sst.text_fz_lg }} fs-sm-{{ sst.text_fz_sm }} {{ sst.text_ff }} {{ sst.t_fw }}">{{ bst.title_policy }}</div>
                  {% endif %}
                  {% if bst.stitle_policy != blank %}
                    <div class="stitle-policy color-subtitle fs-{{ sst.stext_fz }} {{ sst.stext_ff }} {{ sst.st_fw }} mt-20">{{ bst.stitle_policy }}</div>
                  {% endif %}
                  {% if bst.desc_policy != blank %}
                    <div class="desc-policy color-text d-inline-flex fs-{{ sst.desc_fz }} {{ sst.desc_ff }} {{ sst.desc_fw }}{% if bst.title_policy != blank %} mt-10{% endif %}">{{ bst.desc_policy }}</div>
                  {% endif %}
                  {% if bst.link_label != blank %}
                    <div class="link-policy mt-20">
                      <a href="{{ bst.link }}" class="link fs-14 fs-sm-12 font-700 d-inline-flex align-items-center">
                        {{ bst.link_label }}
                        <i class="zmdi zmdi-chevron-right"></i>
                      </a>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
            {% if sst.style == 'style2' %}
              <div class="policy__item--content position-relative h-100 style2 block-{{ forloop.index }} d-flex{% if sst.show_border_right_icon == false %} d-lg-block d-xl-flex{% endif %} align-items-center">
                {% if bst.policy_icon != blank %}
                  <div class="policy-icon d-inline-flex align-items-center justify-content-center position-relative{% if sst.show_border_right_icon == false %} mb-lg-15 mb-md-0{% endif %}">
                    {% render 'nov-imgset', image: bst.policy_icon, class: 'w-100 no-ef' %}
                  </div>
                {% endif %}
                <div class="heading--policy position-relative{% if sst.show_border_right_icon %} bd-l{% endif %}">
                  {% if bst.title_policy != blank %}
                    <div class="title-policy color-title fs-{{ sst.text_fz }} fs-lg-{{ sst.text_fz_lg }} fs-sm-{{ sst.text_fz_sm }} {{ sst.text_ff }} {{ sst.t_fw }}">{{ bst.title_policy }}</div>
                  {% endif %}
                  {% if bst.stitle_policy != blank %}
                    <div class="stitle-policy color-subtitle fs-{{ sst.stext_fz }} {{ sst.stext_ff }} {{ sst.st_fw }} mt-5">{{ bst.stitle_policy }}</div>
                  {% endif %}
                  {% if bst.desc_policy != blank %}
                    <div class="desc-policy color-text fs-{{ sst.desc_fz }} {{ sst.desc_ff }} {{ sst.desc_fw }}{% if bst.title_policy != blank %} mt-10{% endif %}">{{ bst.desc_policy }}</div>
                  {% endif %}
                  {% if bst.link_label != blank %}
                    <div class="link-policy mt-20 mt-sm-10">
                      <a href="{{ bst.link }}" class="link fs-14 fs-sm-12 font-700 d-inline-flex align-items-center">
                        {{ bst.link_label }}
                        <i class="zmdi zmdi-chevron-right"></i>
                      </a>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>  
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% schema %}
  {
    "name": "Vinova Policy",
    "class": "section-policy",
    "disabled_on": {
      "groups": ["header", "footer", "custom.system"]
    },
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Vinova Policy</p>"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#222222",
        "visible_if": "{{ section.settings.heading != blank }}"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Sub heading",
        "default": "<p>Subtitle from happy customers</p>"
      },
      {
        "type": "color",
        "id": "subheading_color",
        "label": "Sub heading color",
        "default": "#666666",
        "visible_if": "{{ section.settings.subheading != blank }}"
      },
      {
        "type": "select",
        "id": "subheading_position",
        "label": "Sub heading position",
        "default": "bottom",
        "options": [
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "bottom",
            "label": "Bottom"
          }
        ],
        "visible_if": "{{ section.settings.subheading != blank }}"
      },
      {
        "type": "richtext",
        "id": "descheading",
        "label": "Description",
        "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
      },
      {
        "type": "color",
        "id": "descheading_color",
        "label": "Description color",
        "default": "#666666",
        "visible_if": "{{ section.settings.descheading != blank }}"
      },
      {
        "type": "text_alignment",
        "id": "alignment",
        "label": "Alignment",
        "default": "left"
      },
      {
        "type":  "header",
        "content": "Style Item Policy"
      },
      {
        "type": "select",
        "id": "style",
        "label": "Style",
        "default": "style1",
        "options": [
          {"value": "style1", "label": "Style 1"},
          {"value": "style2", "label": "Style 2"},
          {"value": "style3", "label": "Style 3"}
        ]
      },
      {
        "type": "checkbox",
        "id": "show_bgitem",
        "label": "Show background item"
      },
      {
        "type": "range",
        "id": "bd_radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Border radius item",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "box_shadow",
        "label": "Show item shadow"
      },
      {
        "type": "checkbox",
        "id": "show_border_item",
        "label": "Show border item"
      },
      {
        "type": "checkbox",
        "id": "show_border_right_item",
        "label": "Show border right item",
        "info": "Breakpoint 1200px ↑"
      },
      {
        "type": "color",
        "id": "c_border_item",
        "alpha": true,
        "label": "Border color",
        "visible_if": "{{ section.settings.show_border_item or section.settings.show_border_right_item }}"
      },
      {
        "type": "range",
        "id": "pt",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "px",
        "label": "Padding top",
        "default": 0
      },
      {
        "type": "range",
        "id": "pb",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "px",
        "label": "Padding bottom",
        "default": 0
      },
      {
        "type": "range",
        "id": "ph",
        "min": 0,
        "max": 70,
        "step": 1,
        "unit": "px",
        "label": "Padding horizontal",
        "default": 0
      },
      {
        "type": "header",
        "content": "Icon Policy"
      },
      {
        "type": "number",
        "id": "width_icon",
        "label": "Max width icon policy (px)",
        "default": 90
      },
      {
        "type": "number",
        "id": "height_icon",
        "label": "Max height icon policy (px)",
        "default": 30
      },
      {
        "type": "checkbox",
        "id": "show_bg_icon",
        "label": "Show background icon"
      },
      {
        "type": "number",
        "id": "bg_icon_w",
        "label": "Width background icon policy (px)",
        "default": 85,
        "visible_if": "{{ section.settings.show_bg_icon }}"
      },
      {
        "type": "number",
        "id": "bd_radius_icon",
        "label": "Border radius background icon (px)",
        "default": 100,
        "visible_if": "{{ section.settings.show_bg_icon }}"
      },
      {
        "type": "image_picker",
        "id": "bg_icon_img",
        "label": "Background image icon",
        "visible_if": "{{ section.settings.show_bg_icon }}"
      },
      {
        "type": "checkbox",
        "id": "show_border_icon",
        "label": "Show border icon"
      },
      {
        "type": "checkbox",
        "id": "show_border_right_icon",
        "label": "Show border right",
        "visible_if": "{{ section.settings.style == 'style2' }}"
      },
      {
        "type": "checkbox",
        "id": "bg_icon_shadow",
        "label": "Show icon shadow"
      },
      {
        "type": "color",
        "id": "shadow_color",
        "label": "Icon shadow color",
        "visible_if": "{{ section.settings.bg_icon_shadow }}"
      },
      {
        "type": "range",
        "id": "shadow_opacity",
        "min": 10,
        "max": 100,
        "step": 1,
        "label": "Shadow opacity",
        "unit": "%",
        "default": 40,
        "visible_if": "{{ section.settings.bg_icon_shadow }}"
      },
      {
        "type": "checkbox",
        "id": "icon_animate",
        "label": "Icon animate",
        "default": false
      },
      {
        "type": "header",
        "content": "Title Policy"
      },
      {
        "type": "number",
        "id": "text_fz",
        "label": "Font size Large laptop (px)",
        "default": 16,
        "info": "Breakpoint 1200px ↑"
      },
      {
        "type": "number",
        "id": "text_fz_lg",
        "label": "Font size tablet (px)",
        "default": 16,
        "info": "Breakpoint 1199px ↓"
      },
      {
        "type": "number",
        "id": "text_fz_sm",
        "label": "Font size mobile (px)",
        "default": 16,
        "info": "Breakpoint 767px ↓"
      },
      {
        "type": "select",
        "id": "text_ff",
        "label": "Font family",
        "default": "f_pr",
        "options": [
          {"value": "f_df","label": "Body font"},
          {"value": "f_pr","label": "Heading font"}
        ]
      },
      {
        "type": "select",
        "id": "t_fw",
        "label": "Font weight",
        "default": "font-700",
        "options": [
          {"value": "font-300","label": "300 - Light"},
          {"value": "font-400","label": "400 - Regular"},
          {"value": "font-500","label": "500 - Medium"},
          {"value": "font-600","label": "600 - SemiBold"},
          {"value": "font-700","label": "700 - Bold"},
          {"value": "font-800","label": "800 - ExtraBold"},
          {"value": "font-900","label": "900 - Black"}
        ]
      },
      {
        "type": "text",
        "id": "t_letter_spacing",
        "label": "Letter spacing",
        "default": "0",
        "info": "Unit: px"
      },
      {
        "type": "header",
        "content": "Sub Title Policy"
      },
      {
        "type": "number",
        "id": "stext_fz",
        "label": "Font size (px)",
        "default": 16
      },
      {
        "type": "select",
        "id": "stext_ff",
        "label": "Font family",
        "default": "f_pr",
        "options": [
          {"value": "f_df","label": "Body font"},
          {"value": "f_pr","label": "Heading font"}
        ]
      },
      {
        "type": "select",
        "id": "st_fw",
        "label": "Font weight",
        "default": "font-700",
        "options": [
          {"value": "font-300","label": "300 - Light"},
          {"value": "font-400","label": "400 - Regular"},
          {"value": "font-500","label": "500 - Medium"},
          {"value": "font-600","label": "600 - SemiBold"},
          {"value": "font-700","label": "700 - Bold"},
          {"value": "font-800","label": "800 - ExtraBold"},
          {"value": "font-900","label": "900 - Black"}
        ]
      },
      {
        "type": "header",
        "content": "Description Policy"
      },
      {
        "type": "number",
        "id": "desc_fz",
        "label": "Font size (px)",
        "default": 13
      },
      {
        "type": "select",
        "id": "desc_ff",
        "label": "Font family",
        "default": "f_df",
        "options": [
          {"value": "f_df","label": "Body font"},
          {"value": "f_pr","label": "Heading font"}
        ]
      },
      {
        "type": "select",
        "id": "desc_fw",
        "label": "Font weight",
        "default": "font-400",
        "options": [
          {"value": "font-300","label": "300 - Light"},
          {"value": "font-400","label": "400 - Regular"},
          {"value": "font-500","label": "500 - Medium"},
          {"value": "font-600","label": "600 - SemiBold"},
          {"value": "font-700","label": "700 - Bold"},
          {"value": "font-800","label": "800 - ExtraBold"},
          {"value": "font-900","label": "900 - Black"}
        ]
      },
      {
        "type":  "header",
        "content": "Policy Item Per Row"
      },
      {
        "type": "range",
        "id": "xxl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Desktop",
        "default": 3,
        "info": "Breakpoint 1441px"
      },
      {
        "type": "range",
        "id": "xl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large laptop",
        "default": 3,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "range",
        "id": "lg",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Laptop",
        "default": 3,
        "info": "Breakpoint 992px"
      },
      {
        "type": "range",
        "id": "md",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Tablet",
        "default": 3,
        "info": "Breakpoint 768px"
      },
      {
        "type": "range",
        "id": "sm",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large mobile",
        "default": 2,
        "info": "Breakpoint 576px"
      },
      {
        "type": "range",
        "id": "xs",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Mobile",
        "default": 2,
        "info": "Breakpoint"
      },
      {
        "type": "range",
        "id": "spacing",
        "min": 0,
        "max": 60,
        "step": 5,
        "unit": "px",
        "label": "Spacing item",
        "default": 30
      },
      {
        "type":  "header",
        "content": "Section Style"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Show animated",
        "default":   true
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          {"value": "container", "label": "Container"},
          {"value": "container-fluid", "label": "Container fluid"},
          {"value": "container-full", "label": "Container full width"}
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_section",
        "label": "Color section",
        "default": "background-1"
      },
      {
        "type": "text",
        "id": "class_section",
        "label": "Class"
      },
      {
        "type":  "header",
        "content": "Section Background"
      },
      {
        "type": "checkbox",
        "id": "ss_bg_enable",
        "label": "Enable"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colors",
        "default": "#ffffff",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "select",
        "id": "background_img_size",
        "label": "Background image size",
