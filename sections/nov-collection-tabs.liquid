{%- liquid 
	assign sst = section.settings

	if sst.ss_bg_enable
	  assign bg = " bg"
	endif
	if sst.class_section != blank
	  assign class_section = sst.class_section | prepend: ' '
	endif
	assign class = 'distance' | append: bg | append: ' ' | append: sst.background_position | append: class_section
	if sst.background_size == 'full'
	  assign bg_class_full = class | prepend: ' '
	else
	  assign bg_class_contain = class | prepend: ' '
	endif
	
	assign xxl = sst.xxl
	assign xl = sst.xl
	assign lg = sst.lg
	assign md = sst.md
	assign sm = sst.sm
	assign xs = sst.xs
	assign row_number = sst.row_number
	assign row_mobile = sst.row_mobile
	assign limit = sst.limit

-%}
{% style %}
	{% render 'nov-section-style' %}
	#shopify-section-{{ section.id }} .collection-carousel:not([data-row="1"]) .slick-slide > div:not(:last-child) {
			margin-bottom: {{ sst.spacing | plus: 10 }}px;
		}
	@media(max-width: 575px) {
		.collection-carousel:not(.slick-initialized) .col:nth-child(3), .collection-carousel:not(.slick-initialized) .col:nth-child(4) {
			display: none;
		}
	}
	@media(min-width: 1441px) {
		.d-xxl-none { display: none !important; }
	}
	{% if sst.enable_custom_style %}
	  #shopify-section-{{ section.id }} {
	    {% if sst.enable_custom_style %}
      --product-color-border: {{ sst.product_border_color }};
      {% endif %}
			{% if sst.product_bg_enable %}
				--product-color-background: {{ sst.product_background_color }};
			{% endif %}
	  }
	{% endif %}
	#shopify-section-{{ section.id }} .nav-tabs {
		--color-nav-title: {{ sst.nav_color }};
		--color-nav-hover: {{ sst.nav_color_act }};
		--color-border-act: {{ sst.nav_color_border_act }};
		--color-nav-bg: {{ sst.nav_color_bg }};
		--color-nav-bg-act: {{ sst.nav_color_bg_act }};
	}
	#shopify-section-{{ section.id }} .view_all {
		--color-viewall: {{ sst.viewall_color }};
		--color-viewall-hover: {{ sst.viewall_color_hv }};
		--color-viewall-line: {{ sst.viewall_color_line }}
	}
{% endstyle %}
<div class="{{ bg_class_full }}" data-product-tabs style="--bg-w: {{ sst.background_width | append: 'px' }}">
	<div class="{{ sst.container }}">
		<div class="container-inner{{ bg_class_contain }}{% if sst.background_size == 'custom' %} bg-custom overflow-initial{% endif %}{% if sst.enable_custom_style %}{% if sst.product_border_enable %} item-product-show-bd{% endif %}{% if sst.product_bg_enable %} item-product-show-bg{% endif %}{% endif %}">
			<div class="{% if sst.nav_style == 'nav_1' %}d-flex flex-lg-row flex-md-column align-items-lg-center align-items-start justify-content-between w-100 {% elsif sst.nav_style == 'nav_3' %}d-flex flex-column align-items-center justify-content-center w-100 text-center {% endif %}mb-30 mb-sm-20 {{ sst.nav_style | prepend: 'gr_' }}">
				{% if sst.nav_style == 'nav_2' %}
					{% assign class = 'mb-30' %}
				{% elsif sst.nav_style == 'nav_1' %}
					{% assign class = 'mb-lg-10 mb-0' %}
				{% elsif sst.nav_style == 'nav_3' %}
					{% assign class = 'mb-25 text-center' %}
				{% endif %}
				{% render 'heading-section', sub_position: sst.subheading_position, class: class %}

				<div class="d-flex align-items-center{% if sst.nav_style == 'nav_2' %} justify-content-between w-100{% elsif sst.nav_style == 'nav_3' %} justify-content-center w-100{% endif %}">
					<ul class="nav nav-tabs list-product-tabs text-center d-none d-md-inline-flex flex-wrap justify-content-lg-center list-unstyled {{ sst.nav_style }}">
						<span class="nav-tabs-indicator"></span>
						{% for block in section.blocks %}
							{%- assign bst = block.settings -%}
							{% if block.type == 'tabitem' %}
								<li class="nav-item position-relative">
									<a class="nav-link tab-links{% if forloop.first %} active{% endif %} d-flex align-items-center {% if sst.nav_style == 'nav_1' %}fs-18 font-700{% elsif sst.nav_style == 'nav_2' %}fs-30 font-700{% endif %} color-{{ sst.btn_color_nav }} {{ sst.btn_type_nav_color }} position-relative duration-300"
									data-product-tabTop
									href					="{{ forloop.index | prepend: '#producttab-' | append: block.id }}"
									data-target		="{{ forloop.index | prepend: '#producttab-' | append: block.id }}"
									data-href			="{{ bst.collection_handle | prepend: '/collections/' }}"
									id						="{{ forloop.index | prepend: 'tab-' | append: block.id }}"
									data-id  			="{{ forloop.index | append: block.id }}"
									data-toggle		="tab"
									data-limit		="{{ limit }}"
									title					="{{ bst.tab_title }}">
										<span>{{ bst.tab_title }}</span>
									</a>
								</li>
							{% endif %}
						{% endfor %}
					</ul>
					{% if sst.view_all_label != blank %}
						<div class="view_all relative duration-300 d-none d-md-block">
							<a href="{{ sst.view_all_link }}" class="fs-16 font-700 lh-22">
								<span>{{ sst.view_all_label }}</span>
							</a>
						</div>
					{% endif %}
				</div>
			</div>
			{% comment %} Nav mobile{% endcomment %}
			<div class="nav-mobile nov_ud_toggle d-md-none mb-30">
				<div class="nov_ud_group position-relative">
				  <div class="nov_ud_btn nav-mobile__title d-flex align-items-center justify-content-between w-100 color-{{ sst.color_tab_mobile }} {{ sst.color_tab_mobile_type }}">
				  </div>
				  <div class="nov_ud_dropdown list-product-tabs w-100 p-0 color-background-1">
				    {% for block in section.blocks %}
							{%- assign bst = block.settings -%}
							{% if block.type == 'tabitem' %}
								<a class="nav-link tab-links{% if forloop.first %} active{% endif %}"
									data-product-tabTop
									href					="{{ forloop.index | prepend: '#producttab-' | append: block.id }}"
									data-target		="{{ forloop.index | prepend: '#producttab-' | append: block.id }}"
									data-href			="{{ bst.collection_handle | prepend: '/collections/' }}"
									id						="{{ forloop.index | prepend: 'tab-' | append: block.id }}"
									data-id  			="{{ forloop.index | append: block.id }}"
									data-toggle		="tab"
									data-limit		="{{ limit }}"
									title					="{{ bst.tab_title }}">
									<span>{{ bst.tab_title }}</span>
								</a>
							{% endif %}
				    {% endfor %}
				  </div>
			  </div>
			</div>
				{% comment %} Product content {% endcomment %}
			<div class="product_tab_content position-relative {{ sst.dots_color }} {{ sst.arrow_color }}" style="--spacing: {{ sst.spacing }}px">
				{% for block in section.blocks %}
					{%- assign bst = block.settings -%}
					{% if block.type == 'tabitem' %}
						<div class="tab-content{% if forloop.first %} active{% endif %}" data-product-TabContent id="{{ forloop.index | prepend: 'producttab-' | append: block.id }}" data-tab-id="{{ forloop.index }}">
							{% if bst.collection_image != blank and sst.show_banner %}<div class="row spacing-0">{% endif %}
								{% if bst.collection_image != blank and sst.show_banner %}
									<div class="cus-col-banner block-banner d-flex relative">
										<div class="theme-blocks-item image-block relative {{ bst.img_animation }}" style="--image-radius: {{ bst.image_radius | append: 'px' }};">
											<div class="image-wrapper position-relative overflow_hidden">
												{% render 'nov-imgset', image: bst.collection_image %}
											</div>
										</div>
										<div class="img-blocks-content position-absolute {{ bst.content_position }} {{ bst.content_visibility }}{% if bst.content_visibility == 'content-partial-reveal' %} js-height{% endif %}{% if bst.display_flex %} d-flex align-items-center justify-content-between{% endif %}" style="--horizontal: {{ bst.content_position_horizontal }}%;--vertical: {{ bst.content_position_vertical }}%; width: {{ bst.content_width }}%; --width-xs: {{ bst.content_width_xs }}%; --bg: {{ bst.content_bg }}; --corner: {{ bst.content_corner }}px; --padding: {{ bst.content_padding }}px; --blur: {{ bst.content_blur }}px;{% if bst.content_shadow %} box-shadow: 0 8px 20px rgba(0,0,0,0.08){% endif %}">
											{%- liquid
												assign class_text = bst.font_family | append: ' ' | append: bst.font_weight | append: ' fs-' | append: bst.font_size_xxl | append: ' fs-xl-' | append: bst.font_size_xl | append: ' fs-lg-' | append: bst.font_size_lg | append: ' fs-md-' | append: bst.font_size_md | append: ' fs-sm-' | append: bst.font_size_sm | append: ' fs-xs-' | append: bst.font_size_xs
											-%}
											<div class="theme-blocks-item blocks-heading text-block {{ class_text }} text-{{ bst.alignment }}{% if bst.responsive_alignment %} text-xl-{{ bst.alignment_xl }} text-lg-{{ bst.alignment_lg }} text-md-{{ bst.alignment_md }} text-sm-{{ bst.alignment_sm }}{% endif %} {{ bst.text_transform }}"
												style="color: {{ bst.color }};letter-spacing: {{ bst.letter_spacing }}px;{% if bst.line_height != blank and bst.line_height == 1 %}line-height: 1;{% else %}line-height: {{ bst.line_height | append: 'px' }};{% endif %}{% if bst.line_height_mb != blank and bst.line_height_mb == 1 %}--line-height-mb: 1;{% else %}--line-height-mb: {{ bst.line_height | append: 'px' }};{% endif %}--max-width: {{ bst.max_w }}px;--mb-xxl: {{ bst.mb_xxl }}px;--mb-xl: {{ bst.mb_xl }}px;--mb-lg: {{ bst.mb_lg }}px;--mb-md: {{ bst.mb_md }}px;--mb-sm: {{ bst.mb_sm }}px;">
												{{ bst.title | newline_to_br }}
											</div>
											{%- liquid
												assign class_text_sub = bst.font_family_sub | append: ' ' | append: bst.font_weight_sub | append: ' fs-' | append: bst.font_size_xxl_sub | append: ' fs-xl-' | append: bst.font_size_xl_sub | append: ' fs-lg-' | append: bst.font_size_lg_sub | append: ' fs-md-' | append: bst.font_size_md_sub | append: ' fs-sm-' | append: bst.font_size_sm_sub | append: ' fs-xs-' | append: bst.font_size_xs_sub
											-%}
											<div class="theme-blocks-item blocks-heading text-block {{ class_text_sub }} text-{{ bst.alignment_sub }}{% if bst.responsive_alignment_sub %} text-xl-{{ bst.alignment_xl_sub }} text-lg-{{ bst.alignment_lg_sub }} text-md-{{ bst.alignment_md_sub }} text-sm-{{ bst.alignment_sm_sub }}{% endif %} {{ bst.text_transform_sub }}"
												style="color: {{ bst.color_sub }};letter-spacing: {{ bst.letter_spacing_sub }}px;{% if bst.line_height_sub != blank and bst.line_height_sub == 1 %}line-height: 1;{% else %}line-height: {{ bst.line_height_sub | append: 'px' }};{% endif %}--max-width: {{ bst.max_w_sub }}px;--mb-xxl: {{ bst.mb_xxl_sub }}px;--mb-xl: {{ bst.mb_xl_sub }}px;--mb-lg: {{ bst.mb_lg_sub }}px;--mb-md: {{ bst.mb_md_sub }}px;--mb-sm: {{ bst.mb_sm_sub }}px;">
												{{ bst.text_sub | newline_to_br }}
											</div>
											<div class="theme-blocks-item button-block color-{{ bst.color_scheme }} text-{{ bst.text_alignment }}" style="--mt-xxl: {{ bst.mt_xxl }}px;--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xxl: {{ bst.mb_xxl }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;{% if bst.btn_type == 'link' %}--color-link: {{ bst.link_color }};--color-hover: {{ bst.link_color_hover }}{% endif %}{% if bst.btn_cus_style and bst.btn_type == 'btn' %}--button-normal-height: {{ bst.btn_cus_height }}px;{% endif %}" {{ block.shopify_attributes }}>
												<a href="{{ bst.link | default: '#' }}" class="{% if bst.btn_type == 'link' %}link d-inline-flex align-items-center fs-{{ bst.link_fs }} {{ bst.link_fw }}{% else %}btn {{ bst.button_size }} {{ bst.button_type_color }} btn-alternate {% if bst.button_full_width %} w-100{% endif %}{% if bst.btn_cus_style %} fs-{{ bst.btn_cus_fs }} {{ bst.btn_cus_fw }}{% endif %}{% endif %}{% if bst.icon_svg_p == 'before' %} flex-row-reverse{% endif %}">
												<span>{{ bst.button_label }}</span>
												{% if bst.show_arrow %}
													<i class="zmdi zmdi-long-arrow-right"></i>
												{% endif %}
												{% if bst.show_arrow == false and bst.icon_svg != blank %}
													<span class="icon-svg">{{ bst.icon_svg }}</span>
												{% endif %}
												</a>
											</div>
										</div>
									</div>
								{% endif %}
								<div class="{% if bst.collection_image != blank and sst.show_banner %}cus-col-product{% endif %}">
									<div class="grid--view-items nov-swiper-carousel swiper overflow-hidden{% if settings.product_shadow_hv %} hv_box_shadow slider-shadow{% endif %} {% if sst.show_type == false %}type-off{% endif %}"
										data-items_xxl="{{ xxl }}"
										data-items_xl="{{ xl }}"
										data-items_lg="{{ lg }}"
										data-items_md="{{ md }}"
										data-items_sm="{{ sm }}"
										data-items_xs="{{ xs }}"
										data-row="{{ row_number }}"
										data-row_mobile="{{ row_mobile }}"
										data-loop="false"
										data-spacing="{{ sst.spacing }}"
										data-spacing_mobile="15">
										<div class="swiper-wrapper products-grid">
											{%- assign breakpoints = "xxl,xl,lg,md,sm,xs" | split: "," -%}
											{%- assign display_classes = "d-none d-xxl-block,d-none d-xl-block d-xxl-none,d-none d-lg-block d-xl-none,d-none d-md-block d-lg-none,d-none d-sm-block d-md-none,d-block d-sm-none" | split: "," -%}
											{%- for bp in breakpoints -%}
												{%- if bp == 'xs' or bp == 'sm' -%}
													{%- assign r = row_mobile -%}
												{%- else -%}
													{%- assign r = row_number -%}
												{%- endif -%}
												{%- assign limit = sst[bp] | times: r -%}
												{%- assign display_class = display_classes[forloop.index0] -%}
												{%- for i in (1..limit) -%}
													<div class="swiper-slide block position-relative {{ display_class }}">
														<div class="imagelazyload" style="aspect-ratio: 3 / 4.6;"></div>
													</div>
												{%- endfor -%}
											{%- endfor -%}
										</div>
									</div>
								</div>
							{% if bst.collection_image != blank and sst.show_banner %}</div>{% endif %}
						</div>
					{% endif %}
				{% endfor %}

				<div class="block-nav {{ sst.arrow_postion }} d-flex justify-content-between align-items-center">
          {% if sst.show_nav %}<div class="nav-arrow nav-prev pointer">{% render 'icon-arrow-prev' %}</div>{% endif %}
					{% if sst.show_scrollbar and sst.arrow_postion == 'arrow_on_bottom' %}<div class="swiper-scrollbar"></div>{% endif %}
          {% if sst.show_nav %}<div class="nav-arrow nav-next pointer">{% render 'icon-arrow-next' %}</div>{% endif %}
        </div>

				{% if sst.show_scrollbar and sst.arrow_postion != 'arrow_on_bottom' %}
					<div class="swiper-scrollbar mt-60"></div>
				{% endif %}
			</div>
		</div>
	</div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    {% if sst.view_all_label %}
    var navLinks = document.querySelectorAll('#shopify-section-{{ section.id }} .nav-link');
    navLinks.forEach(function(navLink) {
      navLink.addEventListener('click', function(event) {
        event.preventDefault();
        var collectionUrl 			= navLink.getAttribute('data-href');
        var viewAllProductLink 	= document.querySelector('#shopify-section-{{ section.id }} .view_all a');
        if (viewAllProductLink) {
          viewAllProductLink.setAttribute('href', collectionUrl);
        }
      });
    });
    {% endif %}

    function initNavTabIndicator() {
      var tabsContainers = document.querySelectorAll('#shopify-section-{{ section.id }} .nav-tabs');
      tabsContainers.forEach(function(tabs) {
        var indicator = tabs.querySelector('.nav-tabs-indicator');
        if (!indicator) return;

        function updateIndicator() {
          var activeTab = tabs.querySelector('.nav-link.active');
          if (activeTab) {
            var activeLi = activeTab.closest('.nav-item') || activeTab;
            var left = activeLi.offsetLeft;
            var top = activeLi.offsetTop;
            var width = activeLi.offsetWidth;
            var height = activeLi.offsetHeight;
            
            indicator.style.transform = 'translate3d(' + left + 'px, ' + top + 'px, 0)';
            indicator.style.width = width + 'px';
            indicator.style.height = height + 'px';
            indicator.style.opacity = '1';
          }
        }

        updateIndicator();

        var links = tabs.querySelectorAll('.nav-link');
        links.forEach(function(link) {
          link.addEventListener('click', function() {
            setTimeout(updateIndicator, 15);
          });
        });

        window.addEventListener('resize', updateIndicator);
      });
    }
    initNavTabIndicator();
  });
</script>

{% schema %}
	{
		"name": "Vinova Collection Tabs",
		"class": "section-collection-tabs",
		"disabled_on": {
			"groups": ["header", "footer", "custom.system"]
		},
		"settings": [
			{
				"type": "richtext",
				"id": "heading",
				"label": "Heading",
				"default": "<p>Vinova Collection Tab</p>"
			},
			{
				"type": "color",
				"id": "heading_color",
				"label": "Heading color",
				"default": "#222222",
				"visible_if": "{{ section.settings.heading != blank }}"
			},
			{
				"type": "richtext",
				"id": "subheading",
				"label": "Sub heading",
				"default": "<p>Subtitle from happy customers</p>"
			},
			{
				"type": "color",
				"id": "subheading_color",
				"label": "Sub heading color",
				"default": "#666666",
				"visible_if": "{{ section.settings.subheading != blank }}"
			},
			{
				"type": "select",
				"id": "subheading_position",
				"label": "Sub heading position",
				"default": "bottom",
				"options": [
					{
						"value": "top",
						"label": "Top"
					},
					{
						"value": "bottom",
						"label": "Bottom"
					}
				],
				"visible_if": "{{ section.settings.subheading != blank }}"
			},
			{
				"type": "richtext",
				"id": "descheading",
				"label": "Description",
				"default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
			},
			{
				"type": "color",
				"id": "descheading_color",
				"label": "Description color",
				"default": "#666666",
				"visible_if": "{{ section.settings.descheading != blank }}"
			},
			{
				"type": "text_alignment",
				"id": "alignment",
				"label": "Alignment",
				"default": "left"
			},
			{
				"type":  "header",
				"content": "Block Banner"
			},
			{
				"type": "checkbox",
				"id": "show_banner",
				"label": "Show Banner"
			},
			{
				"type":  "header",
				"content": "Product Item Per Row"
			},
			{
				"type": "range",
				"id": "xxl",
				"min": 1,
				"max": 6,
				"step": 1,
				"label": "Desktop",
				"default": 4,
				"info": "Breakpoint 1441px"
			},
			{
				"type": "range",
				"id": "xl",
				"min": 1,
				"max": 6,
				"step": 1,
				"label": "Large laptop",
				"default": 4,
				"info": "Breakpoint 1200px"
			},
			{
				"type": "range",
				"id": "lg",
				"min": 1,
				"max": 6,
				"step": 1,
				"label": "Laptop",
				"default": 3,
				"info": "Breakpoint 992px"
			},
			{
				"type": "range",
				"id": "md",
				"min": 1,
				"max": 6,
				"step": 1,
				"label": "Tablet",
				"default": 3,
				"info": "Breakpoint 768px"
			},
			{
				"type": "range",
				"id": "sm",
				"min": 1,
				"max": 6,
				"step": 1,
				"label": "Large mobile",
				"default": 2,
				"info": "Breakpoint 576px"
			},
			{
				"type": "range",
				"id": "xs",
				"min": 1,
				"max": 6,
				"step": 1,
				"label": "Mobile",
				"default": 2
			},
			{
				"type":  "header",
				"content": "Slider Options"
			},
			{
				"type": "range",
				"id": "row_number",
				"min": 1,
				"max": 6,
				"step": 1,
				"label": "Number row",
				"default": 1
			},
			{
				"type": "range",
				"id": "row_mobile",
				"min": 1,
				"max": 6,
				"step": 1,
				"label": "Number row mobile",
				"default": 1
			},
			{
				"type": "range",
				"id": "limit",
				"min": 4,
				"max": 30,
				"step": 1,
				"label": "Limit",
				"default": 30,
				"info": "Select number limit products"
			},
			{
				"type": "range",
				"id": "spacing",
				"min": 0,
				"max": 30,
				"step": 5,
				"unit": "px",
				"label": "Spacing",
				"default": 30,
				"info": "Spacing item"
			},
			{
				"type": "header",
				"content": "Scrollbar Slider"
			},
			{
				"type": "checkbox",
				"id": "show_scrollbar",
				"label": "Show Scrollbar"
			},
			{
				"type": "select",
				"id": "dots_color",
				"label": "Scrollbar color",
				"default": "dots_on_light",
				"options": [
					{"value": "dots_on_light","label": "Scrollbar on light background"},
					{"value": "dots_on_dark","label": "Scrollbar on dark background"}
				],
				"visible_if": "{{ section.settings.show_scrollbar }}"
			},
			{
				"type": "header",
				"content": "Arrow Slider"
			},
