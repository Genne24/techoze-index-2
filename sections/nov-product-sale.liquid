      },
      {
        "type": "range",
        "id": "card_border_width",
        "label": "Card Border Width",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 4,
        "unit": "px",
        "visible_if": "{{ section.settings.enable_border }}"
      },
      {
        "type": "range",
        "id": "card_border_radius",
        "label": "Card Border Radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "default": 20,
        "unit": "px",
        "visible_if": "{{ section.settings.enable_border }}"
      },
      {
        "type": "color",
        "id": "card_bg_color",
        "label": "Card Background Color",
        "default": "#F7F7F7"
      },
      {
        "type": "header",
        "content": "Big Background Text (Watermark)"
      },
      {
        "type": "range",
        "id": "watermark_font_size_xxl",
        "label": "Font Size",
        "min": 30,
        "max": 150,
        "step": 5,
        "default": 100,
        "unit": "px"
