{%- liquid
  assign sst = section.settings
  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if sst.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}
{%- style -%}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .slider-item-content {
    border-radius: {{ sst.item_corner }}px;
    overflow: hidden;
    transform: translateZ(0);
    {% if sst.show_item_boxshadow and sst.show_item_boxshadow_when_hover == false %}
      box-shadow: 5px 5px 20px rgba(0,0,0, 0.1);
    {% endif %}
  }
  {% if sst.show_item_boxshadow %}
    #shopify-section-{{ section.id }} .slick-list {
      margin-block: -25px;
      padding-block: 25px;
    }
  {% endif %}
  {% if sst.show_item_boxshadow and sst.show_item_boxshadow_when_hover %}
    #shopify-section-{{ section.id }} .slider-item-content:hover {
      box-shadow: 10px 10px 25px rgba(0,0,0, 0.1);
    }
  {% endif %}
  
  @media (min-width: 1200px) {
    #shopify-section-{{ section.id }} .slick-list {
      padding-inline-start: {{ sst.padding_left_xl }}vw !important;
      padding-inline-end: {{ sst.padding_right_xl }}vw !important;
      margin-inline-start: {{ sst.margin_left_xl }}vw !important;
      margin-inline-end: {{ sst.margin_right_xl }}vw !important;
    }
  }
  @media (min-width: 992px) and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .slick-list {
      padding-inline-start: {{ sst.padding_left_lg }}vw !important;
      padding-inline-end: {{ sst.padding_right_lg }}vw !important;
      margin-inline-start: {{ sst.margin_left_lg }}vw !important;
      margin-inline-end: {{ sst.margin_right_lg }}vw !important;
    }
  }
  @media (min-width: 768px) and (max-width: 991px) {
    #shopify-section-{{ section.id }} .slick-list {
      padding-inline-start: {{ sst.padding_left_md }}vw !important;
      padding-inline-end: {{ sst.padding_right_md }}vw !important;
      margin-inline-start: {{ sst.margin_left_md }}vw !important;
      margin-inline-end: {{ sst.margin_right_md }}vw !important;
    }
  }
  @media (min-width: 576px) and (max-width: 767px) {
    #shopify-section-{{ section.id }} .slick-list {
      padding-inline-start: {{ sst.padding_left_sm }}vw !important;
      padding-inline-end: {{ sst.padding_right_sm }}vw !important;
      margin-inline-start: {{ sst.margin_left_sm }}vw !important;
      margin-inline-end: {{ sst.margin_right_sm }}vw !important;
    }
  }
  @media (max-width: 575px) { 
    #shopify-section-{{ section.id }} .slick-list {
      padding-inline-start: {{ sst.padding_left_xs }}vw !important;
      padding-inline-end: {{ sst.padding_right_xs }}vw !important;
      margin-inline-start: {{ sst.margin_left_xs }}vw !important;
      margin-inline-end: {{ sst.margin_right_xs }}vw !important;
    }
  }
{%- endstyle -%}

<div class="container-outer{{ bg_class_full }} color-{{ sst.color_section }}" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }} {{ sst.dots_color }} {{ sst.arrow_color }}">
      {% if sst.direction_position == 'top' %}
        <div class="d-md-flex align-items-end justify-content-between mb-55 mb-sm-30">
          {% render 'heading-section', sub_position: sst.subheading_position, class: 'mb-0' %}
          {% if sst.show_nav or sst.show_dots %}
            <div class="slider-direction d-flex align-items-center mt-sm-20">
              {% if sst.show_nav %}
                <div class="nav-arrow nav-prev pointer">{% render 'icon-arrow-prev' %}</div>
              {% endif %}
              {% if sst.show_dots %}
                <div class="append-dots"></div>
              {% endif %}
              {% if sst.show_nav %}
                <div class="nav-arrow nav-next pointer">{% render 'icon-arrow-next' %}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% else %}
        {% render 'heading-section', sub_position: sst.subheading_position %}
      {% endif %}
      <div class="position-relative">
        <div class="nov-slick-carousel row spacing-{{ sst.spacing }} spacing-md-{{ sst.spacing_md }} {% if sst.center and sst.center_opa %} center-opa{% endif %}"
          data-autoplay="{{ sst.autoplay }}" 
          data-loop="{{ sst.loop }}"
          data-dots="{{ sst.show_dots }}"
          data-nav="{% if sst.direction_position != 'center' %}false{% else %}{{ sst.show_nav }}{% endif %}"
          data-row="1"
          data-row_mobile="1"
          data-items_xxl="{{ sst.xxl }}"
          data-items_xl="{{ sst.xl }}"
          data-items_lg="{{ sst.lg }}"
          data-items_md="{{ sst.md }}"
          data-items_sm="{{ sst.sm }}"
          data-items_xs="{{ sst.xs }}"
          data-speed="700"
          data-center="{{ sst.center }}"
        {% if sst.oneslider %}data-oneslider="1"{% endif %}>
            {% content_for 'blocks' %}
        </div>
      </div>
      {% if sst.direction_position == 'bottom' %}
        {% if sst.show_nav or sst.show_dots %}
          <div class="slider-direction d-flex align-items-center justify-content-center mt-65 mt-sm-30">
            {% if sst.show_nav %}
              <div class="nav-arrow nav-prev nav-icon pointer"></div>
            {% endif %}
            {% if sst.show_dots %}
              <div class="append-dots"></div>
            {% endif %}
            {% if sst.show_nav %}
              <div class="nav-arrow nav-next nav-icon pointer"></div>
            {% endif %}
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
  {% if sst.pattern != blank %}
    <div class="pattern-section pattern-1 position-absolute d-none {{ sst.pattern_respon }} {{ sst.pattern_position }} {{ sst.pattern_animate }}" style="--horizontal: {{ sst.pattern_horizontal }}%;--vertical: {{ sst.pattern_vertical }}%;--width: {{ sst.pattern_width }}%;">
      {% render 'nov-aspect-image', image: sst.pattern, class: 'no-ef' %}
    </div>
  {% endif %}
</div>
