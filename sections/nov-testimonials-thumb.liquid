{%- liquid
  assign sst = section.settings
  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}

{%- liquid
  case sst.thumb_layout
    when '3-2-1'
      assign thumb_cols_map = '1,2,3,1,2,1'
      assign thumb_max_cols = 3
    when '2-2-2'
      assign thumb_cols_map = '1,2,1,2,1,2'
      assign thumb_max_cols = 2
    when '2-2-1'
      assign thumb_cols_map = '1,2,1,2,1,1'
      assign thumb_max_cols = 2
    when '3-3'
      assign thumb_cols_map = '1,2,3,1,2,3'
      assign thumb_max_cols = 3
    when '3-2'
      assign thumb_cols_map = '1,2,3,1,2,2'
      assign thumb_max_cols = 3
    when '1-2-3'
      assign thumb_cols_map = '1,1,2,1,2,3'
      assign thumb_max_cols = 3
    when '2-2'
      assign thumb_cols_map = '1,2,1,2,1,2'
      assign thumb_max_cols = 2
    else
      assign thumb_cols_map = '1,2,3,1,2,1'
      assign thumb_max_cols = 3
  endcase
  assign thumb_cols_parts = thumb_cols_map | split: ','
  -%}
  {%- style -%}
  {% render 'nov-section-style' %}
  
  #shopify-section-{{ section.id }} {
    --thumb-max-cols: {{ thumb_max_cols }};
    --thumb-item-size: {{ sst.thumb_item_size | append: 'px' }};
    --thumb-gap: {{ sst.thumb_gap | append: 'px' }};
    --thumb-corner: {{ sst.thumb_corner | append: 'px' }};
    --quote-icon-size: {{ sst.quote_icon_size | append: 'px' }};
    --quote-icon-color: {{ sst.quote_icon_color }};
    --quote-size: {{ sst.quote_size | append: 'px' }};
    --quote-weight: {{ sst.quote_weight }};
    --quote-lh: {{ sst.quote_lh | append: 'px' }};
    --quote-color: {{ sst.quote_color }};
    --name-size: {{ sst.name_size | append: 'px' }};
    --name-weight: {{ sst.name_weight }};
    --name-lh: {{ sst.name_lh | append: 'px' }};
    --name-color: {{ sst.name_color }};
  }
{%- endstyle -%}

<div class="color-{{ sst.color_section }}{{ bg_class_full }}" data-section-id="{{ section.id }}" data-section-type="nov-swiper">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }} {{ sst.full_bleed_side | prepend: 'full-screen-' }}">
      {% render 'heading-section', sub_position: sst.subheading_position %}

      {%- if section.blocks.size > 0 -%}
        <div class="row align-items-lg-center">
          <div class="col-lg-3 col-md-4 col-12 tts-left-col">
            <div class="block_content_avatar" id="tts-thumb-{{ section.id }}">
              {%- for block in section.blocks -%}
                {%- assign bst = block.settings -%}
                {%- assign thumb_col_val = thumb_cols_parts[forloop.index0] | strip -%}
                <div
                  class="avatar-content overflow-hidden{% if forloop.first %} active{% endif %}"
                  data-index="{{ forloop.index0 }}"
                  style="grid-column: {{ thumb_col_val }};"
                  {{ block.shopify_attributes }}
                >
                  {%- if bst.avatar != blank -%}
                    {% render 'nov-imgset', image: bst.avatar %}
                  {%- else -%}
                    {%- capture ph_index -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                    {{ 'collection-apparel-' | append: ph_index | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
          <div class="col-lg-9 col-md-8 col-12 tts-content-wrap relative">
            <div class="nov-swiper-carousel swiper"
              data-loop="true"
              data-row="1"
              data-row_mobile="1"
              data-items_xxl="1"
              data-items_xl="1"
              data-items_lg="1"
              data-items_md="1"
              data-items_sm="1"
              data-items_xs="1"
              data-speed="500"
              data-effect="fade"
              data-spacing="0"
              data-spacing_mobile="0">
              <div class="swiper-wrapper">
                {%- for block in section.blocks -%}
                  {%- assign bst = block.settings -%}
                  <div class="swiper-slide item" {{ block.shopify_attributes }}>
                    {%- if bst.quote != blank -%}
                      <div class="tts-quote-text">{{ bst.quote }}</div>
                    {%- endif -%}
                    {%- if bst.name != blank -%}
                      <div class="tts-author-name">{{ bst.name }}</div>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>

            {%- if sst.show_nav -%}
              {%- if sst.arrow_postion == 'arrow_on_bottom' -%}
                {%- liquid 
                  if sst.arrow_alignment == 'left'
                    assign arrow_alignment = 'start'
                  elsif sst.arrow_alignment == 'right'
                    assign arrow_alignment = 'end'
                  else
                    assign arrow_alignment = 'center'
                  endif
                -%}
              {%- endif -%}
              <div class="block-nav {{ sst.arrow_postion }} {{ sst.arrow_alignment }}{% if sst.arrow_postion == 'arrow_on_bottom' %} d-flex {{ arrow_alignment | prepend: 'justify-content-' }}{% endif %}">
                <div class="nav-arrow nav-prev pointer">{% render 'icon-arrow-prev' %}</div>
                <div class="nav-arrow nav-next pointer">{% render 'icon-arrow-next' %}</div>
              </div>
            {%- endif -%}

            {%- if sst.quote_icon != blank -%}
              <div class="tts-quote-icon" aria-hidden="true">
                {%- if sst.quote_icon != blank -%}
                  {{- sst.quote_icon | image_url: width: 345 | image_tag: loading: 'lazy', alt: sst.quote_icon.alt -}}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        {% render 'no-blocks' %}
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function() {
    var sectionId = '{{ section.id }}';

    function syncAvatars(index) {
      var thumbEl = document.querySelector('#tts-thumb-' + sectionId);
      if (!thumbEl) return;
      thumbEl.querySelectorAll('.avatar-content').forEach(function(el) {
        el.classList.toggle('active', parseInt(el.dataset.index) === index);
      });
    }

    function init() {
      var swiperEl = document.querySelector('#shopify-section-' + sectionId + ' .nov-swiper-carousel');
      if (!swiperEl || !swiperEl.swiper) return;
      var swiper = swiperEl.swiper;
      swiper.on('slideChange', function() {
        syncAvatars(swiper.realIndex);
      });
      var thumbEl = document.querySelector('#tts-thumb-' + sectionId);
      if (thumbEl) {
        thumbEl.querySelectorAll('.avatar-content').forEach(function(el) {
          el.addEventListener('click', function() {
            var idx = parseInt(el.dataset.index) || 0;
            swiper.slideTo(idx);
          });
        });
      }
    }
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(init, 300);
    });
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === sectionId) setTimeout(init, 300);
    });
  })();
</script>

