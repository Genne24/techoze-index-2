{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif

  assign collection = collections[sst.collection]
  assign product_limit = sst.limit
-%}
{% style %}
  {% render 'nov-section-style' %}

  {% if sst.enable_custom_style %}
    #shopify-section-{{ section.id }} {
      --product-color-border: {{ sst.product_border_color }};
      --product-color-background: {{ sst.product_background_color }};
      --product-color-type: {{ sst.product_type_color }};
      --product-color-title: {{ sst.product_title_color }};
      --product-color-title-hover: {{ sst.product_title_color_hover }};
      --product-color-price: {{ sst.product_price_color }};
      --product-color-reduced-price: {{ sst.product_price_reduced_color }};
    }
  {% endif %}
  #shopify-section-{{ section.id }} {
    --slider-arrow-color: {{ sst.arrow_color }};
    --slider-arrow-color-act: {{ sst.arrow_color_act }};
  }
{% endstyle %}
<div class="{{ bg_class_full }} position-relative" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }} {{ sst.dots_color }} {{ sst.arrow_color }}">
      {% render 'heading-section', sub_position: sst.subheading_position %}
      <div class="grid--view-items nov-slick-carousel row spacing-{{ sst.spacing }} spacing-sm-15"
        data-autoplay="false" 
        data-autoplayTimeout="6000"
        data-loop="false"
        data-dots="{{ sst.show_dots }}"
        data-nav="{{ sst.show_nav }}"
        data-row="{{ sst.row_number }}"
        data-row_mobile="{{ sst.row_number }}"
        data-items_xxl="{{ sst.xxl }}"
        data-items_xl="{{ sst.xl }}"
        data-items_lg="{{ sst.lg }}"
        data-items_md="{{ sst.md }}"
        data-items_sm="{{ sst.sm }}"
        data-items_xs="{{ sst.xs }}">
        {% for product in collection.products limit: product_limit %}
          <div class="sp-item item {% render 'number-to-col', xxl: sst.xxl, xl: sst.xl, lg: sst.lg, md: sst.md, sm: sst.sm, xs: sst.xs  %}">
            {% render 'product-grid-item-style-1', product: product, section_id: section.id %}
          </div>
        {% else %}
          {%- for i in (1..6) -%}
            {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
            <div class="sp-item item {% render 'number-to-col', xxl: sst.xxl, xl: sst.xl, lg: sst.lg, md: sst.md, sm: sst.sm, xs: sst.xs  %}">
              {{ 'product-apparel-' | append: current | placeholder_svg_tag : 'placeholder-svg' }}
            </div>
          {%- endfor -%}
        {% endfor %}
      </div>
      {% if sst.show_nav or sst.show_dots %}
        <div class="block-direc d-flex align-items-center justify-content-center mt-65 mt-lg-35">
          {% if sst.show_nav %}
            <div class="nav-prev nav-arrow pointer nav-icon"></div>
          {% endif %}
          {% if sst.show_dots %}
            <div class="append-dots"></div>
          {% endif %}
          {% if sst.show_nav %}
            <div class="nav-next nav-arrow pointer nav-icon"></div>
          {% endif %}
        </div>
      {% endif %}
      {% if sst.viewall_label != blank %}
        <div class="text-center mt-60 mt-sm-30">
          <a href="{{ collection.url }}" class="btn btn-medium color-{{ sst.viewall_color }} {{ sst.button_type_color }}">
            <span>{{ sst.viewall_label }}</span>
            <i class="zmdi zmdi-long-arrow-right"></i>
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% schema %}
