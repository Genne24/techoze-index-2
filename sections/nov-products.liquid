        "visible_if": "{{ section.settings.show_dots }}"
      },
      {
        "type": "checkbox",
        "id": "show_nav",
        "label": "Show prev/next arrow"
      },
      {
        "type": "color",
        "id": "arrow_color",
        "label": "Arrow color",
        "default": "#666",
        "visible_if": "{{ section.settings.show_nav }}"
      },
      {
        "type": "color",
        "id": "arrow_color_act",
        "label": "Arrow color hover",
        "default": "#222",
        "visible_if": "{{ section.settings.show_nav }}"
      },
