      {
        "type": "header",
        "content": "Product Item Custom Style"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom style"
      },
      {
        "type": "color",
        "id": "product_border_color",
        "label": "Border color",
        "default": "#d2d2d2",
        "info": "In case the show border option is enabled",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
