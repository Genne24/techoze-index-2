        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_bottom_sm",
        "label": "Mobile",
        "default": 30
      }
    ],
    "blocks": [
      {
        "type": "slide",
        "name": "Item Slide",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "stitle",
            "label": "Subtitle",
            "default": "Step One"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Initial Consultation"
          },
          {
            "type": "richtext",
            "id": "desc",
            "label": "Description",
            "default": "<p>Your journey begins with a comprehensive consultation to understand your skin condition, muscle tension, lifestyle habits</p>"
          },
          {
            "type": "text",
            "id": "btn_label",
            "label": "Button label",
            "default": "Shop now"
          },
          {
            "type": "url",
            "id": "btn_link",
