
{%- liquid 
  assign sst = section.settings
  
  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if sst.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif

-%}
{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .card_gallery a {
    border-radius: {{ sst.border_radius }}px;
  }
{% endstyle %}

<div class="container-outer{{ bg_class_full }}">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }} position-relative">
      {% render 'heading-section', sub_position: sst.subheading_position %}
      <div class="row spacing-{{ sst.spacing }} spacing-md-{{ sst.spacing_md }}">
        {% for block in section.blocks %}
          <div class="{% render 'number-to-col', xxl: sst.xxl, xl: sst.xl, lg: sst.lg, md: sst.md, sm: sst.sm, xs: sst.xs  %} mb-{{ sst.spacing }} mb-md-{{ sst.spacing_md }}">
            <div class="card_gallery hover-image d-block position-relative{% if settings.animate %} scroll-trigger animate--slide-in{% endif %}"{% if settings.animate %} data-cascade style="--animation-order: {{ forloop.index0 }};"{% endif %}>
              <a href="{{ block.settings.image | image_url: width: 1200 }}" class="d-block overflow_hidden" data-fancybox="gallery">
                {% if block.settings.image != blank %}
                  {% render 'nov-aspect-image', image: block.settings.image, aspect: sst.aspect %}
                {% else %}
                  {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                  {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
                <i class="rbb-icon-social-instagram-1"></i>
              </a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

