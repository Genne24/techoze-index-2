{{ 'css-header3.css' | asset_url | stylesheet_tag }}

{%- liquid 
  assign sst = section.settings 
  assign logo = section.settings.logo 
  assign logo_w = section.settings.w_logo 
-%}

{% style -%}
  @media(min-width: 1200px) {
    .site-header__logo {
      width: {{ sst.logo_w | append: 'px' }};
    }
  }
  .site-header, #header-sticky, .header-clamp {
    --menu-fs: {{ sst.menu_fs | times: 0.1 }}rem;
    --menu-fw: {{ sst.menu_fw }};
    --menu-ff: {{ sst.menu_ff }};
  }
  .template-index .header-top {
    background: {{ sst.header_top_bg_index }};
    backdrop-filter: blur({{ sst.header_top_bg_blur | append: 'px'}});
    color: var(--color-text);
  }
  body:not(.template-index) .header-top {
    background: {{ sst.header_top_bg_inner }};
    color: var(--color-text);
  }
  {% if sst.header_bottom_bg_type == 'default' %}
    #header-sticky, .header-mobile .header-mobile-content , .header-content, .site-header {
      background: {{ sst.header_bottom_bg }};
    }
  {% elsif  sst.header_bottom_bg_type == 'gradient' %}
    .site-header {
      background: {{ sst.header_bottom_bg_gr }};
    }
  {% endif %}
  .header-content {
    background: {{ sst.header_center_bg }};
  }
{%- endstyle %}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if sst.logo %}
      "logo": {{ sst.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>
<header class="site-header{% if sst.stickymenu %} sticky-header{% endif %}">
  <div class="header-top relative z-10 {% if request.page_type == 'index' %}color-{{ sst.header_top_color_index }}{% else %}color-{{ sst.header_top_color_inner }}{% endif %} {{ sst.pt_hd_top | prepend: 'pt-' }} {{ sst.pb_hd_top | prepend: 'pb-' }} d-none d-md-block">
    <div class="{{ sst.container }}">
      <div class="row align-items-center spacing-10">
        <div class="col-lg-4 col-6 d-flex align-items-center">
          {% for block in section.blocks %}
            {% if block.type == 'header_link' %}
              <div class="header-link-item">
                <a class="duration-300" href="{{ block.settings.link_url | default: "#" }}">{{ block.settings.link_text }}</a>
              </div>
            {% endif %}
          {% endfor %}
          {% if sst.address != blank or sst.phone != blank %}
            <div class="header-contact d-flex align-items-center">
              {% if sst.address != blank %}
                <div class="header-contact-item d-flex align-items-center">
                  <i class="rbb-icon-location-5 color-icons"></i>
                  <a href="{{ sst.address_link | default: "#" }}">{{ sst.address }}</a>
                </div>
              {% endif %}
              {% if sst.phone != blank %}
                <div class="header-contact-item d-flex align-items-center">
                  <i class="rbb-icon-phone-4 color-icons"></i>
                  <a href="tel:{{ sst.phone }}">{{ sst.phone }}</a>
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
        <div class="col-lg-4 col-12 order-lg-0 order-2">
          {% for block in section.blocks %}
            {% if block.type == 'header_text' %}
              {% if block.settings.header_top_text != blank or block.settings.header_top_text_icon != blank or block.settings.highlight_word != blank %}
                <div class="header_text d-flex align-items-center justify-content-center">
                  {% if block.settings.header_top_text_icon != blank %}
                    <div class="header-top-icon-text">
                      {% render 'nov-aspect-image', image: block.settings.header_top_text_icon, class: 'no-ef' %}
                    </div>
                  {% endif %}
                  {% if block.settings.highlight_word != blank %}
                    <span class="highlight" style="background-color: {{ block.settings.highlight_bg }};font-size: {{ block.settings.header_text_fz | minus: 3 | append: 'px' }};color: {{ block.settings.highlight_color }};padding: 5px;border-radius: {{ block.settings.highlight_radius | append: 'px' }};">{{ block.settings.highlight_word }}</span>
                  {% endif %}
                  <span style="font-size: {{ block.settings.header_text_fz | append: 'px' }};font-weight: {{ block.settings.header_text_fw }};color: {{ block.settings.header_text_color }};">{{ block.settings.header_top_text }}</span>
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
        <div class="col-lg-4 col-6 d-flex align-items-center justify-content-end">
          {% if sst.show_social %}
            {% render 'nov-social' %}
          {% endif %}
          {% if sst.show_currency or sst.show_language %}
            <div class="nov-lang-cur nov_ud_toggle btn-secondary d-flex align-items-center" data-ud_collapse="true">
              {% if sst.show_currency %}
                <div class="block-currency nov_ud_group">
                  {% render 'nov-block-currency' %}
                </div>
              {% endif %}
              {%- if sst.show_language -%}
                <div class="block-language nov_ud_group">
                  {% render 'nov-block-language', id: 'CanvasLanguage' %}
                </div>
              {%- endif -%}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  <div class="header-content {{ sst.pt_hd_c | prepend: 'pt-' }} {{ sst.pb_hd_c | prepend: 'pb-' }} {{ sst.pt_hd_lg | prepend: 'pt-lg-' }} {{ sst.pb_hd_lg | prepend: 'pb-lg-' }} header-search__parent d-none d-md-block color-{{ sst.header_bottom_color }}">
    <div class="{{ sst.container }}">
      <div class="row">
        <div class="col-3 d-flex align-items-center">
          <div class="site-nav--btn d-flex d-xl-none align-items-center justify-content-center">
            <span class="icon"><span></span></span>
          </div>
          <div class="contentsticky_logo relative d-flex align-items-center">
            {%- if logo != blank -%}
              <div class="header__heading-logo-wrapper d-flex align-items-center">
                {%- assign logo_alt = logo.alt | default: shop.name -%}
                {%- assign logo_height = logo_w | divided_by: logo.aspect_ratio | round -%}
                {% capture sizes %}(max-width: {{ logo_w | times: 2 | append: 'px' }}) 50vw, {{ logo_w | append: 'px' }}{% endcapture %}
                {% capture widths %}{{ logo_w }}, {{ logo_w | times: 1.5 | round }}, {{ logo_w | times: 2 }}{% endcapture %}
                {{ logo | image_url: width: 600 | image_tag:
                  class: 'header_logo_desktop h-auto',
                  widths: widths,
                  height: logo_height,
                  width: logo_w,
                  alt: logo_alt,
                  fetchpriority: "high",
                  sizes: sizes,
                  preload: true
                }}
              </div>
            {%- else -%}
              <span>{{ shop.name }}</span>
            {%- endif -%}
            <a href="{{ routes.root_url }}" class="heading-logo-link absolute t-0 l-0 w-100 h-100" aria-label="Logo"></a>
          </div>
        </div>
        <div class="col-6">
          <div class="contentsticky_menu d-flex d-xl-block align-items-center">
            <nav id="AccessibleNav" class="text-center d-none d-xl-block h-100" style="--color-menu: {{ sst.color_menu }};--color-menu-hover: {{ sst.color_menu_hover }};">
              {% render 'site-nav' color: sst.color_menu_dropdown, mainmenu: sst.main_linklist, menu_alignment: sst.menu_alignment %}
            </nav>
          </div>
        </div>
        <div class="col-3 d-flex justify-content-end align-items-center">
          <div class="header-group-item d-flex align-items-center">
            {% if settings.search_enable %}
              <div class="contentsticky_search">
                <div class="search__btn-overlay header-icon align-items-center nov_btn_act" data-toggle="search_canvas" data-overlay="true">
                  {% render 'icon-search' %}
                </div>
              </div>
            {% endif %}
            {% if shop.customer_accounts_enabled %}
              <div class="contentsticky_account pointer">
                <div class="header-icon nov_btn_act" data-toggle="header_settings" data-overlay="true" title="{{ 'layout.customer.account' | t }}">
                  {% if sst.account_svg %}
                    {% render 'icon-account' %}
                  {% else %}
                    <i class="{{ sst.account_icon }} position-relative"></i>
                  {% endif %}
                </div>
              </div>
            {% endif %}
            {% if settings.wishlist_enable %}
              <div class="contentsticky_wishlist header--wishlist">
                <a href="{{ settings.link_page_wishlist }}" class="header-icon align-items-center" rel="nofollow" title="{{ 'layout.customer.wishlists' | t }}">
                  <span class="header-wishlist-icon position-relative d-inline-flex">
                    {% if sst.wishlist_svg %}
                      {% render 'icon-star' %}
                    {% else %}
                      <i class="{{ sst.wishlist }} position-relative"></i>
                    {% endif %}
                    <span class="WishlistCount text-center">0</span>
                  </span>
                </a>
              </div>
            {% endif %}
            <div class="contentsticky_cart">
              <div id="cart_block">
                <div class="header-cart d-flex align-items-center">
                  <div class="site-header__cart header-icon align-items-center pointer">
                    <div class="site-header__cart-icon position-relative d-flex justify-content-between align-items-center duration-300">
                      <div class="site-header__cart-gr d-flex align-items-center gap-10">
                        {% if sst.cart_svg %}
                          {% render 'icon-cart' %}
                        {% else %}
                          <i class="rbb-icon-shopping-{{ sst.cart_type }}-{{ sst.cart }} position-relative"></i>
                        {% endif %}
                      </div>
                      <div class="site-header__cart-count duration-300">
                        <span class="CartCount">{{ cart.item_count }}</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            {% for block in section.blocks %}
              {% if block.type == '@app' %}
                {% render block %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="header-mobile d-md-none color-{{ sst.header_bottom_color }}{% if sst.stickymenu_sm %} sticky-header-mobile{% endif %}">
    <div class="header-mobile-content">
      <div class="row align-items-center h-100 spacing-10">
        <div class="col-3 d-flex align-items-center">
          <div id="show-megamenu" class="item-mobile-top">
            <div class="icon-directional"></div>
          </div>
          <div class="mobile-btn_search item-mobile-top">
            {% render 'icon-search' %}
            <i class="zmdi zmdi-close"></i>
          </div>
          <div id="mobile_search">
            {% render 'nov-formsearch-inline' %}
          </div>
        </div>
        <div class="mobile_logo col-6 text-center">
          {% if sst.logo %}
            <a href="{{ routes.root_url }}" class="site-header__logo-image img-fluid d-inline-block">
              {%- assign logo_alt = sst.logo.alt | default: shop.name | escape -%}
              {%- assign logo_height = sst.wm_logo | divided_by: sst.logo.aspect_ratio | round -%}
              {% capture sizes %}(max-width: {{ sst.wm_logo | times: 2 | append: 'px'}}) 50vw, {{ sst.wm_logo | append: 'px'}}{% endcapture %}
              {% capture widths %}{{ sst.wm_logo }}, {{ sst.wm_logo | times: 1.5 | round }}, {{ sst.wm_logo | times: 2 }}{% endcapture %}
              {{ sst.logo | image_url: width: 600 | image_tag:
                widths: widths,
                height: logo_height,
                width: sst.wm_logo,
                alt: logo_alt,
                sizes: sizes,
                preload: true
              }}
            </a>
          {% else %}
            <a class="site-header__logo-link" href="{{ routes.root_url }}" itemprop="url">{{ shop.name }}</a>
          {% endif %}
        </div>
        <div class="mobile_cart col-3 d-flex justify-content-end align-items-center">
          <div class="header-cart">
            <div class="site-header__cart position-relative">
              <span class="cart-count position-absolute" title="{{ 'layout.cart.title_cart' | t }}">
                <span class="CartCount">{{ cart.item_count }}</span>
              </span>
              <div class="site-header__cart-icon">
                {% if sst.cart_svg %}
                  {% render 'icon-cart' %}
                {% else %}
                  <i class="rbb-icon-shopping-{{ sst.cart_type }}-{{ sst.cart }} position-relative"></i>
                {% endif %}
              </div>
            </div>
          </div>
          <div class="btn-vertical btn-vertical-mobile"> 
            <div class="icon">
              <span></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

{% if sst.stickymenu %}
  <div id="header-sticky" class="d-none d-md-block header-search__parent color-{{ sst.header_bottom_color }}">
    <div class="{{ sst.container }}">
      <div class="bl_content row align-items-center">
        <div class="col-3 d-flex align-items-center">
          <div class="contentstickynew_logo d-flex align-items-center justify-content-center"></div>
        </div>
        <div class="col-6 d-xl-flex align-items-center {{ sst.menu_alignment | prepend: 'justify-content-' }}">
          <div class="contentstickynew_menu d-flex" style="--color-menu: {{ sst.color_menu }};--color-menu-hover: {{ sst.color_menu_hover }};"></div>
        </div>
        <div class="col-3 d-flex align-items-center justify-content-end">
          <div class="header-group-item d-flex align-items-center justify-content-end">
            {% if shop.customer_accounts_enabled %}
              <div class="contentstickynew_account"></div>
            {% endif %}
            {% if settings.wishlist_enable %}
              <div class="contentstickynew_wishlist"></div>
            {% endif %}
            <div class="contentstickynew_cart"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

<div class="d-xl-none">{% render 'nov-mobile-canvas', mainmenu: sst.main_linklist %}</div>

{% render 'nov-search-canvas' %}

{% schema %}
  {
    "name": "Header",
    "settings": [
      {
        "type": "header",
        "content": "Header Logo"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "number",
        "id": "w_logo",
        "label": "Width logo large laptop (px)",
        "default": 150,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "wm_logo",
        "label": "Width logo mobile (px)",
        "default": 100
      },
      {
        "type": "header",
        "content": "Header Container"
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          { "value": "container", "label": "Container" },
          { "value": "container-fluid", "label": "Container fluid"}
        ]
      },
      {
        "type": "header",
        "content": "Header Top Color"
      },
      {
        "type": "color",
        "id": "header_top_bg_index",
        "alpha": true,
        "label": "Background page index",
        "default": "#fff"
      },
      {
        "type": "number",
        "id": "header_top_bg_blur",
        "label": "Background blur page index",
        "default": 0
      },
      {
        "type": "color_scheme",
        "id": "header_top_color_index",
        "label": "Color page index",
        "default": "background-1"
      },
      {
        "type": "color",
        "id": "header_top_bg_inner",
        "alpha": true,
        "label": "Background page inner",
        "default": "#fff"
      },
      {
        "type": "color_scheme",
        "id": "header_top_color_inner",
        "label": "Color page inner",
        "default": "background-1"
      },
      {
        "type": "header",
        "content": "Header Color"
      },
      {
        "type": "select",
        "id": "header_bottom_bg_type",
        "label": "Header Background Type",
        "default": "default",
        "options": [
          { "value": "default", "label": "Default" },
          { "value": "gradient", "label": "Gradient" }
        ]
      },
      {
        "type": "color",
        "id": "header_bottom_bg",
        "alpha": true,
        "label": "Header background",
        "default": "#fff",
        "visible_if": "{{ section.settings.header_bottom_bg_type == 'default' }}"
      },
      {
        "type": "color_background",
        "id": "header_bottom_bg_gr",
        "label": "Gradient",
        "info": "Background gradient replaces background where possible.",
        "visible_if": "{{ section.settings.header_bottom_bg_type == 'gradient' }}"
      },
      {
        "type": "color_scheme",
        "id": "header_bottom_color",
        "label": "Header color",
        "default": "background-1"
      },
      {
        "type": "header",
        "content": "Header Sticky"
      },
      {
        "type": "checkbox",
        "id": "stickymenu",
        "label": "Enable Sticky Header Desktop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "stickymenu_sm",
        "label": "Enable Sticky Header Mobile",
        "default": true
      },
      {
        "type": "header",
        "content": "Header Top"
      },
      {
        "type": "checkbox",
        "id": "show_currency",
        "label": "Show currency",
        "info": "[Manage countries/regions](/admin/settings/markets)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_language",
        "label": "Show language",
        "info": "[Manage languages](/admin/settings/languages)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_social",
        "label": "Show social",
        "default": true
      },
      {
        "type": "header",
        "content": "Padding"
      },
      {
        "type": "range",
        "id": "pt_hd_top",
        "label": "Top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 10
      },
      {
        "type": "range",
        "id": "pb_hd_top",
        "label": "Bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 10
      },
      {
        "type": "header",
        "content": "Header Center"
      },
      {
        "type": "color",
        "id": "header_center_bg",
        "alpha": true,
        "label": "Background header center",
        "default": "#FFFFFF"
      },
      {
        "type": "header",
        "content": "Padding"
      },
      {
        "type": "range",
        "id": "pt_hd_c",
        "label": "Top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 30
      },
      {
        "type": "range",
        "id": "pb_hd_c",
        "label": "Bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "pt_hd_lg",
        "label": "Top (Tablet)",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "px",
        "default": 25
      },
      {
        "type": "range",
        "id": "pb_hd_lg",
        "label": "Bottom (Tablet)",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "px",
        "default": 25
      },
      {
        "type": "header",
        "content": "Choose Canvas Icon"
      },
      {
        "type": "select",
        "id": "account_icon",
        "label": "Canvas icon",
        "default": "rbb-icon-human-user-11",                    
        "options": [
          {"value": "rbb-icon-human-user-2", "label": "Account 1"},
          {"value": "rbb-icon-human-user-3", "label": "Account 2"},
          {"value": "rbb-icon-human-user-5", "label": "Account 3"},
          {"value": "rbb-icon-human-user-7", "label": "Account 4"},
          {"value": "rbb-icon-human-user-8", "label": "Account 5"},
          {"value": "rbb-icon-human-user-9", "label": "Account 6"},
          {"value": "rbb-icon-human-user-10", "label": "Account 7"},
          {"value": "rbb-icon-human-user-11", "label": "Account 8"},
          {"value": "rbb-icon-settings-outline5", "label": "Account 9"}
        ]
      },
      {
        "type": "checkbox",
        "id": "account_svg",
        "label": "Canvas icon svg",
        "info": "Icon svg replaces icon font where possible."
      },
      {
        "type": "header",
        "content": "Choose Wishlist Icon"
      },
      {
        "type": "select",
        "id": "wishlist",
        "label": "Wishlist icon",
        "default": "rbb-icon-wishlist-10",
        "options": [
          {"value": "rbb-icon-wishlist-7", "label": "Wishlist 1"},
          {"value": "rbb-icon-wishlist-8", "label": "Wishlist 2"},
          {"value": "rbb-icon-wishlist-9", "label": "Wishlist 3"},
          {"value": "rbb-icon-wishlist-10", "label": "Wishlist 4"},
          {"value": "rbb-icon-wishlist-14", "label": "Wishlist 5"},
          {"value": "rbb-icon-wishlist-16", "label": "Wishlist 6"},
          {"value": "rbb-icon-wishlist-17", "label": "Wishlist 7"},
          {"value": "rbb-icon-rating-start-outline-1", "label": "Wishlist 8"},
          {"value": "rbb-icon-rating-start-outline-2", "label": "Wishlist 9"}
        ]
      },
      {
        "type": "checkbox",
        "id": "wishlist_svg",
        "label": "Wishlist icon svg",
        "info": "Icon svg replaces icon font where possible."
      },
      {
        "type": "header",
        "content": "Choose Cart Icon"
      },
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart icon type",
        "default": "cart",
        "options": [
          {"value": "cart", "label": "Cart"},
          {"value": "bag", "label": "Bag"},
          {"value": "basket", "label": "Basket"}
        ]
      },
      {
        "type": "select",
        "id": "cart",
        "label": "Cart icon",
        "default": "6",
        "options": [
          {"value": "1", "label": "Cart 1"},
          {"value": "2", "label": "Cart 2"},
          {"value": "3", "label": "Cart 3"},
          {"value": "4", "label": "Cart 4"},
          {"value": "5", "label": "Cart 5"},
          {"value": "6", "label": "Cart 6"},
          {"value": "7", "label": "Cart 7"},
          {"value": "8", "label": "Cart 8"},
          {"value": "9", "label": "Cart 9"},
          {"value": "10", "label": "Cart 10"}
        ]
      },
      {
        "type": "checkbox",
        "id": "cart_svg",
        "label": "Cart icon svg",
        "info": "Icon svg replaces icon font where possible."
      },
      {
        "type": "header",
        "content": "Header Menu"
      },
      {
        "type": "link_list",
        "id": "main_linklist",
        "label": "Menu",
        "default": "main-menu"
      },
      {
        "type": "color",
        "id": "color_menu",
        "label": "Color Menu",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_menu_hover",
        "label": "Color Menu Hover",
        "default": "#F43777"
      },
      {
        "type": "color_scheme",
        "id": "color_menu_dropdown",
        "label": "Color menu dropdown",
        "default": "background-1"
      },
      {
        "type": "number",
        "id": "menu_fs",
        "label": "Font size",
        "default": 14
      },
      {
        "type": "select",
