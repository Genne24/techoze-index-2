        "default": 150,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "w_logo_lg",
        "label": "Width logo laptop (px)",
        "default": 150,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "w_logo_md",
        "label": "Width logo tablet (px)",
        "default": 150,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "wm_logo",
        "label": "Width logo mobile (px)",
        "default": 100
      },
      {
        "type": "header",
        "content": "Header Container"
      },
      {
        "type": "select",
        "id": "container",
