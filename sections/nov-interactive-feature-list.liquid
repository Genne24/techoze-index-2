{%- liquid
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position
  if sst.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}
{%- style -%}
  {% render 'nov-section-style' %}
  #shopify-section-{{ section.id }} .ifl-item {
    --color-border: {{ sst.border_color }};
  }
{%- endstyle -%}

<div class="container-outer{{ bg_class_full }} color-{{ sst.color_section }} position-relative">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}">
      {% render 'heading-section', sub_position: sst.subheading_position, class: 'mb-40' %}
      <div class="ifl-wrapper data-act-parent" style="--ifl-img-width: {{ sst.image_width }}px; --ifl-img-ratio: {{ sst.image_ratio }}; --ifl-img-rotation: {{ sst.image_rotation }}deg;--ifl-img-br: {{ sst.image_br }}px">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign bst = block.settings
              assign item_url = bst.item_url
              if item_url == blank
                assign item_url = '#'
              endif
            -%}
  
            <div
              class="ifl-item position-relative d-sm-flex align-items-center justify-content-between pt-30 pb-30 nov_btn_act nov_item_act{% if forloop.first %} act{% endif %}{% unless forloop.last %} bd-b{% endunless %}"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              
              <div class="ifl-item__inner">
                <a
                  href="{{ item_url }}"
                  class="ifl-item__name fs-24 fs-lg-20 fs-md-18 fs-sm-16 font-600 color-title"
                  {% if bst.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                >
                  <span class="ifl-item__title">{{ bst.title | default: block.type }}</span>
                </a>
              </div>

              {%- if bst.image != blank -%}
                <div class="ifl-item__thumb position-absolute center-center" aria-hidden="true">
                  {{
                    bst.image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 600',
                      class: 'ifl-item__img img-fluid'
                  }}
                </div>
              {%- elsif sst.show_placeholder_image -%}
                <div class="ifl-item__thumb ifl-item__thumb--placeholder" aria-hidden="true">
                  {{ 'product-1' | placeholder_svg_tag: 'ifl-item__img placeholder-svg' }}
                </div>
              {%- endif -%}
  
              {%- if sst.show_explore_link -%}
                <a
                  href="{{ item_url }}"
                  class="ifl-item__link fs-12 font-500 link d-inline-flex align-items-center mt-xs-5"
                  aria-label="{{ bst.title }}"
                  {% if bst.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                >
                  <span>{{ sst.explore_text | default: 'Explore More' }}</span>
                  <i class="zmdi zmdi-long-arrow-right"></i>
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
