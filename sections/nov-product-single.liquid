{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif

  assign product = all_products[sst.product_handle]
-%}

{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .proFeaturedImage img,
  #shopify-section-{{ section.id }} .proFeaturedImage span,
  #shopify-section-{{ section.id }} .product-single__thumbnail {
    border-radius: {{ sst.border_radius }}px;
    overflow: hidden;
    transform: translateZ(0);
  }
  #shopify-section-{{ section.id }} {
    --color-stock: {{ sst.stock_color }};
    --color-stock-rgb: {{ sst.stock_color | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }};
  }

{% endstyle %}
<div class="{{ bg_class_full }} position-relative">
  <div class="container">
    <div class="container-inner{{ bg_class_contain }}">
      {% render 'heading-section', sub_position: sst.subheading_position %}
      <div class="section-content position-relative color-{{ sst.color_section }}">
        <div class="row position-relative"> 
          <div class="col-lg-6 mb-md-40">
            <div class="nov-product__single-thumb mb-0">
              <div class="product-single__photos position-relative">
                <div class="proFeaturedImage FeaturedImage_slick row spacing-10 {{ sst.arrow_color }}"{% if sst.enable_zoom %} id="proFeaturedImageZoom"{% endif %} data-draggable="true" data-dots="false" data-nav="{{ sst.show_nav }}" data-items="1" data-items_lg="1" data-items_md="1" data-items_sm="1" data-items_xs="1">
                  {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
                  {%- for media in product.media -%}
                    {%- assign is_active_media = false -%}
                    {%- if featured_media and media.id == featured_media.id -%}
                      {%- assign is_active_media = true -%}
                    {%- elsif featured_media == blank and forloop.first -%}
                      {%- assign is_active_media = true -%}
                    {%- endif -%}
                    {% case media.media_type %}
                      {% when 'image' %}
                          <a href="#" class="item d-lg-flex item_img sp-item{% if is_active_media %} act{% endif %}" data-media-id="{{ section.id }}-{{ media.id }}" data-position="{{ forloop.index0 }}" data-pswp-src="{{ media | image_url: width: 1024 }}" data-pswp-width="{{ media.width }}" data-pswp-height="{{ media.height }}">
                            {% assign image_url = media %}
                            <div class="respone_image w-100{% if sst.enable_zoom %} image-zoom{% endif %}" style="padding-top:{{ 1 | divided_by: image_url.aspect_ratio | times: 100}}%;" data-zoom="{{ media | image_url: width: 1120 }}">
                              <img class="lazyload"
                                src="{{ image_url | image_url: width: 1 }}"
                                data-src="{{ image_url | image_url: width: 180 }}"
                                data-srcset="{{ image_url | image_url: width: 380 }} 380w,{{ image_url | image_url: width: 580 }} 580w,{{ image_url | image_url: width: 768 }} 768w,{{ image_url | image_url: width: 900 }} 900w,{{ image_url | image_url: width: 1080 }} 1080w,{{ image_url | image_url: width: 1296 }} 1296w,{{ image_url | image_url: width: 1512 }} 1512w,{{ image_url | image_url: width: 1728 }} 1728w, {{ image_url | image_url: width: 2048 }} 2048w" data-sizes="auto" width="{{ image_url.width }}" height="{{ image_url.height }}" alt="{{ image_url.alt }}" loading="lazy"/>
                            </div>
                          </a>
                      {% when 'external_video' %}
                        <div class="sp-item item{% if is_active_media %} act{% endif %} embed-responsive embed-responsive-16by9" data-media-id="{{ section.id }}-{{ media.id }}">
                          {{ media | external_video_tag }}
                        </div>
                      {% when 'video' %}
                        <div class="sp-item item{% if is_active_media %} act{% endif %}" data-media-id="{{ section.id }}-{{ media.id }}">
                          {{ media | video_tag: controls: true, image_size: "1024x" }}
                        </div>
                      {% when 'model' %}
                        <div class="sp-item item{% if is_active_media %} act{% endif %}" data-media-id="{{ section.id }}-{{ media.id }}">
                          <product-model class="position-relative h-100 d-block">{%- liquid echo media | media_tag: image_size: "2048x", toggleable: true -%}</product-model>
                        </div>
                      {% else %}
                        <div class="sp-item item{% if is_active_media %} act{% endif %}">
                          {{ media | media_tag }}
                        </div>
                    {% endcase %}
                  {%- else -%}
                    {{ 'product-apparel-1' | placeholder_svg_tag : 'placeholder-svg' }}
                  {%- endfor -%}
                </div>
                {% if product.images.size > 0 and sst.product_thumb %}
                  <div id="productThumbs" class="mt-md-10">
                    <div class="thumblist thumb_slick"
                      data-autoplay="false" 
                      data-autoplaytimeout="6000" 
                      data-loop="{% if product.images.size > sst.xl %}true{% else %}false{% endif %}"
                      data-dots="false"
                      data-nav="false"
                      data-items="{{ sst.xl }}"
                      data-items_lg="{{ sst.lg }}" 
                      data-items_md="{{ sst.md }}" 
                      data-items_sm="{{ sst.sm }}"
                      data-items_xs="{{ sst.xs }}"
                      data-row="1"
                      data-vertical="true"
                      data-vertical_lg="true"
                      data-vertical_md="false"
                      data-vertical_sm="false">
                      {%- for media in product.media -%}
                        {%- assign is_active_thumb = false -%}
                        {%- if featured_media and media.id == featured_media.id -%}
                          {%- assign is_active_thumb = true -%}
                        {%- elsif featured_media == blank and forloop.first -%}
                          {%- assign is_active_thumb = true -%}
                        {%- endif -%}
                        <div class="item col thumbItem {% if is_active_thumb %} active{% endif %}" data-media-id="{{ section.id }}-{{ media.id }}">
                          <a href="#" data-image="{{ media.preview_image | image_url: width: 1440 }}" class="product-single__thumbnail position-relative">
                            {% render 'nov-aspect-image', image: media.preview_image %}
                            {%- if media.media_type == 'video' or media.media_type =='external_video' -%}
                              <div class="product-single__thumbnail-badge video position-absolute">
                                <i class="zmdi zmdi-play-circle-outline"></i>
                              </div>
                            {%- endif -%}
                            {%- if media.media_type == 'model' -%}
                              <div class="product-single__thumbnail-badge model position-absolute center-center">
                                {% render 'icon-3d-model' %}
                              </div>
                            {%- endif -%}
                          </a>
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
          
          <div class="col-lg-6">
            <div class="product-single position-relative" data-wishlist-img="{{ product.media.first.preview_image.src | image_url: width: 100 }}">
              {%- liquid
                assign current_variant = product.selected_or_first_available_variant
                assign variants_available = product.variants | map: 'available'
                assign variants_option_1 = product.variants | map: 'option1'
                assign variants_option_2 = product.variants | map: 'option2'
                assign variants_option_3 = product.variants | map: 'option3'
              -%}
              <div class="nov-product__single-info">
                <div class="info-content">
      
                  <a href="{{ product.url }}" class="product-single__title d-inline-block mb-20 h2 fs-40 fs-xl-36 fs-lg-32 font-700">{{ product.title }}</a>

                  {% if settings.review_enable and sst.show_rate %}
                    <div class="AirReviews-Widget AirReviews-Widget--Stars mb-15" data-review-avg="{{ product.metafields.air_reviews_product.review_avg }}" data-review-count="{{ product.metafields.air_reviews_product.review_count }}"></div>
                  {% endif %}
      
                  <div id="ProductPrice-{{ section.id }}" class="product-single__price fs-40 fs-lg-30 price-st mb-15 d-flex align-items-center">
                    {% if current_variant.compare_at_price > current_variant.price %}
                      <span class="product-price__price product-price__sale product-price__sale--single">
                        <span itemprop="price" content="{{ current_variant.price | divided_by: 100.00 }}" class="money">
                          {{ current_variant.price | money }}
                        </span>
                      </span>
                      <s class="fs-32 fs-lg-24">{{ current_variant.compare_at_price | money }}</s>
                    {% else %}
                      <span class="product-price__price">
                        <span itemprop="price" content="{{ current_variant.price | divided_by: 100.00 }}" class="money">
                          {{ current_variant.price | money }}
                        </span>
                      </span>
                    {% endif %}
                  </div>
      
                  {% if sst.countdown_timeend != blank %}
                    <div class="countdownfree d-flex text-center mb-25 mb-lg-20" data-countdown="{{ sst.countdown_timeend }}" data-show-days="{{ settings.show_day }}" data-restart="{{ settings.restart }}"></div>
                  {% endif %}
                  {% if sst.show_desc_product %}
                    <div class="product-single__desc mb-30 fs-14 fs-lg-12">{{ product.description | strip_html | truncate: 200 }}</div>
                  {% endif %}
      
                  {% if sst.show_product_stock %}
                    <div class="product__stock d-flex align-items-center mb-30">
                      {% assign product = product | default: collection.products.first %}
                      {% assign total_quantity = 0 %}
                      {% for variant in product.variants %}
                        {% assign total_quantity = total_quantity | plus: variant.inventory_quantity %}
                      {% endfor %}
                      <span class="icon-stock r-100 d-flex align-items-center justify-content-center">
                        <i class="zmdi zmdi-check"></i>
                      </span>
                      <span>{{ 'products.general.products_in_stock' | t: quantity: total_quantity }}</span>
                    </div>
                  {% endif %}
      
                  {%- liquid
                    if product.has_only_default_variant
      
                      assign quantity = product.selected_or_first_available_variant.inventory_quantity
      
                    elsif product.variants.size > 1
      
                      assign quantity = 0
                      for variant in product.variants
                        assign quantity = quantity | plus: variant.inventory_quantity
                      endfor
                    endif
                  -%}
      
                  <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="product-form-{{ section.id }}" class="product-form-{{ section.id }}" data-section="{{ section.id }}">
                    {%- liquid
                      assign variants_available = product.variants | map: 'available'
                      assign variants_option_1 = product.variants | map: 'option1'
                      assign variants_option_2 = product.variants | map: 'option2'
                      assign variants_option_3 = product.variants | map: 'option3'
                    -%}
      
                    <input id="variant_id" type="hidden" name="id" value="{{ current_variant.id }}" />
                    {%- unless product.has_only_default_variant -%}
                      <product-variant-swatch class="mb-30 d-block" data-product-id="{{ section.id }}" data-product-url="{{ product.url }}">
                        {%- for option in product.options_with_values -%}
                          {%- liquid
                            assign option_name = option.name | downcase
                            assign option_color_swatch = settings.option_color_swatch | downcase
                            assign option_color = false
                            assign option_index = forloop.index0
                            if option_color_swatch contains option_name
                              assign option_color = true
                            endif
                          -%}
                          <fieldset class="product-variant-form-input{% if option_color %} variant-color{% endif %}{% if forloop.last == false %} mb-15{% endif %}" data-option-index="{{forloop.index0}}">
                            <div class="product-single__control-label mb-5">
                              {{ option.name }}: <span class="variant_current">{{ current_variant.options[option_index] }}</span>
                            </div>
                            <div class="block-content d-flex flex-wrap">
                              {%- for value in option.values -%}
                                {%- liquid
                                  assign option_disabled = true
      
                                  for option1_name in variants_option_1
                                    case option.position
                                      when 1
                                        if variants_option_1[forloop.index0] == value and variants_available[forloop.index0]
                                          assign option_disabled = false
                                        endif
                                      when 2
                                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option_2[forloop.index0] == value and variants_available[forloop.index0]
                                          assign option_disabled = false
                                        endif
                                      when 3
                                        if option1_name == product.selected_or_first_available_variant.option1 and variants_option_2[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option_3[forloop.index0] == value and variants_available[forloop.index0]
                                          assign option_disabled = false
                                        endif
                                    endcase
                                  endfor
      
                                  assign variant_available = false
                                    for variant in product.variants
                                      if variant.options[option_index] == value and variant.available
                                        assign variant_available = true
                                      endif
                                  endfor
                                -%}
                                <div class="product-single__variant-item mb-10">
                                  <input type="radio" id="{{ section.id }}-{{ option.name }}-{{ forloop.index0 }}"
                                    name="{{ option.name }}"
                                    value="{{ value | escape }}"
                                    form="product-form-{{ section.id }}"
                                    {% if option.selected_value == value %}checked{% endif %}
                                    {% if option_disabled %}class="disabled"{% endif %}
                                  >
                                  <label class="variant-color-{{ value | downcase | handle }}{% if settings.color_swatch_style =='variant' %} img{% else %} color{% endif %}{% if variant_available == false %} soldout{% endif %}" for="{{ section.id }}-{{ option.name }}-{{ forloop.index0 }}"{% if option_color and settings.color_swatch_style == 'color' %} style="background-color: {{ value }};"{% endif %}>
                                  {% if option_color and settings.color_swatch_style == 'variant' %}
                                    {%- assign is_first_image = true -%}
                                    {% for variant in product.variants %}
                                      {% if variant.title contains value and is_first_image %}
                                        <img src="{{ variant.image | image_url: width: 160 }}" width="160" height="{{ 160 | divided_by: variant.image.aspect_ratio | round }}" alt="{{ variant.image.alt }}" style="height: auto;">
                                        {%- assign is_first_image = false -%}
                                      {% endif %}
                                    {% endfor %}
                                  {% endif %}
                                    {{ value }}
                                  </label>
                                </div>
                              {%- endfor -%}
                            </div>
                          </fieldset>
                        {%- endfor -%}
                      <script type="application/json">{{ product.variants | json }}</script>
                      </product-variant-swatch>
                    {%- endunless -%}
                    <select id="productSelect" class="hide">
                      {% for variant in product.variants %}
                        {% if variant.available %}
                          <option value="{{ variant.id }}" data-qty="{{ variant.inventory_quantity}}" data-sku="{{ variant.sku }}" data-inventory_policy="{{ variant.inventory_policy }}" data-inventory_management="{{ variant.inventory_management }}"{% if variant == current_variant %} selected="selected"{% endif %}>{{ variant.title }}</option>
                        {% else %}
                          <option value="{{ variant.id }}" data-qty="{{ variant.inventory_quantity}}" data-sku="{{ variant.sku }}" data-inventory_policy="{{ variant.inventory_policy }}" data-inventory_management="{{ variant.inventory_management }}" disabled="disabled">{{ variant.title }} - {{ 'products.product.sold_out' | t }}</option>
                        {% endif %}
                      {% endfor %}
                    </select>
                    <div class="product-single__quantity d-flex align-items-end color-{{ sst.btn_addtocart_wishlist_color }}">
                      {% if sst.quantity %}
                        <div class="quantity {{ sst.btn_addtocart_type_color }}">
                          <div class="quick_view_qty position-relative color-title overflow_hidden">
                            <a href="#" class="quick_view-qty quick_view-qty-minus" aria-label="{{ 'cart.general.reduce_quantity' | t }}"><i class="zmdi zmdi-minus"></i></a>
                            <input type="number" id="Quantity" name="quantity" value="1" min="1" max="{{ current_variant.inventory_quantity }}" step="1" class="quantity-selector product-form__input text-center" aria-label="{{ 'products.product.quantity' | t }}">
                            <a href="#" class="quick_view-qty quick_view-qty-plus" aria-label="{{ 'cart.general.increase_quantity' | t }}"><i class="zmdi zmdi-plus"></i></a>
                          </div>
                        </div>
                      {% endif %}
                      <div class="product-form__item product-form__item--submit {{ sst.btn_addtocart_type_color }} {% unless current_variant.available %} soldout{% endunless %}"{% unless current_variant.available %}data-toggle="modal" data-target="#Form_newletter"{% endunless %}>
                        <button data-handle="{{ product.handle }}" type="submit" name="add" id="AddToCart" class="btnAddToCart btn {{ sst.btn_addtocart_type_color }}{% unless settings.cart_status_addtocart == 'goto_page_cart' %} product-form__cart-submit{% endunless %}">
                          {% if current_variant.available %}
                            {% if current_variant.inventory_policy == 'continue' and current_variant.inventory_quantity < 1 %}
                              <span id="AddToCartText">{{ 'products.product.pre_order' | t }}</span>
                            {% else %}
                              <span id="AddToCartText">{{ 'products.product.add_to_cart' | t }}</span>
                            {% endif %}
                          {% else %}
                              <span id="AddToCartText">{{ 'products.product.notify_me' | t }}</span>
                          {% endif %}
                          <i class="zmdi zmdi-long-arrow-right"></i>
                          <span class="load"></span>
                        </button>
                      </div>
                      {% if sst.show_wishlist %}
                        <div class="product-single__wishlist productWishList {{ sst.btn_wishlist_type_color }}">
                          <a class="wishlist btnProductWishlist d-flex align-items-center justify-content-center pointer" data-icon-wishlist href="#" data-product-handle="{{ product.handle }}" data-id="{{ product.id | json }}">
                            {% render 'icon-star' %}
                          </a>
                        </div>
                      {% endif %}
                    </div>
                    
                    {% if settings.payment_button_enable and sst.product_handle != blank %}
                      <div class="product-form__item product-form__item--checkout mt-10 color-{{ sst.btn_buyitnow_color }} {{ sst.btn_buyitnow_type_color }}"{% if current_variant.available == false %} disabled{% endif %}>
                        {% form 'product', product, novalidate: 'novalidate', data-product-form: '' %}
                        {{ form | payment_button }}
                        {% endform %}
                      </div>
                    {% endif %}
                  </form>
      
                  {% render 'product-single-share-ask' %}
      
                  {% if sst.delivery != blank or sst.shipping != blank %}
                    <div class="product-single__de-sh mt-20 pt-20 color-title fs-md-13">
                      {% if sst.delivery != blank %}
                        <div class="de-sh d-flex align-items-center">
                          <i class="rbb-icon-time-1 fs-16"></i>
                          <span>{{ sst.delivery }}</span>
                        </div>
                      {% endif %}
                      {% if sst.shipping != blank %}
                        <div class="de-sh d-flex align-items-center{% if sst.delivery != blank %} mt-15{% endif %}">
                          <i class="rbb-icon-delivery-11 fs-20"></i>
                          <span>{{ sst.shipping }}</span>
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% if sst.pattern != blank %}
    <div class="pattern-section pattern-1 position-absolute d-none {{ sst.pattern_respon }} {{ sst.pattern_position }} {{ sst.pattern_animate }}" style="--horizontal: {{ sst.pattern_horizontal }}%;--vertical: {{ sst.pattern_vertical }}%;--width: {{ sst.pattern_width }}%;">
      {% render 'nov-aspect-image', image: sst.pattern, class: 'no-ef' %}
    </div>
  {% endif %}
</div>
{% if sst.show_share or sst.show_ask %}
  {% render 'nov-popup-share', product_url: product.url %}
  {% render 'nov-popup-ask' %}
{% endif %}
{{ 'photoswipe.css' | asset_url | stylesheet_tag }}
<script type="module">
  import Lightbox from '{{ 'photoswipe-lightbox.esm.min.js' | asset_url }}';
  const leftArrowSVGString = '<svg aria-hidden="true" class="pswp__icn" viewBox="0 0 11 21"><polyline fill="none" stroke="currentColor"  points="10.5 0.5 0.5 10.5 10.5 20.5" stroke-width="1.25"></polyline></svg>';
  const rightArrowSVGString = '<svg aria-hidden="true" class="pswp__icn" viewBox="0 0 11 21"><polyline fill="none" stroke="currentColor" points="0.5 0.5 10.5 10.5 0.5 20.5" stroke-width="1.25"></polyline></svg>';
  const closeArrowSVGString = '<svg aria-hidden="true" class="pswp__icn" viewBox="0 0 16 14"><path d="M15 0L1 14m14 0L1 0" stroke="currentColor" fill="none" fill-rule="evenodd"></path></svg>'
  const lightbox = new Lightbox({
    gallery: '#proFeaturedImageZoom',
    children: '.item_img',
    bgOpacity: 1,
    showHideAnimationType: 'zoom',
    loop: false,
    counter: false,
    zoom: false,
    bgClickAction: false,
    arrowPrevSVG: leftArrowSVGString,
    arrowNextSVG: rightArrowSVGString,
    closeSVG: closeArrowSVGString,
    pswpModule: () => import('{{ 'photoswipe.esm.min.js' | asset_url }}')
  });
  lightbox.on('uiRegister', function() {
    lightbox.pswp.ui.registerElement({
      name: 'bulletsIndicator',
      className: 'pswp__bullets-navigation',
      appendTo: 'wrapper',
      onInit: (el, pswp) => {
        let prev;
        let close;
        let next;
        prev = document.createElement('div');
        prev.className = 'pswp__bullets-prev';
        close = document.createElement('div');
        close.className = 'pswp__bullets-close';
        next = document.createElement('next');
        next.className = 'pswp__bullets-next';

      }
    });
  });
  lightbox.init();
</script>
{% schema %}
{
  "name": "Vinova Product Single",
  "class": "section-product-single",
  "disabled_on": {
    "groups": ["header", "footer", "custom.system"]
  },
  "settings":[
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Vinova Product Single</p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#222222",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sub heading",
      "default": "<p>Subtitle from happy customers</p>"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Sub heading color",
      "default": "#666666",
      "visible_if": "{{ section.settings.subheading != blank }}"
    },
    {
      "type": "select",
      "id": "subheading_position",
      "label": "Sub heading position",
      "default": "bottom",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "visible_if": "{{ section.settings.subheading != blank }}"
    },
    {
      "type": "richtext",
      "id": "descheading",
      "label": "Description",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
    },
    {
      "type": "color",
      "id": "descheading_color",
      "label": "Description color",
      "default": "#666666",
      "visible_if": "{{ section.settings.descheading != blank }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type":  "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product_handle",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Featured Image"
    },
    {
      "type": "checkbox",
      "id": "show_nav",
      "label": "Show arrow",
      "default": true
    },
    {
      "type": "select",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "arrow_on_light",
      "options": [
        {"value": "arrow_on_light","label": "Dots on light background"},
        {"value": "arrow_on_dark","label": "Dots on dark background"}
      ]
    },
    {
      "type": "header",
      "content": "Product Thumbnail"
    },
    {
      "type": "checkbox",
      "id": "product_thumb",
      "label": "Show product thumbnail",
      "default": true
    },
    {
      "type":  "header",
      "content": "Product Thumb Per Row"
    },
    {
      "type": "range",
      "id": "xl",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Large desktop",
