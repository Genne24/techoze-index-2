{%- liquid
  assign sst = section.settings
  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if sst.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}
{%- style -%}
  {% render 'nov-section-style' %}
  {% if sst.background_gradient != blank %}
    #shopify-section-{{ section.id }} .distance.bg:before {
      background: {{ sst.background_gradient }};
    }
  {% endif %}
{%- endstyle -%}

<div class="custom-section position-relative{{ bg_class_full }}">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}">
      {% if sst.pattern_1 != blank %}
        <div class="pattern-section pattern-1 position-absolute d-none{% if sst.pattern_fullscreen1 %} pattern-fullscreen{% endif %} {{ sst.pattern_respon }} {{ sst.pattern_position1 }} {{ sst.pattern_animate1 }}" style="--horizontal: {{ sst.pattern_horizontal1 }}%;--vertical: {{ sst.pattern_vertical1 }}%;--width: {{ sst.pattern_width1 }}%;">
          {% render 'nov-aspect-image', image: sst.pattern_1, class: 'no-ef' %}
        </div>
      {% endif %}
      {% if sst.pattern_2 != blank %}
        <div class="pattern-section pattern-2 position-absolute d-none {{ sst.pattern_respon }} {{ sst.pattern_position2 }} {{ sst.pattern_animate2 }}" style="--horizontal: {{ sst.pattern_horizontal2 }}%;--vertical: {{ sst.pattern_vertical2 }}%;--width: {{ sst.pattern_width2 }}%;">
          {% render 'nov-aspect-image', image: sst.pattern_2, class: 'no-ef' %}
        </div>
      {% endif %}
      {% if sst.pattern_3 != blank %}
        <div class="pattern-section pattern-3 position-absolute d-none {{ sst.pattern_respon }} {{ sst.pattern_position3 }} {{ sst.pattern_animate3 }}" style="--horizontal: {{ sst.pattern_horizontal3 }}%;--vertical: {{ sst.pattern_vertical3 }}%;--width: {{ sst.pattern_width3 }}%;">
          {% render 'nov-aspect-image', image: sst.pattern_3, class: 'no-ef' %}
        </div>
      {% endif %}
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
