      },
      {

        "type": "header",
        "content": "Pattern Section 1"
      },
      {
        "type": "image_picker",
        "id": "pattern_1",
        "label": "Image"
      },
      {
        "type": "select",
        "id": "pattern_animate1",
        "label": "Animate",
        "default": "pattern-animate-1",
        "options": [
