      {
        "type": "range",
        "id": "pattern_horizontal1",
        "min": -30,
        "max": 60,
        "step": 1,
        "label": "Position horizontal",
        "default": 5,
        "unit": "%",
        "visible_if": "{{ section.settings.pattern_1 != blank }}"
      },
      {
        "type": "range",
        "id": "pattern_vertical1",
        "min": -30,
        "max": 60,
        "step": 1,
        "label": "Position vertical",
        "default": 0,
        "unit": "%",
        "visible_if": "{{ section.settings.pattern_1 != blank }}"
      },
      {
        "type": "range",
        "id": "pattern_width1",
        "min": 1,
        "max": 100,
        "step": 1,
        "label": "Width",
        "unit": "%",
        "default": 20,
        "visible_if": "{{ section.settings.pattern_1 != blank }}"
      },
      {
        "type": "header",
        "content": "Pattern Section 2"
      },
      {
        "type": "image_picker",
        "id": "pattern_2",
        "label": "Image"
      },
      {
        "type": "select",
        "id": "pattern_animate2",
        "label": "Animate",
        "default": "pattern-animate-1",
        "options": [
          { "value": "pattern-animate-1", "label": "Animate 1" },
          { "value": "pattern-animate-2", "label": "Animate 2" },
          { "value": "pattern-animate-none", "label": "None" }
        ],
        "visible_if": "{{ section.settings.pattern_2 != blank }}"
      },
      {
        "type": "select",
        "id": "pattern_position2",
        "label": "Position",
        "default": "left-top",
        "options": [
          { "value": "left-top", "label": "Left top" },
          { "value": "left-center", "label": "Left center" },
          { "value": "left-bottom", "label": "Left bottom" },
          { "value": "right-top", "label": "Right top" },
          { "value": "right-center", "label": "Right center" },
