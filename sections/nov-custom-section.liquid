            "value": "d-xl-block",
            "label": "Large laptop"
          },
          {
            "value": "d-lg-block",
            "label": "Laptop"
          },
          {
            "value": "d-md-block",
            "label": "Tablet"
          },
          {
            "value": "d-sm-block",
            "label": "Large mobile"
          },
          {
            "value": "d-block",
            "label": "All screen"
          }
