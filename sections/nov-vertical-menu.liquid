{%- liquid 
  assign sst                = section.settings
  assign vertical_menu      = sst.vertical_menu
  assign vertical_menu_name = sst.vertical_menu_name
  assign limit              = sst.vertical_menu_limit | default: 7
  assign show_icons_arrow   = sst.show_icons_arrow
  assign color              = sst.vertical_menu_color
  assign seemore_icon       = sst.vertical_menu_seemore_icon

-%}

<div class="system-vertical-menu color-{{ color }}">
  <div class="btn-vertical d-flex align-items-center font-500">
    <div class="icon">
      <span></span>
    </div>
    <div class="label">{{ vertical_menu_name }}</div>
  </div>
  {% render 'vertical-menu', vertical_menu: vertical_menu, limit: limit, show_icons_arrow: show_icons_arrow, seemore_icon: seemore_icon %}
</div>

{% schema %}
  {
    "name": "Vinova Vertical Menu",
    "class": "section-vertical-menu",
    "limit": 1,
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "header",
        "content": "Vertical Menu"
      },
      {
        "type": "text",
        "id": "vertical_menu_name",
        "label": "Vertical menu name",
        "default": "Shop by Categories"
      },
      {
        "type": "link_list",
        "id": "vertical_menu",
        "label": "Vertical menu"
      },
      {
        "type": "range",
        "id": "vertical_menu_limit",
