

<div class="wishlist-page mb-80">
  <div class="container">
    <div class="wishlist-content" data-wishlist-container>
    </div>
    {% for block in section.blocks %}
      {% if block.type == '@app' %}
        {% render block %}
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
  {
    "name": "Vinova Wishlist",
    "blocks": [
      {
        "type": "@app"
      }
    ]
  }
{% endschema %}

