{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}

{% style %}
  {% render 'nov-section-style' %}
{% endstyle %}
<div class="{{ bg_class_full }}" data-section-id="{{ section.id }}" data-section-type="nov-swiper">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }} {{ sst.arrow_color }} position-relative">

      {% render 'heading-section', sub_position: sst.subheading_position %}

      <div class="nov-swiper-carousel swiper grid--view-items{% if sst.enable_custom_style %}{% if sst.product_border_enable %} item-product-show-bd{% endif %}{% if sst.product_bg_enable %} item-product-show-bg{% endif %}{% endif %}"
        data-loop="false"
        data-row="{{ sst.row_number }}"
        data-row_mobile="{{ sst.row_mobile }}"
        data-items_xxl="{{ sst.xxl }}"
        data-items_xl="{{ sst.xl }}"
        data-items_lg="{{ sst.lg }}"
        data-items_md="{{ sst.md }}"
        data-items_sm="{{ sst.sm }}"
        data-items_xs="{{ sst.xs }}"
        data-speed="700"
        data-spacing="{{ sst.spacing }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% assign bst = block.settings %}
            {%- case block.type -%}
              {%- when 'item' -%}
                <div class="swiper-slide item">
                  {% assign product = bst.product %}
                  {% render 'product-grid-item-style-deal', product: product, section_id: section.id, show_countdown: sst.show_countdown, fz_title_product: sst.fz_title_product, fz_price_product: sst.fz_price_product, alignment_product: sst.alignment_product %}
                </div>
              {%- when 'banner' -%}
                <div class="swiper-slide item">
                  {% if bst.banner != blank %}
                    <div class="block-banner d-flex relative">
                      <div class="theme-blocks-item image-block relative {{ bst.img_animation }}" style="--image-radius: {{ bst.image_radius | append: 'px' }};">
                        <div class="image-wrapper position-relative overflow_hidden">
                          {% render 'nov-imgset', image: bst.banner %}
                        </div>
                        <div class="img-blocks-content position-absolute {{ bst.content_position }} {{ bst.content_visibility }}{% if bst.content_visibility == 'content-partial-reveal' %} js-height{% endif %}{% if bst.display_flex %} d-flex align-items-center justify-content-between{% endif %}" style="--horizontal: {{ bst.content_position_horizontal }}%;--vertical: {{ bst.content_position_vertical }}%; width: {{ bst.content_width }}%; --width-xs: {{ bst.content_width_xs }}%; --bg: {{ bst.content_bg }}; --corner: {{ bst.content_corner }}px; --padding: {{ bst.content_padding }}px; --blur: {{ bst.content_blur }}px;{% if bst.content_shadow %} box-shadow: 0 8px 20px rgba(0,0,0,0.08){% endif %}">
                          {%- liquid
                            assign class_text = bst.font_family | append: ' ' | append: bst.font_weight | append: ' fs-' | append: bst.font_size_xxl | append: ' fs-xl-' | append: bst.font_size_xl | append: ' fs-lg-' | append: bst.font_size_lg | append: ' fs-md-' | append: bst.font_size_md | append: ' fs-sm-' | append: bst.font_size_sm | append: ' fs-xs-' | append: bst.font_size_xs
                          -%}
                          <div class="theme-blocks-item blocks-heading text-block {{ class_text }} text-{{ bst.alignment }}{% if bst.responsive_alignment %} text-xl-{{ bst.alignment_xl }} text-lg-{{ bst.alignment_lg }} text-md-{{ bst.alignment_md }} text-sm-{{ bst.alignment_sm }}{% endif %} {{ bst.text_transform }}"
                            style="color: {{ bst.color }};letter-spacing: {{ bst.letter_spacing }}px;{% if bst.line_height != blank and bst.line_height == 1 %}line-height: 1;{% else %}line-height: {{ bst.line_height | append: 'px' }};{% endif %}{% if bst.line_height_mb != blank and bst.line_height_mb == 1 %}--line-height-mb: 1;{% else %}--line-height-mb: {{ bst.line_height | append: 'px' }};{% endif %}--max-width: {{ bst.max_w }}px;--mb-xxl: {{ bst.mb_xxl }}px;--mb-xl: {{ bst.mb_xl }}px;--mb-lg: {{ bst.mb_lg }}px;--mb-md: {{ bst.mb_md }}px;--mb-sm: {{ bst.mb_sm }}px;">
                            {{ bst.title | newline_to_br }}
                          </div>
                          {%- liquid
                            assign class_text_sub = bst.font_family_sub | append: ' ' | append: bst.font_weight_sub | append: ' fs-' | append: bst.font_size_xxl_sub | append: ' fs-xl-' | append: bst.font_size_xl_sub | append: ' fs-lg-' | append: bst.font_size_lg_sub | append: ' fs-md-' | append: bst.font_size_md_sub | append: ' fs-sm-' | append: bst.font_size_sm_sub | append: ' fs-xs-' | append: bst.font_size_xs_sub
                          -%}
                          <div class="theme-blocks-item blocks-heading text-block {{ class_text_sub }} text-{{ bst.alignment_sub }}{% if bst.responsive_alignment_sub %} text-xl-{{ bst.alignment_xl_sub }} text-lg-{{ bst.alignment_lg_sub }} text-md-{{ bst.alignment_md_sub }} text-sm-{{ bst.alignment_sm_sub }}{% endif %} {{ bst.text_transform_sub }}"
                            style="color: {{ bst.color_sub }};letter-spacing: {{ bst.letter_spacing_sub }}px;{% if bst.line_height_sub != blank and bst.line_height_sub == 1 %}line-height: 1;{% else %}line-height: {{ bst.line_height_sub | append: 'px' }};{% endif %}--max-width: {{ bst.max_w_sub }}px;--mb-xxl: {{ bst.mb_xxl_sub }}px;--mb-xl: {{ bst.mb_xl_sub }}px;--mb-lg: {{ bst.mb_lg_sub }}px;--mb-md: {{ bst.mb_md_sub }}px;--mb-sm: {{ bst.mb_sm_sub }}px;">
                            {{ bst.text_sub | newline_to_br }}
                          </div>
                        </div>
                        <div class="theme-blocks-item button-block position-absolute {{ bst.content_position_btn }} {{ bst.content_visibility }}{% if bst.content_visibility == 'content-partial-reveal' %} js-height{% endif %} d-flex align-items-center justify-content-{{ bst.text_alignment }} gap-10 color-{{ bst.color_scheme }} text-{{ bst.text_alignment }} z-2" style="--horizontal: {{ bst.content_position_horizontal_btn }}%;--vertical: {{ bst.content_position_vertical_btn }}%; width: {{ bst.content_width_btn }}%;{% if bst.btn_type == 'link' %}--color-link: {{ bst.link_color }};--color-hover: {{ bst.link_color_hover }}{% endif %}{% if bst.btn_cus_style and bst.btn_type == 'btn' %}--button-normal-height: {{ bst.btn_cus_height }}px;{% endif %}" {{ block.shopify_attributes }}>
                          <a href="{{ bst.link_1 | default: '#' }}" class="{% if bst.btn_type == 'link' %}link d-inline-flex align-items-center fs-{{ bst.link_fs }} {{ bst.link_fw }}{% else %}btn {{ bst.button_size }} btn-primary btn-alternate {% if bst.button_full_width %}{% endif %}{% if bst.btn_cus_style %} fs-{{ bst.btn_cus_fs }} {{ bst.btn_cus_fw }}{% endif %}{% endif %}{% if bst.icon_svg_p == 'before' %} flex-row-reverse{% endif %}">
                            <span>{{ bst.button_label_1 }}</span>
                            {% if bst.show_arrow %}
                              <i class="zmdi zmdi-long-arrow-right"></i>
                            {% endif %}
                            {% if bst.show_arrow == false and bst.icon_svg != blank %}
                              <span class="icon-svg">{{ bst.icon_svg }}</span>
                            {% endif %}
                          </a>
                          <a href="{{ bst.link_2 | default: '#' }}" class="{% if bst.btn_type == 'link' %}link d-inline-flex align-items-center fs-{{ bst.link_fs }} {{ bst.link_fw }}{% else %}btn {{ bst.button_size }} btn-secondary btn-alternate {% if bst.button_full_width %}{% endif %}{% if bst.btn_cus_style %} fs-{{ bst.btn_cus_fs }} {{ bst.btn_cus_fw }}{% endif %}{% endif %}{% if bst.icon_svg_p == 'before' %} flex-row-reverse{% endif %}">
                            <span>{{ bst.button_label_2 }}</span>
                            {% if bst.show_arrow %}
                              <i class="zmdi zmdi-long-arrow-right"></i>
                            {% endif %}
                            {% if bst.show_arrow == false and bst.icon_svg != blank %}
                              <span class="icon-svg">{{ bst.icon_svg }}</span>
                            {% endif %}
                          </a>
                        </div>
                      </div>
                    </div>
                  {% endif %}
                </div>
            {%- endcase -%}
          {% else %}
            {%- for i in (1..4) -%}
              <div class="item {% render 'number-to-col', xxl: sst.xxl, xl: sst.xl, lg: sst.lg, md: sst.md, sm: sst.sm, xs: sst.xs  %}">
                {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                {{ 'product-apparel-' | append: current | placeholder_svg_tag : 'placeholder-svg' }}
              </div>
            {%- endfor -%}
          {% endfor %}
        </div>
        
      </div>

      {%- if sst.show_nav -%}
        <div class="block-nav d-flex justify-content-center mt-40">
          <div class="nav-arrow nav-prev pointer">{% render 'icon-arrow-prev' %}</div>
          <div class="nav-arrow nav-next pointer">{% render 'icon-arrow-next' %}</div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vinova Product Deals",
  "class": "section-product-deals",
  "disabled_on": {
    "groups": ["header", "footer", "custom.system"]
  },
  "settings":[
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Vinova Product Deals</p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#222222",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sub heading",
      "default": "<p>Subtitle from happy customers</p>"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Sub heading color",
      "default": "#666666",
      "visible_if": "{{ section.settings.subheading != blank }}"
    },
    {
      "type": "select",
      "id": "subheading_position",
      "label": "Sub heading position",
      "default": "bottom",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "visible_if": "{{ section.settings.subheading != blank }}"
    },
    {
      "type": "richtext",
      "id": "descheading",
      "label": "Description",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
    },
    {
      "type": "color",
      "id": "descheading_color",
      "label": "Description color",
      "default": "#666666",
      "visible_if": "{{ section.settings.descheading != blank }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type":  "header",
      "content": "Product Item Per Row"
    },
    {
      "type": "range",
      "id": "xxl",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Desktop",
      "default": 3,
      "info": "Breakpoint 1441px"
    },
    {
      "type": "range",
      "id": "xl",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Large laptop",
      "default": 3,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "range",
      "id": "lg",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Laptop",
      "default": 3,
      "info": "Breakpoint 992px"
    },
    {
      "type": "range",
      "id": "md",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Tablet",
      "default": 3,
      "info": "Breakpoint 768px"
    },
    {
      "type": "range",
      "id": "sm",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Large mobile",
      "default": 2,
      "info": "Breakpoint 576px"
    },
    {
      "type": "range",
      "id": "xs",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Mobile",
      "default": 2
    },
    {
      "type": "header",
      "content": "Slider Option"
    },
    {
      "type": "range",
      "id": "row_number",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Number row",
      "default": 1
    },
    {
      "type": "range",
      "id": "row_mobile",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Number row mobile",
      "default": 1
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "px",
      "label": "Spacing",
      "default": 30,
      "info": "Spacing item"
    },
    {
      "type": "header",
      "content": "Arrow"
    },
    {
      "type": "checkbox",
      "id": "show_nav",
      "label": "Show arrow"
    },
    {
      "type": "select",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "arrow_on_light",
      "options": [
        {"value": "arrow_on_light","label": "Arrow on light background"},
        {"value": "arrow_on_dark","label": "Arrow on dark background"}
      ],
      "visible_if": "{{ section.settings.show_nav }}"
    },
    {
      "type": "header",
      "content": "Countdown Style"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown",
      "default": true
    },
    {
      "type": "header",
      "content": "Product Item Custom Style"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom style"
    },
		{
			"type": "checkbox",
			"id": "product_border_enable",
			"label": "Show border",
			"visible_if": "{{ section.settings.enable_custom_style }}"
		},
		{
			"type": "checkbox",
			"id": "product_bg_enable",
			"label": "Show background",
			"visible_if": "{{ section.settings.enable_custom_style }}"
		},
		{
			"type": "color",
			"id": "product_background_color",
			"label": "Background color",
			"default": "#d4d4d4",
			"info": "In case the show background option is enabled",
			"visible_if": "{{ section.settings.enable_custom_style and section.settings.product_bg_enable }}"
		},
    {
      "type": "range",
      "id": "fz_title_product",
      "min": 0,
      "max": 70,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 20,
      "info": "Font size product title"
    },
    {
      "type": "range",
      "id": "fz_price_product",
      "min": 0,
      "max": 70,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 24,
      "info": "Font size product price"
    },
    {
      "type": "text_alignment",
      "id": "alignment_product",
      "label": "Alignment product",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Section Style"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Show animated",
      "default":   true
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container fluid" },
        { "value": "container-full", "label": "Container full width" }
      ]
    },
    {
      "type": "text",
      "id": "class_section",
      "label": "Class"
    },
    {
      "type":  "header",
      "content": "Section Background"
    },
    {
      "type": "checkbox",
      "id": "ss_bg_enable",
      "label": "Enable"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colors",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.ss_bg_enable }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.ss_bg_enable }}"
    },
    {
      "type": "select",
      "id": "background_img_size",
      "label": "Background image size",
      "default": "cover",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "visible_if": "{{ section.settings.ss_bg_enable and section.settings.background_image != blank }}"
    },
    {
      "type": "checkbox",
      "id": "enable_background_img_size_custom",
      "label": "Enable background image size custom",
      "visible_if": "{{ section.settings.ss_bg_enable and section.settings.background_image != blank }}"
    },
    {
      "type": "text",
      "id": "background_img_size_custom",
      "label": "Background image size custom",
      "info": "Replace base background size, unit % or px",
      "visible_if": "{{ section.settings.background_image != blank and section.settings.enable_background_img_size_custom }}"
    },
    {
      "type": "select",
      "id": "background_img_position",
      "label": "Background image position",
      "default": "center center",
      "options": [
        { "value": "top left", "label": "Top left" },
        { "value": "top center", "label": "Top center" },
        { "value": "top right", "label": "Top right" },
        { "value": "center left", "label": "Center left" },
        { "value": "center center", "label": "Center middle" },
        { "value": "center right", "label": "Center right" },
        { "value": "bottom left", "label": "Bottom left" },
        { "value": "bottom center", "label": "Bottom center" },
        { "value": "bottom right", "label": "Bottom right" }
      ],
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "range",
      "id": "background_corner",
      "min": 0,
      "max": 50,
      "step": 1,
      "label": "Corner background",
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.ss_bg_enable }}"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background position",
      "default": "bg-center",
      "options": [
        { "value": "bg-top", "label": "Top" },
        { "value": "bg-center", "label": "Center" },
        { "value": "bg-bottom", "label": "Bottom" }
      ],
      "visible_if": "{{ section.settings.ss_bg_enable }}"
    },
    {
      "type": "select",
      "id": "background_size",
      "label": "Background size",
      "default": "full",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "contain", "label": "Contain"}
      ],
      "visible_if": "{{ section.settings.ss_bg_enable }}"
    },
    {
      "type": "range",
      "id": "background_padding_horizontal",
      "label": "Background size contain padding horizontal",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 1,
      "unit": "%",
      "info": "Breakpoint 1200px ↑",
      "visible_if": "{{ section.settings.ss_bg_enable }}"
    },
    {
      "type": "range",
      "id": "height_background_xxl",
      "min": 10,
      "max": 100,
      "step": 1,
      "label": "Height background",
      "default": 100,
      "unit": "%",
      "info": "Breakpoint 1441px ↑",
      "visible_if": "{{ section.settings.ss_bg_enable }}"
    },
    {
      "type": "range",
      "id": "height_background_xl",
      "min": 10,
      "max": 100,
      "step": 1,
      "label": "Height background",
      "default": 100,
      "unit": "%",
      "info": "Breakpoint 1200px ↑",
      "visible_if": "{{ section.settings.ss_bg_enable }}"
    },
    {
      "type": "range",
      "id": "height_background_lg",
      "min": 10,
      "max": 100,
      "step": 1,
      "label": "Height background",
      "default": 100,
      "unit": "%",
      "info": "Breakpoint 992px ↑",
      "visible_if": "{{ section.settings.ss_bg_enable }}"
    },
    {
      "type": "range",
      "id": "height_background_md",
      "min": 10,
      "max": 100,
      "step": 1,
      "label": "Height background",
      "default": 100,
      "unit": "%",
      "info": "Breakpoint 768px ↑",
      "visible_if": "{{ section.settings.ss_bg_enable }}"
    },
    {
      "type": "range",
      "id": "height_background_sm",
      "min": 10,
      "max": 100,
      "step": 1,
      "label": "Height background",
      "default": 100,
      "unit": "%",
      "info": "Breakpoint 576px ↑",
      "visible_if": "{{ section.settings.ss_bg_enable }}"
    },
    {
      "type": "range",
      "id": "height_background_xs",
      "min": 10,
      "max": 100,
      "step": 1,
      "label": "Height background",
      "default": 100,
      "unit": "%",
      "info": "Breakpoint 575px ↓",
      "visible_if": "{{ section.settings.ss_bg_enable }}"
    },
    {
      "type": "header",
      "content": "Spacing Top (px)"
    },
    {
      "type": "number",
      "id": "distance_top_xl",
      "label": "Large laptop",
      "default": 30,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "distance_top_lg",
      "label": "Laptop",
      "default": 30,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "distance_top_md",
      "label": "Tablet",
      "default": 30,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "distance_top_sm",
      "label": "Mobile",
      "default": 30
    },
    {
      "type": "header",
      "content": "Spacing Bottom (px)"
    },
    {
      "type": "number",
      "id": "distance_bottom_xl",
      "label": "Large laptop",
      "default": 30,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "distance_bottom_lg",
      "label": "Laptop",
      "default": 30,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "distance_bottom_md",
      "label": "Tablet",
      "default": 30,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "distance_bottom_sm",
      "label": "Mobile",
      "default": 30
    }
  ],
  "blocks": [
