{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}

{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .block-marquee-item {
    animation-duration: {{ sst.time }}s;
    --spacing: {{ sst.spacing | divided_by: 10.0 }}rem;
    --spacing-sm: {{ sst.spacing_sm | divided_by: 10.0 }}rem;
  }
  {% if sst.item_style %}
    #shopify-section-{{ section.id }} .theme-blocks-item {
      background-color: {{ sst.item_bg }};
      border-radius: {{ sst.item_corner }}px;
      padding: {{ sst.item_padding_vertical }}px {{ sst.item_padding_horizontal }}px;
      overflow: hidden;
      transform: translateZ(0);
      {% if sst.show_shadow %}
        box-shadow: 0 5px 10px rgba(0,0,0,0.03);
      {% endif %}
    }
  {% endif %}
  {% if sst.show_shadow %}
    #shopify-section-{{ section.id }} .nov-marquee {
      margin-block: -20px;
      padding-block: 20px;
    }
  {% endif %}
  {% if sst.enable_marquee_width %}
    #shopify-section-{{ section.id }} .nov-marquee {
      max-width: {{ sst.marquee_width }}px;
      margin-inline: auto;
    }
  {% endif %}
  {% if sst.item_width == 'custom' %}
    #shopify-section-{{ section.id }} .theme-blocks-item {
      width: {{ sst.xs }}vw !important;
    }
    @media(min-width:  576px) {
      #shopify-section-{{ section.id }} .theme-blocks-item {
        width: {{ sst.sm }}vw !important;
      }
    }
    @media(min-width:  768px) {
      #shopify-section-{{ section.id }} .theme-blocks-item {
        width: {{ sst.md }}vw !important;
      }
    }
    @media(min-width:  992px) {
      #shopify-section-{{ section.id }} .theme-blocks-item {
        width: {{ sst.lg }}vw !important;
      }
    }
    @media(min-width:  1200px) {
      #shopify-section-{{ section.id }} .theme-blocks-item {
        width: {{ sst.xl }}vw !important;
      }
    }
    @media(min-width:  1441px) {
      #shopify-section-{{ section.id }} .theme-blocks-item {
        width: {{ sst.xxl }}vw !important;
      }
    }
  {% endif %}
  {% if sst.show_overlay %}
    #shopify-section-{{ section.id }} .nov-marquee {
      --background-overlay: {{ sst.overlay_color }};
    }
  {% endif %}
{% endstyle %}
<div class="color-{{ sst.color_section }}{{ bg_class_full }}">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}">
      {% render 'heading-section', sub_position: sst.subheading_position %}
      <div class="nov-marquee overflow_hidden d-flex{% if sst.show_overlay %} show-overlay{% endif %}{% if sst.show_dot %} show-dots{% endif %}{% if sst.marquee_reverse %} marquee-reverse{% endif %}">
        <div class="block-marquee-item d-flex">
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </div>
</div>

