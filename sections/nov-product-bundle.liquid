{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
  if sst.product_list != blank
    assign bundle_products = sst.product_list
  elsif sst.collection != blank
    assign bundle_products = collections[sst.collection].products
  endif
  assign product_limit = sst.limit
-%}

{% style %}
  {% render 'nov-section-style' %}
  {% if sst.enable_custom_style %}
	  #shopify-section-{{ section.id }} {
	    {% if sst.enable_custom_style %}
      --product-color-border: {{ sst.product_border_color }};
      {% endif %}
			{% if sst.product_bg_enable %}
				--product-color-background: {{ sst.product_background_color }};
			{% endif %}
	  }
	{% endif %}
{% endstyle %}


<div class="{{ bg_class_full }}" data-section-id="{{ section.id }}" style="--bg-w: {{ sst.background_width | append: 'px' }}">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }} position-relative{% if sst.background_size == 'custom' %} bg-custom overflow-initial{% endif %}" style="{% if sst.enable_custom_style %}{% if sst.product_border_enable %} item-product-show-bd{% endif %}{% if sst.product_bg_enable %} item-product-show-bg{% endif %}{% endif %}">
      {% render 'heading-section', sub_position: sst.subheading_position, color_strong: sst.color_strong %}
      <div class="position-relative section-product-bundle" 
        data-section-id="{{ section.id }}" 
        data-section-type="nov-product-bundle"
        data-min-items="{{ sst.min_items }}"
        data-max-items="{{ sst.max_items }}"
        data-prevent-duplicate="{{ sst.prevent_duplicate }}"
        data-allow-qty="{{ sst.allow_qty_change }}"
        data-qty-increment="{{ sst.qty_increment | default: 1 }}"
        data-qty-min="{{ sst.qty_min | default: 1 }}">
        <div class="row">
          <div class="col-xl-9 col-lg-8 col-12 nov-bundle-left">
            <div class="row spacing-{{ sst.spacing }} spacing-sm-15 nov-bundle-grid sticky">
              {% if bundle_products != blank %}
                {% assign grid_num = sst.grid_number | default: 3 %}
                {% for product in bundle_products limit: product_limit %}
                  <div class="sp-item item {% if sst.grid_number == 1 %}col-12{% elsif sst.grid_number == 2 %}col-md-6 col-{{ sst.grid_mobile }}{% elsif sst.grid_number == 3 %}col-xl-4 col-lg-6 col-md-4 col-{{ sst.grid_mobile }}{% elsif sst.grid_number == 4 %}col-xl-3 col-lg-6 col-md-4 col-{{ sst.grid_mobile }}{% elsif sst.grid_number == 5 %}col-lg-20 col-md-4 col-{{ sst.grid_mobile }}{% elsif sst.grid_number == 6 %}col-lg-2 col-md-4 col-{{ sst.grid_mobile }}{% else %}col-lg-4 col-md-6 col-{{ sst.grid_mobile }}{% endif %}{% if forloop.rindex > grid_num %} mb-{{ sst.spacing }}{% endif %} mb-lg-{{ sst.spacing }}">
                    {% render 'product-grid-item-style-bundle', product: product, section_id: section.id %}
                  </div>
                {% endfor %}
              {% else %}
                {% assign limit_num = sst.limit %}
                {% assign grid_num = sst.grid_number | default: 3 %}
                {% for i in (1..limit_num) %}
                  <div class="sp-item item col-lg-4 col-md-6 col-12{% if forloop.rindex > grid_num %} mb-{{ sst.spacing }} mb-sm-15{% endif %}">
                    <div class="item-product">
                      <div class="inner-top">
                        <div class="product-top thumbnail-container">
                          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                        <div class="product__info">
                          <div class="product__title"><a href="#">Example Product Title</a></div>
                          <div class="product__price price-box price-st">$99.00</div>
                          <div class="nov-add-bundle-wrap">
                            <button class="btn btn-add-to-bundle btn-alternate" type="button">
                              <span>Add to bundle</span>
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>

          <div class="col-xl-3 col-lg-4 col-12 nov-bundle-right {{ sst.color_box_bundle | prepend: 'color-' }}">
            <div class="nov-bundle-box sticky">
              <div class="nov-bundle-header">
                <div class="bundle-title title d-flex align-items-center justify-content-between">
                  {{ sst.heading_discount }}
                  {% render 'icon-arrow-up' %}
                </div>
                <div class="bundle-subtitle sub_title">{{ sst.subheading_discount }}</div>
                <div class="bundle-progress-bar">
                  <div class="bundle-progress-fill" style="width: 0%;"></div>
                </div>
              </div>

              <div class="nov-bundle-items" data-max="{{ sst.max_items }}">
                {% assign max_num = sst.max_items %}
                {% for i in (1..max_num) %}
                  <div class="nov-bundle-item item-placeholder" data-slot="{{ i }}">
                    <div class="placeholder-thumb"></div>
                    <div class="placeholder-details">
                      <div class="placeholder-line line-title"></div>
                      <div class="placeholder-line line-sub"></div>
                    </div>
                  </div>
                {% endfor %}
              </div>

              <div class="nov-bundle-footer">
                <div class="bundle-total-row d-none d-lg-flex align-items-center justify-content-between">
                  <span class="total-label">{{ 'cart.general.total' | t }}:</span>
                  <span class="total-price">{{ 0 | money }}</span>
                </div>
                <button class="btn btn-medium btn-bundle-add-to-cart btn-alternate w-100 disabled" type="button" disabled="disabled">
                  <span class="total-price d-block d-lg-none">{{ 0 | money }}</span>
                  <span class="btn-text">{{ 'products.product.add_to_cart' | t }}</span>
                  <span class="load"></span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  var bundle = {
    icon_close: `{% render 'icon-close' %}`
  }
</script>

