{% assign sst = section.settings %}
{% assign limit = sst.limit %}
{% assign xxl = sst.grid_number_xxl %}
{% assign xl = sst.grid_number %}
{% assign lg = sst.grid_number_lg %}
{% assign md = sst.grid_number_md %}
{% assign sm = sst.grid_number_sm %}
{% assign xs = sst.grid_number_xs %}
<style>
  {% render 'nov-section-style' %}
  {% if sst.show_border %}
    #shopify-section-{{ section.id }} .show-border-top {
      border-color: {{ sst.border_color }};
    }
  {% endif %}
</style>

<div class="distance{% if sst.show_border %} bd-t{% endif %}" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    {% render 'heading-section' %}
    
    <div id="RecentlyViewedProductsSectionAjax">
      <div class="recently-viewed-grid-ajax grid--view-items recently-viewed-slider slider-shadow row spacing-30 spacing-sm-15" data-row="1" data-limit="{{ limit }}" data-xxl="{{ xxl }}" data-xl="{{ xl }}" data-lg="{{ lg }}" data-md="{{ md }}" data-sm="{{ sm }}" data-xs="{{ xs }}"></div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const reviewEnable = {{ settings.review_enable | json }};
    const STORAGE_KEY = 'shopify_recently_viewed_handles'; 
    const gridContainer = document.querySelector('.recently-viewed-grid-ajax'); 
    const containerSection = document.getElementById('RecentlyViewedProductsSectionAjax');

    let viewedHandles = [];
    try {
      const storedData = localStorage.getItem(STORAGE_KEY);
      if (storedData) {
        viewedHandles = JSON.parse(storedData);
      }
    } catch (e) {
      console.error("Error reading localStorage:", e);
      return;
    }

    const currentProductHandle = {{ product.handle | default: '' | json }};
    viewedHandles = viewedHandles.filter(handle => handle !== currentProductHandle);

    if (viewedHandles.length === 0) {
      return;
    }

    let productLoadedCount = 0;
    const fetchPromises = viewedHandles.map(productHandle => {
      return fetch(`${window.location.origin}/products/${productHandle}?view=card`).then(response => {
        if (!response.ok) {
          throw new Error(`HTTP Error: ${response.status} for handle ${productHandle}`);
        }
        return response.text(); 
      }).then(html => {
        return html; 
      }).catch(error => {
        console.error(`Error fetching HTML for handle ${productHandle}:`, error);
        return null;
      });
    });
    Promise.all(fetchPromises).then(results => {
      let productLoadedCount = 0;
      results.forEach(html => {
        if (html && html.trim().length > 0) {
          gridContainer.insertAdjacentHTML('beforeend', html);
          productLoadedCount++;
        }
      });

      if (productLoadedCount > 0) {
        containerSection.style.display = 'block';
        $(gridContainer).slick({
          infinite: false,
          slidesToShow: {{ xxl | default: 4 }},
          slidesToScroll: 1,
          dots: false,
          arrows: false,
          responsive: [
            {
              breakpoint: 1441,
              settings: {
                slidesToShow: {{ xl | default: 4 }},
                slidesToScroll: 1,
              }
            },
            {
              breakpoint: 1200,
              settings: {
                slidesToShow: {{ lg | default: 4 }},
                slidesToScroll: 1
              }
            },
            {
              breakpoint: 992,
              settings: {
                slidesToShow: {{ md | default: 3 }},
                slidesToScroll: 1
              }
            },
            {
              breakpoint: 768,
              settings: {
                slidesToShow: {{ sm | default: 2 }},
                slidesToScroll: 1
              }
            },
            {
              breakpoint: 576,
              settings: {
                slidesToShow: {{ xs | default: 2 }},
                slidesToScroll: 1
              }
            }
          ]
        });
      }
      if (reviewEnable == true) {
        if (typeof window.avadaAirReviewRerender === 'function' && $('.AirReviews-Widget').length > 0) {
          window.avadaAirReviewRerender();
        }
      }
    });

    $(document).on('mouseenter', '.btn-alternate', function() {
      this.classList.remove('is-leave');
      this.classList.add('is-hover');
    }).on('mouseleave', '.btn-alternate', function() {
      this.classList.remove('is-hover');
      this.classList.add('is-leave');
    });
  });
</script>
