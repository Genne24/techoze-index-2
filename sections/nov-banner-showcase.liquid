{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}

{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .nov-banner-showcase {
    --card-radius: {{ sst.card_radius }}px;
    --card-bg: {{ sst.card_bg }};
    --ticker-bg: {{ sst.ticker_bg }};
    --ticker-color: {{ sst.ticker_color }};
    --ticker-speed: {{ sst.ticker_speed }}s;
    --top-title-stroke: {{ sst.top_title_stroke }};
  }
{% endstyle %}

<div class="container-outer{{ bg_class_full }}">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}">
      {% render 'heading-section', sub_position: sst.subheading_position %}
      <div class="nov-banner-showcase position-relative" data-section-id="{{ section.id }}">
        
        {% if sst.top_title != blank %}
          <div class="showcase-top-title-wrapper text-center">
            <div class="showcase-top-title">
              <span data-text="{{ sst.top_title | escape }}">{{ sst.top_title }}</span>
            </div>
          </div>
        {% endif %}

        <div class="showcase-card position-relative overflow_hidden">
          
          <div class="showcase-card__image-wrapper nov-sh-image-2">
            {% if sst.image != blank %}
              {% render 'nov-imgset', image: sst.image %}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg showcase-card__placeholder' }}
            {% endif %}
            {% if sst.link != blank %}
              <a href="{{ sst.link }}" class="showcase-card__link position-absolute t-0 l-0 w-100 h-100" aria-label="{{ sst.top_title | escape }}"></a>
            {% endif %}
          </div>

          {% if sst.ticker_text != blank or section.blocks.size > 0 %}
            <div class="showcase-ticker relative w-100 overflow_hidden">
              <div class="showcase-ticker__track d-flex align-items-center">
                <div class="showcase-ticker__content d-flex align-items-center">
                  {% if section.blocks.size > 0 %}
                    {% for block in section.blocks %}
                      <span class="showcase-ticker__item d-inline-flex align-items-center">
                        {{ block.settings.text }}
                        <span class="showcase-ticker__dot">•</span>
                      </span>
                    {% endfor %}
                  {% else %}
                    <span class="showcase-ticker__item d-inline-flex align-items-center">
                      {{ sst.ticker_text }}
                    </span>
                  {% endif %}
                </div>
                <div class="showcase-ticker__content d-flex align-items-center" aria-hidden="true">
                  {% if section.blocks.size > 0 %}
                    {% for block in section.blocks %}
                      <span class="showcase-ticker__item d-inline-flex align-items-center">
                        {{ block.settings.text }}
                        <span class="showcase-ticker__dot">•</span>
                      </span>
                    {% endfor %}
                  {% else %}
                    <span class="showcase-ticker__item d-inline-flex align-items-center">
                      {{ sst.ticker_text }}
                    </span>
                  {% endif %}
                </div>
                <div class="showcase-ticker__content d-flex align-items-center" aria-hidden="true">
                  {% if section.blocks.size > 0 %}
                    {% for block in section.blocks %}
                      <span class="showcase-ticker__item d-inline-flex align-items-center">
                        {{ block.settings.text }}
                        <span class="showcase-ticker__dot">•</span>
                      </span>
                    {% endfor %}
                  {% else %}
                    <span class="showcase-ticker__item d-inline-flex align-items-center">
                      {{ sst.ticker_text }}
                    </span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}

        </div>

      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function initBannerShowcase() {
      var elems = document.querySelectorAll('.nov-banner-showcase');
      if (!elems.length) return;
      
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in-view');
          }
        });
      }, { threshold: 0.15 });

      elems.forEach(function(el) {
        observer.observe(el);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBannerShowcase);
    } else {
      initBannerShowcase();
    }
    document.addEventListener('shopify:section:load', initBannerShowcase);
  })();
</script>

{% schema %}
  {
    "name": "Vinova Banner Showcase",
    "class": "section-banner-showcase",
    "disabled_on": {
      "groups": ["header", "footer", "custom.system"]
    },
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#222222",
        "visible_if": "{{ section.settings.heading != blank }}"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Sub heading"
      },
      {
        "type": "color",
        "id": "subheading_color",
        "label": "Sub heading color",
        "default": "#666666",
        "visible_if": "{{ section.settings.subheading != blank }}"
      },
      {
        "type": "select",
        "id": "subheading_position",
        "label": "Sub heading position",
        "default": "bottom",
        "options": [
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" }
        ],
        "visible_if": "{{ section.settings.subheading != blank }}"
      },
      {
        "type": "header",
        "content": "Top Title Settings"
      },
      {
        "type": "text",
        "id": "top_title",
        "label": "Top title text",
        "default": "STRONGER & FASTER"
      },
      {
        "type": "color",
        "id": "top_title_stroke",
        "label": "Outline stroke color",
        "default": "rgba(255, 255, 255, 0.35)"
      },
      {
        "type": "header",
        "content": "Showcase Card Settings"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image Desktop"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 50,
        "step": 2,
        "unit": "px",
        "label": "Card corner radius",
        "default": 24
      },
      {
        "type": "color",
        "id": "card_bg",
        "label": "Card background",
        "default": "#111222"
      },
      {
        "type": "header",
        "content": "Ticker Scrolling Settings"
      },
      {
        "type": "text",
        "id": "ticker_text",
