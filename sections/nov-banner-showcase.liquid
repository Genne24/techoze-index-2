      },
      {
        "type": "range",
        "id": "ticker_speed",
        "min": 5,
        "max": 60,
        "step": 1,
        "unit": "s",
        "label": "Ticker speed",
        "default": 25
      },
      {
        "type": "header",
        "content": "Section Layout & Container"
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          { "value": "container", "label": "Container" },
          { "value": "container-fluid", "label": "Container fluid" },
          { "value": "container-full", "label": "Container full width" }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_section",
        "label": "Color scheme",
        "default": "background-1"
      },
      {
        "type": "text",
        "id": "class_section",
        "label": "Class name"
      },
      {
        "type": "header",
        "content": "Section Background"
      },
      {
        "type": "checkbox",
        "id": "ss_bg_enable",
        "label": "Enable background"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "default": "#ffffff",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "select",
        "id": "background_position",
        "label": "Background position",
        "default": "bg-center",
        "options": [
          { "value": "bg-top", "label": "Top" },
          { "value": "bg-center", "label": "Center" },
          { "value": "bg-bottom", "label": "Bottom" }
        ],
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "select",
        "id": "background_size",
        "label": "Background size",
        "default": "full",
        "options": [
          { "value": "full", "label": "Full width" },
          { "value": "contain", "label": "Container width" }
        ],
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "select",
        "id": "background_img_size",
        "label": "Image scale size",
        "default": "cover",
        "options": [
          { "value": "auto", "label": "Auto" },
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" }
        ],
