      },
      {
        "type": "checkbox",
        "id": "enable_background_img_size_custom",
        "label": "Enable custom background size",
        "default": false,
        "visible_if": "{{ section.settings.ss_bg_enable and section.settings.background_image != blank }}"
      },
      {
        "type": "text",
        "id": "background_img_size_custom",
        "label": "Custom background size",
        "default": "100% 100%",
        "visible_if": "{{ section.settings.ss_bg_enable and section.settings.background_image != blank and section.settings.enable_background_img_size_custom }}"
      },
      {
        "type": "range",
