        "default": "Intel Core Ultra 9 275HX Turbo Speed 5.4GHz  •  NVIDIA GeForce RTX 5070 Ti 12GB GDDR7  •  Ram 32GB CSODIMM DDR5-6400  •  1TB SSD M.2 2242 PCIe 4.0x4  •"
      },
      {
        "type": "color",
        "id": "ticker_color",
        "label": "Ticker text color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "ticker_bg",
        "alpha": true,
        "label": "Ticker background",
