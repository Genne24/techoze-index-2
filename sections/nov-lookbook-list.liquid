{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}

{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .item-content {
    border-radius: {{ sst.corner }}px;
    overflow: hidden;
    transform: translateZ(0);
  }
  #shopify-section-{{ section.id }} .row {
    margin: -{{ sst.gap | times: 0.5 }}px;
  }
  #shopify-section-{{ section.id }} .sp-item {
    padding: {{ sst.gap | times: 0.5 }}px;
  }
  @media(max-width: 991px) {
    #shopify-section-{{ section.id }} .row {
      margin: -{{ sst.gap_md | times: 0.5 }}px;
    }
    #shopify-section-{{ section.id }} .sp-item {
      padding: {{ sst.gap_md | times: 0.5 }}px;
    }
  }
{% endstyle %}

<div class="container-outer{{ bg_class_full }}">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}">
      {% render 'heading-section', sub_position: sst.subheading_position %}
      <div class="row">
        {% for block in section.blocks %}
          <div class="sp-item {% render 'number-to-col', xxl: sst.xxl, xl: sst.xl, lg: sst.lg, md: sst.md, sm: sst.sm, xs: sst.xs  %}">
            <div class="item-content position-relative data-act-parent">
              {% if block.settings.lookbook_image != blank %}
                {% render 'nov-aspect-image', image: block.settings.lookbook_image %}
              {% else %}
                {%- capture current -%}{% cycle 1, 2, 3 %}{%- endcapture -%}
                {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
              {% for i in (1..4) %}
                {% assign pin_product_id = 'pin_product_' | append: i %}
                {% assign pin_position_top_id = 'pin_position_top_' | append: i %}
                {% assign pin_position_left_id = 'pin_position_left_' | append: i %}
                {% assign product = all_products[block.settings[pin_product_id]] %}
                {% if product != blank %}
                  <div class="number nov_btn_act position-absolute d-flex align-items-center justify-content-center r-100 pointer{% if forloop.first %} act{% endif %}" data-toggle="{{ section.id }}{{ block.id }}{{ forloop.index }}" style="top: {{ block.settings[pin_position_top_id] }}%; inset-inline-start: {{ block.settings[pin_position_left_id] }}%">
                    <span></span>
                  </div>
                {% endif %}
              {% endfor %}
              <div class="block-product list--view-items position-absolute bottom-center b-2 w-100">
                {% for i in (1..4) %}
                  {% assign pin_product_id = 'pin_product_' | append: i %}
                  {% assign product = all_products[block.settings[pin_product_id]] %}
                  {% if product != blank %}
                    <div class="item-product d-flex align-items-center nov_item_act{% if forloop.first %} act{% endif %}" data-act="{{ section.id }}{{ block.id }}{{ forloop.index }}">
                      <div class="thumbnail-container">
                        <a href="{{ product.url }}">
                          {% assign img_url = product.featured_image %}
                        <img src="{{ img_url | image_url: width: 1 }}" data-src="{{ img_url | image_url: width: 500 }}" class="product__thumbnail lazyload img-fluid" alt="{{ img_url.alt | default: 'image' }}" width="500" height="500" loading="lazy">
                        </a>
                      </div>
                      <div class="product__info">
                        <div class="product__title line-clamp-1"><a href="{{ product.url }}">{{ product.title }}</a></div>
                        {% if settings.review_enable %}
                          <div class="AirReviews-Widget AirReviews-Widget--Stars" data-review-avg="{{ product.metafields.air_reviews_product.review_avg }}" data-review-count="{{ product.metafields.air_reviews_product.review_count }}"></div>
                        {% endif %}
                        <div class="price-box mt-10">
                          {% if product.compare_at_price_min > product.price_min %}
                            <div class="price-sale d-flex flex-wrap align-items-center">
                              <span class="special-price fs-14" data-price-grid>{{ product.variants[0].price | money }}</span>
                              <span class="old-price fs-12" data-compare-price-grid>{{ product.variants[0].compare_at_price | money }}</span>
                            </div>
                          {% else %}
                            <div class="price-regular fs-14">
                              <span data-price-grid>{{ product.variants[0].price | money }}</span>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      {% for block in section.blocks %}
        {% if block.type == '@app' %}
          {% render block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

