          {"value": "rbb-icon-wishlist-7", "label": "Wishlist 1"},
          {"value": "rbb-icon-wishlist-8", "label": "Wishlist 2"},
          {"value": "rbb-icon-wishlist-9", "label": "Wishlist 3"},
          {"value": "rbb-icon-wishlist-10", "label": "Wishlist 4"},
          {"value": "rbb-icon-wishlist-14", "label": "Wishlist 5"},
          {"value": "rbb-icon-wishlist-16", "label": "Wishlist 6"},
          {"value": "rbb-icon-wishlist-17", "label": "Wishlist 7"},
          {"value": "rbb-icon-rating-start-outline-1", "label": "Wishlist 8"},
          {"value": "rbb-icon-rating-start-outline-2", "label": "Wishlist 9"}
