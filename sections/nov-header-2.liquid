{{ 'css-header2.css' | asset_url | stylesheet_tag }}
{% assign sst = section.settings %}
{% style -%}
  .site-header__logo {
    @media(min-width: 768px) {
      width: {{ sst.w_logo_md | append: 'px' }};
    }
    @media(min-width: 992px) {
      width: {{ sst.w_logo_lg | append: 'px' }};
    }
    @media(min-width: 1200px) {
      width: {{ sst.w_logo | append: 'px' }};
    }
  }
  .site-header, #header-sticky {
    --menu-fs: {{ sst.menu_fs | times: 0.1 }}rem;
    --menu-fw: {{ sst.menu_fw }};
    --menu-ff: {{ sst.menu_ff }};
  }
  .header-content {
    {% if request.page_type == 'index' %}
      background: {{ sst.abs_bg }};
    {% else %}
      background: var(--color-background);
    {% endif %}
  }
  #header-sticky, .header-mobile .header-mobile-content , .header-content {
    background: {{ sst.header_bg }};
  }
{%- endstyle %}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if sst.logo %}
      "logo": {{ sst.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>
<header class="site-header{% if sst.stickymenu %} sticky-header{% endif %}">
  <div class="header-content header-search__parent d-none d-md-block{% if template.name == "index" %} color-{{ sst.abs_color }}{% else %} color-{{ sst.header_color_inner }}{% endif %}">
    <div class="{{ sst.container }}">
      <div class="row align-items-center justify-content-between">
        <div class="col-auto d-flex align-items-center">
          <div class="site-nav--btn d-flex d-xl-none align-items-center justify-content-center">
            <span class="icon"><span></span></span>
          </div>
          <div class="contentsticky_logo">
            {% if sst.logo %}
              <a href="{{ routes.root_url }}" class="site-header__logo position-relative">
                {%- assign image_size_2x = sst.w_logo | times: 2 | at_most: 5760 -%}
                <img srcset="{{ sst.logo | image_url: width: sst.w_logo }} 1x, {{ sst.logo | image_url: width: image_size_2x }} 2x"
                  src="{{ sst.logo | image_url: width: sst.w_logo | append: 'x' }}"
                  class="w-100 img-fluid"
                  alt="{{ sst.logo.alt | default: shop.name | escape }}"
                  width="{{ sst.logo.width }}"
                  height="{{ sst.logo.height }}"
                  fetchpriority="high"
                >
              </a>
            {% else %}
              <div class="h4 site-header__logo d-inline-block mb-0"><a class="site-header__logo-link" href="{{ routes.root_url }}" itemprop="url">{{ shop.name }}</a></div>
            {% endif %}
          </div>
        </div>
        <div class="col-auto d-flex align-items-center justify-content-end header-right-wrapper">
          <div class="btn-vertical btn-vertical-desktop">
            <span class="icon"><span></span></span>
          </div>
          <div class="header-pill-wrapper d-flex align-items-center">
            <div class="contentsticky_menu d-none d-xl-block" style="--color-menu: {{ sst.color_menu }};--color-menu-hover: {{ sst.color_menu_hover }};">
              <nav id="AccessibleNav" class="text-center h-100">{% render 'site-nav' color: sst.color_menu_dropdown, mainmenu: sst.main_linklist %}</nav>
            </div>
            <div class="header-group-item d-flex align-items-center">
              {% if settings.search_enable %}
              <div class="contentsticky_search">
                <div class="search__btn-overlay header-icon align-items-center nov_btn_act" data-toggle="search_canvas" data-overlay="true">
                  {% render 'icon-search' %}
                </div>
              </div>
              {% endif %}
              {% if shop.customer_accounts_enabled %}
                <div class="contentsticky_account pointer">
                  <div class="header-icon nov_btn_act" data-toggle="header_settings" data-overlay="true" title="{{ 'layout.customer.account' | t }}">
                    {% if sst.account_svg %}
                      {% render 'icon-account' %}
                    {% else %}
                      <i class="{{ sst.account_icon }}{% if sst.account_icon_bold %} font-700{% endif %} position-relative"></i>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
              {% if settings.wishlist_enable %}
                <div class="contentsticky_wishlist header--wishlist">
                  <a href="{{ settings.link_page_wishlist }}" class="header-icon align-items-center" rel="nofollow" title="{{ 'layout.customer.wishlists' | t }}">
                    <span class="header-wishlist-icon position-relative d-inline-flex">
                      {% if sst.wishlist_svg %}
                        {% render 'icon-star' %}
                      {% else %}
                        <i class="{{ sst.wishlist }}{% if sst.wishlist_icon_bold %} font-700{% endif %} position-relative"></i>
                      {% endif %}
                      <span class="WishlistCount text-center">0</span>
                    </span>
                  </a>
                </div>
              {% endif %}
              {% if settings.cart_enable %}
                <div class="contentsticky_cart">
                  <div id="cart_block">
                    <div class="header-cart d-flex justify-content-center">
                      <div class="site-header__cart header-icon align-items-center pointer">
                        <div class="site-header__cart-icon position-relative" title="{{ 'layout.cart.title_cart' | t }}">
                          {% if sst.cart_svg %}
                            {% render 'icon-cart' %}
                          {% else %}
                            <i class="rbb-icon-shopping-{{ sst.cart_type }}-{{ sst.cart }}{% if sst.cart_icon_bold %} font-700{% endif %} position-relative"></i>
                          {% endif %}
                          <span class="site-header__cart-count">
                            <span class="CartCount">{{ cart.item_count }}</span>
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              {% endif %}
              {% for block in section.blocks %}
                {% if block.type == '@app' %}
                  {% render block %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="header-mobile d-md-none color-{{ sst.header_bottom_color }}{% if sst.stickymenu_sm %} sticky-header-mobile{% endif %}">
    <div class="header-mobile-content">
      <div class="row align-items-center h-100 spacing-10">
        <div class="col-3 d-flex align-items-center">
          <div id="show-megamenu" class="item-mobile-top">
            <div class="icon-directional"></div>
          </div>
          <div class="mobile-btn_search item-mobile-top">
            {% render 'icon-search' %}
            <i class="zmdi zmdi-close"></i>
          </div>
          <div id="mobile_search">
            {% render 'nov-formsearch-inline' %}
          </div>
        </div>
        <div class="mobile_logo col-6 text-center">
          {% if sst.logo %}
            <a href="{{ routes.root_url }}" class="site-header__logo-image img-fluid d-inline-block">
              {%- assign logo_alt = sst.logo.alt | default: shop.name | escape -%}
              {%- assign logo_height = sst.wm_logo | divided_by: sst.logo.aspect_ratio | round -%}
              {% capture sizes %}(max-width: {{ sst.wm_logo | times: 2 }}px) 50vw, {{ sst.wm_logo }}px{% endcapture %}
              {% capture widths %}{{ sst.wm_logo }}, {{ sst.wm_logo | times: 1.5 | round }}, {{ sst.wm_logo | times: 2 }}{% endcapture %}
              {{ sst.logo | image_url: width: 600 | image_tag:
                widths: widths,
                height: logo_height,
                width: sst.wm_logo,
                alt: logo_alt,
                sizes: sizes,
                preload: true
              }}
            </a>
          {% else %}
            <a class="site-header__logo-link" href="{{ routes.root_url }}" itemprop="url">{{ shop.name }}</a>
          {% endif %}
        </div>
        <div class="mobile_cart col-3 d-flex justify-content-end align-items-center">
          <div class="header-cart">
            <div class="site-header__cart position-relative">
              <span class="cart-count position-absolute" title="{{ 'layout.cart.title_cart' | t }}">
                <span class="CartCount">{{ cart.item_count }}</span>
              </span>
              <div class="site-header__cart-icon">
                {% if sst.cart_svg %}
                  {% render 'icon-cart' %}
                {% else %}
                  <i class="rbb-icon-shopping-{{ sst.cart_type }}-{{ sst.cart }} position-relative"></i>
                {% endif %}
              </div>
            </div>
          </div>
          <div class="btn-vertical btn-vertical-mobile"> 
            <div class="icon">
              <span></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
{% if sst.stickymenu %}
  <div id="header-sticky" class="d-none d-lg-block header-search__parent color-{{ sst.header_bottom_color }}">
    <div class="{{ sst.container }}">
      <div class="bl_content row align-items-center">
        <div class="col-3 d-flex align-items-center">
          <div class="contentstickynew_logo d-flex align-items-center justify-content-center"></div>
        </div>
        <div class="col-6 d-xl-flex align-items-center justify-content-center">
          <div class="contentstickynew_menu d-flex"></div>
        </div>
        <div class="col-3 d-flex align-items-center justify-content-end">
          <div class="header-group-item d-flex align-items-center justify-content-end">
            {% if settings.search_enable %}
              <div class="contentstickynew_search"></div>
            {% endif %}
            {% if shop.customer_accounts_enabled %}
              <div class="contentstickynew_account"></div>
            {% endif %}
            {% if settings.wishlist_enable %}
              <div class="contentstickynew_wishlist"></div>
            {% endif %}
            {% if settings.cart_enable %}
              <div class="contentstickynew_cart"></div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}
{% render 'nov-mobile-canvas', mainmenu: sst.main_linklist %}
{% render 'nov-search-canvas' %}
{% schema %}
