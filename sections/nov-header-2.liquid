        "default": 150,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "w_logo_lg",
        "label": "Width logo laptop (px)",
        "default": 150,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "w_logo_md",
        "label": "Width logo tablet (px)",
        "default": 150,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "wm_logo",
        "label": "Width logo mobile (px)",
        "default": 100
      },
      {
        "type": "header",
        "content": "Header Container"
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          { "value": "container", "label": "Container" },
          { "value": "container-fluid", "label": "Container fluid"}
        ]
      },
      {
        "type": "header",
        "content": "Header Absolute Color"
      },
      {
        "type": "color",
        "id": "abs_bg",
        "label": "Background",
        "default": "#fff"
      },
      {
        "type": "color_scheme",
        "id": "abs_color",
        "label": "Color",
        "default": "background-1"
      },
      {
        "type": "header",
        "content": "Header Color"
      },
      {
        "type": "color_scheme",
        "id": "header_color_inner",
        "label": "Color page inner",
        "default": "background-1"
