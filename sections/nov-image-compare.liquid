{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}

{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .nov-ba-wrap {
    border-radius: {{ sst.corner }}px;
  }
  #shopify-section-{{ section.id }} .nov-ba-text,
  #shopify-section-{{ section.id }} .nov-ba-text2 {
    color: {{ sst.text_color }};
  }
  #shopify-section-{{ section.id }} .link {
    --color-link: {{ sst.text_color }};
  }
{% endstyle %}
<div class="container-outer{{ bg_class_full }}">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}">
      <div class="row">
        <div class="col-lg-4 mb-md-40">
          <div class="bl-r">
            {% render 'heading-section', sub_position: sst.subheading_position, class: 'mb-30' %}
            {% if sst.heading_btn_label != blank %}
              <a href="{{ sst.heading_btn_link }}" class="btn mt-xs-20 m-left-auto">
                {{ sst.heading_btn_label }}
                <i class="zmdi zmdi-long-arrow-right"></i>
              </a>
            {% endif %}
          </div>
        </div>
        <div class="col-lg-8">
          <div id="{{ section.id }}" class="content-img-compare">
            <div class="nov-before-after init position-relative">
              <div class="nov-ba-wrap overflow_hidden position-relative" data-filter="0">
                <div class="after item" style="background-image: url('{{ sst.image_after | image_url: width: 1920 }}')"></div>
                <div class="before item" style="background-image: url('{{ sst.image_before | image_url: width: 1920 }}')"></div>
                {% render 'nov-aspect-image', image: sst.image_before %}
                <div class="handle position-absolute h-100">
                  <div class="handle-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="15" viewBox="0 0 11 15" fill="none">
                      <path d="M9.25 1.25V13.25M5.25 1.25V13.25M1.25 1.25V13.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              </div>
              {% if sst.image_text_before != blank or sst.link_b_label != blank %}
                <div class="nov-before-header position-absolute color-{{ sst.button_color }} {{ sst.button_type_color }}">
                  {% if sst.image_text_before != blank %}
                    <div class="nov-ba-text fs-16 fs-xs-12 font-500">{{ sst.image_text_before }}</div>
                  {% endif %}
                  {% if sst.image_text_before2 != blank %}
                    <div class="nov-ba-text2 font-700 mt-10">{{ sst.image_text_before2 }}</div>
                  {% endif %}
                  {% if sst.link_b_label != blank %}
                    <a href="{{ sst.link_b }}" class="nov-ba-link btn mt-10 mt-sm-5 d-inline-flex align-items-center text-capitalize">
                      <span>{{ sst.link_b_label }}</span>
                      <i class="zmdi zmdi-long-arrow-right"></i>
                    </a>
                  {% endif %}
                </div>
              {% endif %}
              {% if sst.image_text_after != blank or sst.link_a_label != blank %}
                <div class="nov-after-header position-absolute color-{{ sst.button_color }} {{ sst.button_type_color }}">
                  {% if sst.image_text_after != blank %}
                    <div class="nov-ba-text fs-16 fs-xs-12 font-500">{{ sst.image_text_after }}</div>
                  {% endif %}
                  {% if sst.image_text_after2 != blank %}
                    <div class="nov-ba-text2 font-700 mt-10">{{ sst.image_text_after2 }}</div>
                  {% endif %}
                  {% if sst.link_a_label != blank %}
                    <a href="{{ sst.link_a }}" class="nov-ba-link btn mt-10 mt-sm-5 d-inline-flex align-items-center text-capitalize">
                      <span>{{ sst.link_a_label }}</span>
                      <i class="zmdi zmdi-long-arrow-right"></i>
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div><!-- End container -->
</div>
{% schema %}
  {
