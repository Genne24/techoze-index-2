    "settings": [
      {
        "type": "image_picker",
        "id": "img_heading",
        "label": "Heading image"
      },
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Vinova Image Compare</p>"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#222222",
        "visible_if": "{{ section.settings.heading != blank }}"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Sub heading",
        "default": "<p>Subtitle from happy customers</p>"
      },
      {
        "type": "color",
        "id": "subheading_color",
        "label": "Sub heading color",
        "default": "#666666",
        "visible_if": "{{ section.settings.subheading != blank }}"
      },
      {
        "type": "select",
        "id": "subheading_position",
        "label": "Sub heading position",
        "default": "bottom",
        "options": [
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "bottom",
            "label": "Bottom"
          }
        ],
        "visible_if": "{{ section.settings.subheading != blank }}"
      },
      {
        "type": "richtext",
        "id": "descheading",
        "label": "Description",
        "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
      },
      {
        "type": "color",
        "id": "descheading_color",
        "label": "Description color",
        "default": "#666666",
        "visible_if": "{{ section.settings.descheading != blank }}"
      },
      {
        "type": "text",
        "id": "heading_btn_label",
        "label": "Button label",
        "default": "Shop Now"
      },
      {
        "type": "url",
        "id": "heading_btn_link",
        "label": "Button link"
      },
      {
        "type": "text_alignment",
        "id": "alignment",
        "label": "Alignment",
        "default": "left"
      },
      {
        "type": "header",
        "content": "Image"
      },
      {
        "type": "image_picker",
        "id": "image_before",
        "label": "Image before",
        "info": "1920 x 850 recommend"
      },
      {
        "type": "image_picker",
        "id": "image_after",
        "label": "Image after",
        "info": "1920 x 850 recommend"
      },
      {
        "type": "header",
        "content": "Text On Before Image"
      },
      {
        "type": "text",
        "id": "image_text_before",
        "label": "Text"
      },
      {
        "type": "text",
        "id": "image_text_before2",
        "label": "Text 2"
      },
      {
        "type": "text",
        "id": "link_b_label",
        "label": "Button label"
      },
      {
        "type": "url",
        "id": "link_b",
        "label": "Button link"
      },
      {
        "type": "header",
        "content": "Text On After Image"
      },
      {
        "type": "text",
        "id": "image_text_after",
        "label": "Text after"
      },
      {
        "type": "text",
        "id": "image_text_after2",
        "label": "Text 2"
      },
      {
        "type": "text",
        "id": "link_a_label",
        "label": "Button label"
      },
      {
        "type": "url",
        "id": "link_a",
        "label": "Button link"
      },
      {
        "type": "header",
        "content": "Text Color"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "#666"
      },
      {
        "type": "header",
        "content": "Button Style"
      },
      {
        "type": "color_scheme",
        "id": "button_color",
        "label": "Button color",
        "default": "background-1"
      },
      {
        "type": "select",
        "id": "button_type_color",
        "label": "Button type color",
        "options": [
          {
            "value": "btn-primary",
            "label": "Primary"
          },
          {
            "value": "btn-secondary",
            "label": "Secondary"
          }
        ],
        "default": "btn-primary"
      },
      {
        "type": "header",
        "content": "Image Corner Radius"
      },
      {
        "type": "range",
        "id": "corner",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "Corner radius",
        "default": 0
      },
      {
        "type": "header",
        "content": "Section Style"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Show animated",
        "default":   true
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          { "value": "container", "label": "Container" },
          { "value": "container-fluid", "label": "Container fluid" },
          { "value": "container-full", "label": "Container full width" }
        ]
      },
      {
        "type": "text",
        "id": "class_section",
        "label": "Class"
      },
      {
        "type":  "header",
        "content": "Section Background"
      },
      {
        "type": "checkbox",
        "id": "ss_bg_enable",
        "label": "Enable"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colors",
        "default": "#ffffff",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "select",
        "id": "background_img_size",
        "label": "Background image size",
        "default": "cover",
        "options": [
          { "value": "auto", "label": "Auto" },
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" }
        ],
        "visible_if": "{{ section.settings.ss_bg_enable and section.settings.background_image != blank }}"
      },
      {
        "type": "checkbox",
        "id": "enable_background_img_size_custom",
        "label": "Enable background image size custom",
        "visible_if": "{{ section.settings.ss_bg_enable and section.settings.background_image != blank }}"
      },
      {
        "type": "text",
        "id": "background_img_size_custom",
