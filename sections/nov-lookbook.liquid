{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
-%}

{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .image-wrapper {
    {% if sst.round %}
      border-radius: 100%;
    {% else %}
      border-radius: {{ sst.radius }}px;
    {% endif %}
  }
{% endstyle %}
<div class="{{ class }}" data-section-id="{{ section.id }}" data-section-type="nov-swiper">
  <div class="{{ sst.container }}">
    <div class="{% if sst.btn_top != blank %}d-flex {% endif %}align-items-center mb-65 mb-lg-40 mb-sm-35">
      {% render 'heading-section', sub_position: sst.subheading_position, class: 'mb-0 mb-xs-15' %}
      {% if sst.btn_top != blank %}
        <a href="{{ sst.btn_top_link }}" class="btn {{ sst.btn_top_type }} color-{{ sst.btn_top_color }} btn-medium m-left-auto">
          <span>{{ sst.btn_top }}</span>
          <i class="zmdi zmdi-long-arrow-right"></i>
        </a>
      {% endif %}
    </div>

    <div class="nov-swiper-carousel swiper"
      data-autoplay="false" 
      data-autoplayTimeout="6000" 
      data-loop="false"
      data-row="1"
      data-items_xxl="{{ sst.xxl }}"
      data-items_xl="{{ sst.xl }}"
      data-items_lg="{{ sst.lg }}"
      data-items_md="{{ sst.md }}"
      data-items_sm="{{ sst.sm }}"
      data-items_xs="{{ sst.xs }}"
      data-spacing="{{ sst.spacing }}"
      data-spacing_mobile="{{ sst.spacing_sm }}">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% assign bst = block.settings %}
          <div class="swiper-slide sp-item">
            <div class="nov-content-lookbook">
              {% if bst.btn != blank or bst.title != blank or bst.desc != blank %}
                <div class="lookbook-block_text {{ bst.bt_alignment }} color-{{ bst.color_sm }} d-md-none w-100 p-5">
                  {% if bst.title != blank %}
                    <div class="lookbook-title color-title {{ bst.title_font_weight }} fs-{{ bst.title_font_size_xxl }} fs-xl-{{ bst.title_font_size_xl }} fs-lg-{{ bst.title_font_size_lg }} fs-md-{{ bst.title_font_size_md }} fs-sm-{{ bst.title_font_size_sm }} fs-xs-{{ bst.title_font_size_xs }}" style="line-height: {{ bst.title_line_height }}">{{ bst.title }}</div>
                  {% endif %}
                  {% if bst.stitle != blank %}
                    <div class="lookbook-stitle mt-15 mt-sm-10 color-title {{ bst.stitle_font_weight }} fs-{{ bst.stitle_font_size_xxl }} fs-xl-{{ bst.stitle_font_size_xl }} fs-lg-{{ bst.stitle_font_size_lg }} fs-md-{{ bst.stitle_font_size_md }} fs-sm-{{ bst.stitle_font_size_sm }} fs-xs-{{ bst.stitle_font_size_xs }}">{{ bst.stitle }}</div>
                  {% endif %}
                  {% if bst.desc != blank %}
                    <div class="lookbook-desc mt-15 mt-sm-10 color-text fs-{{ bst.desc_font_size_xxl }} fs-xl-{{ bst.desc_font_size_xl }} fs-lg-{{ bst.desc_font_size_lg }} fs-md-{{ bst.desc_font_size_md }} fs-sm-{{ bst.desc_font_size_sm }} fs-xs-{{ bst.desc_font_size_xs }}">{{ bst.desc }}</div>
                  {% endif %}
                  {% if bst.btn_label != blank %}
                    <a href="{{ bst.btn_link }}" class="btn mt-15">
                      <span>{{ bst.btn_label }}</span>
                      <i class="zmdi zmdi-long-arrow-right"></i>
                    </a>
                  {% endif %}
                </div>
              {% endif %}
              <div class="position-relative">
                <div class="position-relative">
                  <div class="image-wrapper overflow_hidden">
                    {% if bst.lookbook_image != blank %}
                      {% render 'nov-aspect-image', image: bst.lookbook_image %}
                    {% else %}
                      {%- capture current -%}{% cycle 1, 2, 3 %}{%- endcapture -%}
                      {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </div>
                </div>
                {% for i in (1..4) %}
                  {% assign pin_product_id = 'pin_product_' | append: i %}
                  {% assign pin_position_top_id = 'pin_position_top_' | append: i %}
                  {% assign pin_position_left_id = 'pin_position_left_' | append: i %}
                  {% assign pin_title_id = 'pin_title_' | append: i %}
                  {% assign pin_desc_id = 'pin_desc_' | append: i %}

                  {% if bst[pin_product_id] != blank or bst[pin_title_id] != blank or bst[pin_desc_id] != blank %}
                    {% assign product = all_products[bst[pin_product_id]] %}
                    <div class="item-lookbook position-absolute grid--view-items d-flex" style="top: {{ bst[pin_position_top_id] }}%; left: {{ bst[pin_position_left_id] }}%">
                      <span class="number-lookbook"></span>
                      <div class="content-lookbook position-absolute">
                        {% if bst[pin_product_id] != blank %}
                          <div class="lookbook-item-product">
                            <div class="thumbnail-container{% if product.images.size > 1 %} has-multiimage{% endif %}">
                              <a href="{{ product.url }}">
                                {% assign image_url = product.featured_image %}
                                <img src="{{ image_url | image_url: width: 1 }}" data-src="{{ image_url | image_url: width: 200 }}" class="product__thumbnail lazyload img-fluid" alt="{{ image_url.alt | default: 'image' }}" width="200" height="200">
                              </a>
                            </div>
                            <div class="product__info mt-20 mt-md-0">
                              {% if settings.review_enable %}
                                <div class="product__review">
                                  <div class="AirReviews-Widget AirReviews-Widget--Stars" data-review-avg="{{ product.metafields.air_reviews_product.review_avg }}" data-review-count="{{ product.metafields.air_reviews_product.review_count }}"></div>
                                </div>
                              {% endif %}
                              <div class="product__title"><a href="{{ product.url }}">{{ product.title }}</a></div>
                              <div class="price-box mt-10 pb-5">
                                {% if product.compare_at_price_min > product.price_min %}
                                  <div class="price-sale d-flex flex-wrap align-items-center">
                                    <span class="special-price" data-price-grid>{{ product.variants[0].price | money }}</span>
                                    <span class="old-price" data-compare-price-grid>{{ product.variants[0].compare_at_price | money }}</span>
                                  </div>
                                {% else %}
                                  <div class="price-regular">
                                    <span data-price-grid>{{ product.variants[0].price | money }}</span>
                                  </div>
                                {% endif %}
                              </div>
                            </div>
                          </div>
                        {% endif %}
                        {% if bst[pin_title_id] != blank or bst[pin_desc_id] != blank %}
                          <div class="item-lookbook-text">
                            {% if bst[pin_title_id] != blank %}
                              <div class="item-lookbook-title fs-16 fs-lg-14 font-600 color-title">{{ bst[pin_title_id] }}</div>
                            {% endif %}
                            {% if bst[pin_desc_id] != blank %}
                              <div class="item-lookbook-desc fs-14 fs-lg-12 mt-15 color-text">{{ bst[pin_desc_id] }}</div>
                            {% endif %}
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
                {% if bst.btn != blank or bst.title != blank or bst.desc != blank %}
                  <div class="lookbook-block_text position-absolute {{ bst.bt_alignment }} {{ bst.position }} color-{{ bst.color }} d-none d-md-block" style="--horizontal: {{ bst.position_horizontal }}%; --vertical: {{ bst.position_vertical }}%">
                    {% if bst.title != blank %}
                      <div class="lookbook-title color-title {{ bst.title_font_family }} {{ bst.title_font_weight }} fs-{{ bst.title_font_size_xxl }} fs-xl-{{ bst.title_font_size_xl }} fs-lg-{{ bst.title_font_size_lg }} fs-md-{{ bst.title_font_size_md }} fs-sm-{{ bst.title_font_size_sm }} fs-xs-{{ bst.title_font_size_xs }}" style="line-height: {{ bst.title_line_height }}">{{ bst.title }}</div>
                    {% endif %}
                    {% if bst.stitle != blank %}
                      <div class="lookbook-stitle mt-15 mt-sm-10 color-title {{ bst.stitle_font_family }} {{ bst.stitle_font_weight }} fs-{{ bst.stitle_font_size_xxl }} fs-xl-{{ bst.stitle_font_size_xl }} fs-lg-{{ bst.stitle_font_size_lg }} fs-md-{{ bst.stitle_font_size_md }} fs-sm-{{ bst.stitle_font_size_sm }} fs-xs-{{ bst.stitle_font_size_xs }}">{{ bst.stitle }}</div>
                    {% endif %}
                    {% if bst.desc != blank %}
                      <div class="lookbook-desc mt-15 mt-sm-10 color-text fs-{{ bst.desc_font_size_xxl }} fs-xl-{{ bst.desc_font_size_xl }} fs-lg-{{ bst.desc_font_size_lg }} fs-md-{{ bst.desc_font_size_md }} fs-sm-{{ bst.desc_font_size_sm }} fs-xs-{{ bst.desc_font_size_xs }}">{{ bst.desc }}</div>
                    {% endif %}
                    {% if bst.btn_label != blank %}
                      <a href="{{ bst.btn_link }}" class="btn mt-15">
                        <span>{{ bst.btn_label }}</span>
                        <i class="zmdi zmdi-long-arrow-right"></i>
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      {% if sst.show_dots %}
        <div class="swiper-pagination"></div>
      {% endif %}
    </div>

  </div>
</div>
{% schema %}
  {
    "name": "Vinova LookBook",
    "class": "section-lookbook",
    "disabled_on": {
      "groups": ["header", "footer", "custom.system"]
    },
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Vinova Lookbook</p>"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#222222",
        "visible_if": "{{ section.settings.heading != blank }}"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Sub heading",
        "default": "<p>Subtitle from happy customers</p>"
      },
      {
        "type": "color",
        "id": "subheading_color",
        "label": "Sub heading color",
        "default": "#666666",
        "visible_if": "{{ section.settings.subheading != blank }}"
      },
      {
        "type": "select",
        "id": "subheading_position",
        "label": "Sub heading position",
        "default": "bottom",
        "options": [
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "bottom",
            "label": "Bottom"
          }
        ],
        "visible_if": "{{ section.settings.subheading != blank }}"
      },
      {
        "type": "richtext",
        "id": "descheading",
        "label": "Description",
        "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
      },
      {
        "type": "color",
        "id": "descheading_color",
        "label": "Description color",
        "default": "#666666",
        "visible_if": "{{ section.settings.descheading != blank }}"
      },
      {
        "type": "text_alignment",
        "id": "alignment",
        "label": "Alignment",
        "default": "left"
      },
      {
        "type": "header",
        "content": "Button Top"
      },
      {      
        "type": "text",
        "id": "btn_top",
        "label": "Button top",
        "default": "Button top"
      },
      {
        "type": "url",
        "id": "btn_top_link",
        "label": "Button top link",
        "default": "/collections/all"
      },
      {
        "type": "select",
        "id": "btn_top_type",
        "label": "Button top type",
        "default": "btn-primary",
        "options": [
          {
            "value": "btn-primary",
            "label": "Primary"
          },
          {
            "value": "btn-secondary",
            "label": "Secondary"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "btn_top_color",
        "label": "Button top color",
        "default": "background-1"
      },
      {
        "type":  "header",
        "content": "Item Per Row"
      },
      {
        "type": "range",
        "id": "xxl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Desktop",
        "default": 3,
        "info": "Breakpoint 1441px"
      },
      {
        "type": "range",
        "id": "xl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large laptop",
        "default": 3,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "range",
        "id": "lg",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Laptop",
        "default": 3,
        "info": "Breakpoint 992px"
      },
      {
        "type": "range",
        "id": "md",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Tablet",
        "default": 3,
        "info": "Breakpoint 768px"
      },
      {
        "type": "range",
        "id": "sm",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large mobile",
        "default": 2,
        "info": "Breakpoint 576px"
      },
      {
        "type": "range",
        "id": "xs",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Mobile",
        "default": 2
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "spacing",
        "min": 0,
        "max": 60,
        "step": 5,
        "label": "Spacing items",
        "default": 20,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "spacing_sm",
        "min": 0,
        "max": 60,
        "step": 5,
        "label": "Spacing mobile",
        "default": 10,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Dots Slider"
      },
      {
        "type": "checkbox",
        "id": "show_dots",
        "label": "Show dots",
        "default": false
      },
      {
        "type": "select",
        "id": "dots_color",
        "label": "Dots color",
        "default": "dots_on_light",
        "options": [
          {"value": "dots_on_light","label": "Dots on light background"},
          {"value": "dots_on_dark","label": "Dots on dark background"}
        ],
        "visible_if": "{{ section.settings.show_dots }}"
      },
      {
        "type":  "header",
        "content": "Style Item"
      },
      {
        "type": "range",
        "id": "radius",
        "min": 0,
        "max": 60,
        "step": 5,
        "label": "Border radius image",
        "unit": "px",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "round",
        "label": "Round image",
        "default":   false
      },
      {
        "type":  "header",
        "content": "Section Style"
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          { "value": "container", "label": "Container" },
          { "value": "container-fluid", "label": "Container fluid" },
          { "value": "container-full", "label": "Container full width" }
        ]
      },
      {
        "type": "text",
        "id": "class_section",
        "label": "Class"
      },
      {
        "type":  "header",
        "content": "Section Background"
      },
      {
        "type": "checkbox",
        "id": "ss_bg_enable",
        "label": "Enable"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colors",
        "default": "#ffffff",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "select",
        "id": "background_img_size",
        "label": "Background image size",
        "default": "cover",
        "options": [
          { "value": "auto", "label": "Auto" },
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" }
        ],
        "visible_if": "{{ section.settings.ss_bg_enable and section.settings.background_image != blank }}"
      },
      {
        "type": "checkbox",
        "id": "enable_background_img_size_custom",
        "label": "Enable background image size custom",
        "visible_if": "{{ section.settings.ss_bg_enable and section.settings.background_image != blank }}"
      },
      {
        "type": "text",
        "id": "background_img_size_custom",
        "label": "Background image size custom",
        "info": "Replace base background size, unit % or px",
        "visible_if": "{{ section.settings.background_image != blank and section.settings.enable_background_img_size_custom }}"
      },
      {
        "type": "select",
        "id": "background_img_position",
        "label": "Background image position",
        "default": "center center",
        "options": [
          { "value": "top left", "label": "Top left" },
          { "value": "top center", "label": "Top center" },
          { "value": "top right", "label": "Top right" },
          { "value": "center left", "label": "Center left" },
          { "value": "center center", "label": "Center middle" },
          { "value": "center right", "label": "Center right" },
          { "value": "bottom left", "label": "Bottom left" },
          { "value": "bottom center", "label": "Bottom center" },
          { "value": "bottom right", "label": "Bottom right" }
        ],
        "visible_if": "{{ section.settings.background_image != blank }}"
      },
      {
        "type": "range",
        "id": "background_corner",
        "min": 0,
        "max": 50,
        "step": 1,
        "label": "Corner background",
        "unit": "px",
        "default": 0,
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "select",
        "id": "background_position",
        "label": "Background position",
        "default": "bg-center",
        "options": [
          { "value": "bg-top", "label": "Top" },
          { "value": "bg-center", "label": "Center" },
          { "value": "bg-bottom", "label": "Bottom" }
        ],
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "select",
        "id": "background_size",
        "label": "Background size",
        "default": "full",
        "options": [
          { "value": "full", "label": "Full" },
          { "value": "contain", "label": "Contain"}
        ],
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "range",
        "id": "background_padding_horizontal",
        "label": "Background size contain padding horizontal",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 1,
        "unit": "%",
        "info": "Breakpoint 1200px ↑",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "range",
        "id": "height_background_xxl",
        "min": 10,
        "max": 100,
        "step": 1,
        "label": "Height background",
        "default": 100,
        "unit": "%",
        "info": "Breakpoint 1441px ↑",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "range",
        "id": "height_background_xl",
        "min": 10,
        "max": 100,
        "step": 1,
        "label": "Height background",
        "default": 100,
        "unit": "%",
        "info": "Breakpoint 1200px ↑",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "range",
        "id": "height_background_lg",
        "min": 10,
        "max": 100,
        "step": 1,
        "label": "Height background",
        "default": 100,
        "unit": "%",
        "info": "Breakpoint 992px ↑",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "range",
        "id": "height_background_md",
        "min": 10,
        "max": 100,
        "step": 1,
        "label": "Height background",
        "default": 100,
        "unit": "%",
        "info": "Breakpoint 768px ↑",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "range",
        "id": "height_background_sm",
        "min": 10,
        "max": 100,
        "step": 1,
        "label": "Height background",
        "default": 100,
        "unit": "%",
        "info": "Breakpoint 576px ↑",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "range",
        "id": "height_background_xs",
        "min": 10,
        "max": 100,
        "step": 1,
        "label": "Height background",
        "default": 100,
        "unit": "%",
        "info": "Breakpoint 575px ↓",
        "visible_if": "{{ section.settings.ss_bg_enable }}"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "distance_top_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_top_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "distance_top_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_top_sm",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "distance_bottom_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_bottom_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "distance_bottom_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_bottom_sm",
        "label": "Mobile",
        "default": 30
      }
    ],
    "blocks": [
      {
        "type": "lookbook",
        "name": "Lookbook Item",
        "settings": [
          {
            "type": "image_picker",
            "id": "lookbook_image",
            "label": "Image"
          },
          {
            "type": "header",
            "content": "Block Text"
          },
          {
            "type": "select",
            "id": "position",
            "label": "Position",
            "default": "left-center",
            "options": [
              {"value": "left-top", "label": "Left top" },
              {"value": "left-center", "label": "Left center"},
              {"value": "left-bottom", "label": "Left bottom"},
              {"value": "right-top", "label": "Right top" },
