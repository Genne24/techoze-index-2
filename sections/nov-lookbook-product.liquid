      },
      {
        "type": "color",
        "id": "overlay_desc_color",
        "label": "Overlay description color",
        "default": "#666666",
        "visible_if": "{{ section.settings.overlay_card_enable }}"
      },
      {
        "type": "color",
        "id": "overlay_card_bg",
        "label": "Overlay card background",
        "default": "#ffffff",
        "visible_if": "{{ section.settings.overlay_card_enable }}"
      },
      {
        "type": "range",
        "id": "overlay_card_opacity",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "label": "Overlay card opacity",
        "default": 90,
        "visible_if": "{{ section.settings.overlay_card_enable }}"
      },
      {
        "type": "range",
        "id": "overlay_card_corner",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "Overlay card corner radius",
        "default": 12,
