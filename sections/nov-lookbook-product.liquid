        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#222222",
        "visible_if": "{{ section.settings.heading != blank }}"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Sub heading",
        "default": "<p>Subtitle from happy customers</p>"
      },
      {
        "type": "color",
        "id": "subheading_color",
        "label": "Sub heading color",
        "default": "#666666",
        "visible_if": "{{ section.settings.subheading != blank }}"
      },
      {
        "type": "select",
        "id": "subheading_position",
        "label": "Sub heading position",
        "default": "bottom",
        "options": [
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "bottom",
            "label": "Bottom"
          }
        ],
        "visible_if": "{{ section.settings.subheading != blank }}"
      },
      {
        "type": "richtext",
        "id": "descheading",
        "label": "Description",
        "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
      },
      {
        "type": "color",
        "id": "descheading_color",
        "label": "Description color",
        "default": "#666666",
        "visible_if": "{{ section.settings.descheading != blank }}"
      },
      {
        "type": "text_alignment",
        "id": "alignment",
        "label": "Alignment",
        "default": "left"
      },
      {
        "type": "header",
        "content": "Image"
      },
