        "id": "corner",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "Image corner radius",
        "default": 0
      },
      {
        "type": "header",
        "content": "Image Overlay Card"
      },
      {
        "type": "checkbox",
        "id": "overlay_card_enable",
        "label": "Show overlay card",
        "default": true
      },
      {
        "type": "text",
        "id": "overlay_badge_text",
        "label": "Badge text",
        "default": "Neutral",
        "visible_if": "{{ section.settings.overlay_card_enable }}"
      },
      {
        "type": "color",
        "id": "overlay_badge_bg",
        "label": "Badge background",
        "default": "#222222",
        "visible_if": "{{ section.settings.overlay_card_enable }}"
      },
      {
        "type": "color",
        "id": "overlay_badge_color",
        "label": "Badge text color",
        "default": "#ffffff",
        "visible_if": "{{ section.settings.overlay_card_enable }}"
      },
      {
        "type": "text",
        "id": "overlay_title",
        "label": "Overlay title",
        "default": "Classic Collection",
        "visible_if": "{{ section.settings.overlay_card_enable }}"
      },
      {
        "type": "color",
        "id": "overlay_title_color",
