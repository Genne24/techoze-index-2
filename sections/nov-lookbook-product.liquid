{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}

{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .img-wapper {
    border-radius: {{ sst.corner }}px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .block-product-inner {
    background-color: {{ sst.panel_bg_color }};
    border-radius: {{ sst.panel_corner }}px;
    padding: {{ sst.panel_padding }}px;
  }
  @media (max-width: 575px) {
    #shopify-section-{{ section.id }} .block-product-inner {
      padding: {{ sst.panel_padding }}px 0;
    }
  }
  #shopify-section-{{ section.id }} .overlay-card {
    position: absolute;
    bottom: 2rem;
    inset-inline-start: 2rem;
    background-color: {{ sst.overlay_card_bg }};
    opacity: {{ sst.overlay_card_opacity | divided_by: 100.0 }};
    border-radius: {{ sst.overlay_card_corner }}px;
    padding: 1.6rem 2rem;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .overlay-card__badge {
    display: inline-block;
    background-color: {{ sst.overlay_badge_bg }};
    color: {{ sst.overlay_badge_color }};
    border-radius: 100px;
    padding: 2px 11px;
    margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .overlay-card__title {
    color: {{ sst.overlay_title_color }};
    margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .overlay-card__desc {
    color: {{ sst.overlay_desc_color }};
  }
{% endstyle %}

<div class="container-outer{{ bg_class_full }} position-relative color-{{ sst.color_section }}" data-section-id>
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}">
      <div class="row">
        <div class="image-lookbook position-relative col-lg-6">
          <div class="position-relative">
            <div class="img-wapper">
              {% if sst.lookbook_image != blank %}
                {% render 'nov-aspect-image', image: sst.lookbook_image %}
              {% else %}
                {%- capture current -%}{% cycle 1, 2, 3 %}{%- endcapture -%}
                {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            {% for block in section.blocks %}
              {% assign bst = block.settings %}
              {% if block.type == 'item' %}
                <div class="number nov_btn_act position-absolute d-flex align-items-center justify-content-center r-100 pointer{% if forloop.first %} act{% endif %}" data-toggle="{{ section.id }}{{ forloop.index }}" style="top: {{ bst.pin_position_top }}%; left: {{ bst.pin_position_left }}%">
                  <span class="position-relative d-flex align-items-center justify-content-center">{{ forloop.index }}</span>
                </div>
              {% endif %}
            {% endfor %}
  
            {% if sst.overlay_card_enable %}
              <div class="overlay-card">
                {% if sst.overlay_badge_text != blank %}
                  <span class="overlay-card__badge fs-12">{{ sst.overlay_badge_text }}</span>
                {% endif %}
                {% if sst.overlay_title != blank %}
                  <p class="overlay-card__title h3 fs-20 fs-lg-16 font-700">{{ sst.overlay_title }}</p>
                {% endif %}
                {% if sst.overlay_desc != blank %}
                  <p class="overlay-card__desc fs-14 font-lg-12 mb-0">{{ sst.overlay_desc }}</p>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
        <div class="block-product mt-md-40 col-lg-6">
          <div class="block-product-inner h-100 d-flex flex-column align-items-center justify-content-center">
            {% render 'heading-section', sub_position: sst.subheading_position %}
            <div class="list--view-items position-relative w-100">
              {% for block in section.blocks %}
                <div class="item d-flex align-items-center{% unless forloop.last %} mb-25{% endunless %} nov_item_act{% if forloop.first %} act{% endif %}"
                  data-act="{{ section.id }}{{ forloop.index }}">
                  {% assign product = all_products[block.settings.pin_product] %}
                  {%- liquid
                    assign on_sale = false
                    if product.compare_at_price_min > product.price_min
                      assign on_sale = true
                    endif
                    assign current_variant = product.selected_or_first_available_variant
                  -%}
                  
                  <div class="item-product{% if settings.show_border_product %} h_bd{% endif %}{% if settings.show_background_product %} bg{% endif %}" data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-product-title="{{ product.title | escape }}">
                    <div class="inner-top d-flex align-items-center">
                      <div class="product-top thumbnail-container ratio-{{ settings.aspect_product_image }}{% if settings.show_second_image_product and product.images.size > 1 %} has-multiimage{% endif %}">
                        <a href="{{ product.url }}">
                          {% assign img_url = product.featured_image %}
                          <div class="respone_image" style="padding-top:{{ 1 | divided_by: img_url.aspect_ratio | times: 100}}%;">
                            <img class="product__thumbnail lazyload" src="{{ img_url | image_url: width: 1 }}" data-src="{{ img_url | image_url: width: 260 }}" data-srcset="{{ img_url | image_url: width: 260 }} 260w,{{ img_url | image_url: width: 360 }} 360w,{{ img_url | image_url: width: 540 }} 540w,{{ img_url | image_url: width: 720 }} 720w,{{ img_url | image_url: width: 900 }} 900w,{{ img_url | image_url: width: 1080 }} 1080w" data-sizes="auto" alt="{{ img_url.alt }}" width="{{ img_url.width }}" height="{{ img_url.height }}" loading="lazy" style="height: auto;">
                            {% for image in product.images %}
                              {% assign img_url = image %}
                              {% if forloop.first != true and settings.show_second_image_product %}
                                <img class="product__thumbnail-second lazyload" src="{{ img_url | image_url: width: 1 }}" data-src="{{ img_url | image_url: width: 260 }}" data-srcset="{{ img_url | image_url:width: 260 }} 260w,{{ img_url | image_url: width: 360 }} 360w,{{ img_url | image_url: width: 540 }} 540w,{{ img_url | image_url: width: 720 }} 720w,{{ img_url | image_url: width: 900 }} 900w,{{ img_url | image_url: width: 1080 }} 1080w" data-sizes="auto" alt="{{ img_url.alt }}" width="{{ img_url.width }}" height="{{ img_url.height }}" loading="lazy" style="height: auto;">
                                {% break %}
                              {% endif %}
                            {% endfor %}
                          </div>
                        </a>
                      </div>
                      
                      <div class="product__info"> 
                        {% if settings.review_enable %}
                          <div class="AirReviews-Widget AirReviews-Widget--Stars mb-10" data-review-avg="{{ product.metafields.air_reviews_product.review_avg }}" data-review-count="{{ product.metafields.air_reviews_product.review_count }}"></div>
                        {% endif %}
                        <div class="product__title {{ settings.title_product_line }}"><a href="{{ product.url }}">{{ product.title }}</a></div>
                        <div class="price-box price-st">
                          {% if on_sale %}
                            <div class="price-sale">
                              <span class="special-price" data-price-grid>{{ product.variants[0].price | money }}</span>
                              <span class="old-price" data-compare-price-grid>{{ product.variants[0].compare_at_price | money }}</span>
                            </div>
                          {% else %}
                            <div class="price-regular">
                              <span data-price-grid>{{ product.variants[0].price | money }}</span>
                            </div>
                          {% endif %}
                        </div>
                        {% if settings.wishlist_enable %}
                          {% render 'nov-wishlist', id: product.id, handle: product.handle %}
                        {% endif %}
                        {% if settings.addtocart_enable %}
                          {% if product.has_only_default_variant %}
                            <form action="{{ routes.cart_add_url }}" method="post" class="form-btn-item-product {% if product.has_only_default_variant %}variants-default{% else %}one-option-color{% endif %} color-{{ settings.color_btn_addtocart }} {{ settings.btn_addtocart_type }}" id="grid-product-form--{{ product.id }}-{{ section.id }}" data-id="product-actions-{{ product.id }}" enctype="multipart/form-data">
                              <input type="hidden" name="id" value="{{ product.variants[0].id }}" />
                              <input type="hidden" name="quantity" value="1" />
                              {% if product.variants.first.available == false %}
                                <span class="btn disabled pointer overflow_hidden" type="submit" data-toggle="modal" data-target="#Form_newletter">
                                  {% render 'icon-cart' %}
                                </span>
                                {% if settings.tooltip_enable %}
                                  <span class="btn-tootip">{{ 'products.product.sold_out' | t }}</span>
                                {% endif %}
                              {% else %}
                                <button data-btn-addToCart 
                                class="add-to-cart-btn btn{% unless settings.cart_status_addtocart == 'goto_page_cart' %} product-form__cart-submit{% endunless %}"
                                type="submit"
                                data-form-id="#grid-product-form--{{ product.id }}-{{ section.id }}">
                                  {% render 'icon-cart' %}
                                  <span class="d-none d-sm-block">
                                    {% if current_variant.inventory_policy == 'continue' and current_variant.inventory_management == 'shopify' %}
                                      {{ 'products.product.pre_order' | t }}
                                    {% else %}
                                      {{ 'products.product.add_to_cart' | t }}
                                    {% endif %}
                                  </span>
                                  <span class="load"></span>
                                </button>
                              {% endif %}
                            </form>
                          {% else %}
                            <a href="{{ product.url }}" class="btn pointer">
                              {% render 'icon-cart' %}
                              {{ 'products.product.select_options' | t }}
                            </a>
                          {% endif %}
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
            {% if sst.add_all_to_card != blank %}
              <div class="btn-add-all-cart text-center mt-60 mt-xs-35">
                <div class="btn btn-medium js_add_all_to_cart position-relative">
                  <span>{{ sst.add_all_to_card }}</span>
                  <i class="zmdi zmdi-long-arrow-right"></i>
                  <div class="load"></div>
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
