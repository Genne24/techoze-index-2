    "name": "Vinova Lookbook Product",
    "class": "section-lookbook-product",
    "disabled_on": {
      "groups": ["header", "footer", "custom.system"]
    },
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Vinova Lookbook Product</p>"
      },
