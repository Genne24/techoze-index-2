{%- assign bst = block.settings -%}
{% style %}
  .block-{{ block.id }} {
    --mt-xl: {{ bst.mt_xl }}px;
    --mt-lg: {{ bst.mt_lg }}px;
    --mt-md: {{ bst.mt_md }}px;
    --mt-sm: {{ bst.mt_sm }}px;
    --mb-xl: {{ bst.mb_xl }}px;
    --mb-lg: {{ bst.mb_lg }}px;
    --mb-md: {{ bst.mb_md }}px;
    --mb-sm: {{ bst.mb_sm }}px;
    --color-hover: {{ bst.number_color }};
    --color-title: {{ bst.title_color }};
    background: {{ bst.bg }};
    backdrop-filter: blur({{ bst.blur }}px);
    border-radius: {{ bst.corner }}px;
    {% if bst.width == 'max_content' %}width: max-content;max-width: 100%{% endif %}
  }
  @media(min-width: 1441px) {
    .block-{{ block.id }} {
      padding: {{ bst.padding_block_xxl }}px {{ bst.padding_inline_xxl }}px;
    }
  }
  @media(min-width: 1200px) and (max-width: 1440px) {
    .block-{{ block.id }} {
      padding: {{ bst.padding_block_xl }}px {{ bst.padding_inline_xl }}px;
    }
  }
  @media(min-width: 768px) and (max-width: 1199px) {
    .block-{{ block.id }} {
      padding: {{ bst.padding_block_md }}px {{ bst.padding_inline_md }}px;
    }
  }
  @media(max-width: 767px) {
    .block-{{ block.id }} {
      padding: {{ bst.padding_block_sm }}px {{ bst.padding_inline_sm }}px;
    }
  }
{% endstyle %}
<div class="block-{{ block.id }} theme-blocks-item number-block text-{{ bst.text_alignment }}{% if bst.width == 'max_content' %} m-{{ bst.alignment }}-auto{% endif %}" {{ block.shopify_attributes }}>
  <div class="number-block__number d-inline-flex align-items-center fs-{{ bst.number_fs_xl }} fs-lg-{{ bst.number_fs_lg }} fs-sm-{{ bst.number_fs_sm }} {{ bst.number_fw }} {{ bst.number_ff }} color-act{% if bst.unit_pos == 'before' %} flex-row-reverse{% endif %}">
    <span class="number-block__number-value{% if bst.number_animation %} number-animate{% endif %}" data-number="{{ bst.number }}">{{ bst.number }}</span>
    <span class="number-block__number-unit">{{ bst.unit }}</span>
  </div>
  <div class="number-block__title fs-{{ bst.title_fs_xl }} fs-lg-{{ bst.title_fs_lg }} fs-sm-{{ bst.title_fs_sm }} {{ bst.title_fw }} color-title mt-5">{{ bst.title }}</div>
</div>
