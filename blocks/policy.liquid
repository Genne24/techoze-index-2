{%- assign bst = block.settings -%}
{% style %}
  {% if bst.style == 'style1' %}
    #block-{{ block.id }} .policy-block-content > div:not(:last-child) {
      margin-inline-end: {{ bst.gap }}px;
    }
    #block-{{ block.id }} .policy-block-content.flex-row-reverse > div:not(:last-child) {
      margin-inline-start: {{ bst.gap }}px;
      margin-inline-end: 0;
    }
    @media(min-width: 576px) {
      #block-{{ block.id }} .policy-block-content.flex-sm-row-reverse > div:not(:last-child) {
        margin-inline-start: {{ bst.gap }}px;
        margin-inline-end: 0;
      }
    }
    @media(min-width: 768px) {
      #block-{{ block.id }} .policy-block-content.flex-md-row-reverse > div:not(:last-child) {
        margin-inline-start: {{ bst.gap }}px;
        margin-inline-end: 0;
      }
    }
    @media(min-width: 992px) {
      #block-{{ block.id }} .policy-block-content.flex-lg-row-reverse > div:not(:last-child) {
        margin-inline-start: {{ bst.gap }}px;
        margin-inline-end: 0;
      }
    }
    @media(min-width: 1200px) {
      #block-{{ block.id }} .policy-block-content.flex-xl-row-reverse > div:not(:last-child) {
        margin-inline-start: {{ bst.gap }}px;
        margin-inline-end: 0;
      }
    }
  {% endif %}
  {% if bst.style == 'style2' %}
    #block-{{ block.id }} .icon-block-wrapper {
      margin-bottom: {{ bst.gap }}px;
      {% if bst.alignment == 'left' %}
        margin-inline-end: auto;
      {% elsif bst.alignment == 'center' %}
        margin-inline: auto;
      {% else %}
        margin-inline-start: auto;
      {% endif %}
    }
  {% endif %}
  #block-{{ block.id }} .icon-block-wrapper.bd-r {
    padding-inline-end: 25px;
  }
  #block-{{ block.id }} .icon-block-wrapper.bd-l {
    padding-inline-start: 25px;
  }
{% endstyle %}
<div id="block-{{ block.id }}" class="theme-blocks-item policy-block" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;" {{ block.shopify_attributes }}>
  <div class="policy-block-content{% if bst.style == 'style1' %} d-flex align-items-{{ bst.align }}{% if bst.reverse != 'none' %} {{ bst.reverse }}{% endif %}{% endif %}">
    {% content_for 'block', type: "icon", id: "icon" %}
    <div class="policy-block-text">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Policy",
    "tag": null,
    "blocks": [
      {
        "type": "text"
      }
    ],
    "settings": [
      {
        "type": "select",
        "id": "style",
        "label": "Style",
        "options": [
          {
            "value": "style1",
            "label": "Style 1"
          },
          {
            "value": "style2",
            "label": "Style 2"
          }
        ],
        "default": "style1"
      },
      {
        "type": "number",
        "id": "gap",
        "label": "Gap",
        "default": 10,
        "info": "Unit: px"
      },
      {
        "type": "select",
        "id": "align",
        "label": "Align",
        "options": [
          {
          "value": "start",
          "label": "Top"
          },
          {
          "value": "center",
          "label": "Center"
          },
          {
          "value": "end",
          "label": "Bottom"
          }
        ],
        "default": "center",
        "visible_if": "{{ block.settings.style == 'style1' }}"
      },
      {
        "type": "select",
        "id": "reverse",
        "label": "Reverse",
        "options": [
          { "value": "flex-row-reverse", "label": "All screens" },
          { "value": "flex-xl-row-reverse", "label": "Large laptop" },
          { "value": "flex-lg-row-reverse", "label": "Laptop" },
          { "value": "flex-md-row-reverse", "label": "Tablet" },
          { "value": "flex-sm-row-reverse", "label": "Large mobile" },
          { "value": "none", "label": "None" },
        ],
        "default": "none",
        "info": "Start reverse from",
        "visible_if": "{{ block.settings.style == 'style1' }}"
      },
      {
        "type": "text_alignment",
        "id": "alignment",
        "label": "Text alignment",
        "default": "center",
        "visible_if": "{{ block.settings.style == 'style2' }}"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 30
      }
    ],
    "presets": [
      {
        "name": "Policy",
        "category": "Content",
        "blocks": {
          "text-1": {
            "type": "text"
          },
          "text-2": {
            "type": "text"
          }
        },
        "block_order": ["text-1", "text-2"]
      }
    ]
  }
{% endschema %}
  