{%- assign bst = block.settings -%}
<div class="theme-blocks-item social-block text-{{ bst.alignment }} style-{{ bst.style }} {% if bst.style == 'list' and bst.show_label %} show-label{% endif %} type-{{ bst.type }} color-{{ bst.color_section }} {% if bst.type == 'btn' %} {{ bst.social_type_color }}{% if bst.show_box_shadow %} show-boxshadow{% endif %}{% endif %}" style="--icon-width: {{ bst.icon_width }}px;--size: {{ bst.size }}px; --radius: {{ bst.radius }}px;--gap: {{ bst.gap | divided_by: 2 }}px;--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;{% if bst.type == 'icon' %}--color-link: var(--color-{{ bst.icon_color }});{% endif %}" {{ block.shopify_attributes }}>
  {% render 'nov-social' %}
</div>

{% schema %}
  {
    "name": "Social",
    "tag": null,
    "settings": [
      {
        "type": "select",
        "id": "style",
        "label": "Style",
        "options": [
          {
            "value": "inline",
            "label": "Inline"
          },
          {
            "value": "list",
            "label": "List"
          }
        ],
        "default": "inline"
      },
      {
        "type": "checkbox",
        "id": "show_label",
        "label": "Show label",
        "visible_if": "{{ block.settings.style == 'list' }}"
      },
      {
        "type": "number",
        "id": "icon_width",
        "label": "Icon width",
        "default": 18,
        "info": "Unit: px"
      },
      {
        "type": "color_scheme",
        "id": "color_section",
        "label": "Color",
        "default": "background-1"
      },
      {
        "type": "select",
        "id": "type",
        "label": "Type",
        "options": [
          {
          "value": "btn",
          "label": "Button"
          },
          {
            "value": "icon",
            "label": "Icon"
            }
        ],
        "default": "btn"
      },
      {
        "type": "number",
        "id": "size",
        "label": "Size",
        "default": 40,
        "info": "Unit: px",
        "visible_if": "{{ block.settings.type == 'btn' }}"
      },
      {
        "type": "number",
        "id": "radius",
        "label": "Radius",
        "default": 99,
        "info": "Unit: px",
        "visible_if": "{{ block.settings.type == 'btn' }}"
      },
      {
        "type": "select",
        "id": "social_type_color",
        "label": "Type color",
        "options": [
          {
          "value": "btn-primary",
          "label": "Primary"
          },
          {
            "value": "btn-secondary",
            "label": "Secondary"
          }
        ],
        "default": "btn-primary",
        "visible_if": "{{ block.settings.type == 'btn' }}"
      },
      {
        "type": "checkbox",
        "id": "show_box_shadow",
        "label": "Box shadow",
        "visible_if": "{{ block.settings.type == 'btn' }}"
      },
      {
        "type": "select",
        "id": "icon_color",
        "label": "Type color",
        "options": [
          {
          "value": "icons",
          "label": "Icon"
          },
          {
            "value": "title",
            "label": "Title"
          },
          {
            "value": "sub-title",
            "label": "Sub title"
          },
          {
            "value": "text",
            "label": "Text"
          },
          {
            "value": "hover",
            "label": "Hover"
          }
        ],
        "default": "icons",
        "visible_if": "{{ block.settings.type == 'icon' }}"
      },
      {
        "type": "number",
        "id": "gap",
        "label": "Gap",
        "default": 10,
        "info": "Unit: px"
      },
      {
        "type": "text_alignment",
        "id": "alignment",
        "label": "Alignment",
        "default": "left"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 0
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Social",
        "category": "E-commerce"
      }
    ]
  }
{% endschema %}