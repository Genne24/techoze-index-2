{%- assign bst = block.settings -%}
{% style %}
  {% if bst.bd_side %}
    #block-{{ block.id }}.bd-side .nov-accordion {
      border-color: {{ bst.bd_color }};
    }
    #block-{{ block.id }}.bd-side .nov-accordion__item:before {
      background: {{ bst.bd_color_act }};
    }
  {% endif %}
  #block-{{ block.id }} .nov-accordion__item {
    border-radius: {{ bst.corner_radius }}px;
    padding: {{ bst.padding_block }}px {{ bst.padding_inline }}px;
    background: {{ bst.item_bg }};
    {% if bst.show_border and bst.bd_b == false %}
      border: 1px solid {{ bst.bd_color }};
    {% endif %}
  }
  {% if bst.bd_b %}
    #block-{{ block.id }} .nov-accordion__item:not(:last-child) {
      border-bottom: 1px solid {{ bst.bd_color }};
    }
  {% endif %}
  #block-{{ block.id }} .nov-accordion__item.act {
    background: {{ bst.item_bg_act }};
    border-color: {{ bst.bd_color_act }} !important;
  }
  #block-{{ block.id }} .nov-accordion__item:not(:last-child) {
    margin-bottom: {{ bst.gap }}px;
  }
  #block-{{ block.id }} .block {
    padding-top: {{ bst.spacing_top_text }}px;
  }
  #block-{{ block.id }} .nov-accordion {
    max-width: {{ bst.max_width }}px;
    margin-inline: auto;
  }
  {% if bst.style == 'style3' %}
    .nov-accordion__title.act .text-content {
			font-weight: {{ bst.title_font_weight_act }};
		}
  {% endif %}
{% endstyle %}
<div id="block-{{ block.id }}" class="theme-blocks-item accordion-block {{ bst.style }}{% if bst.bd_side %} bd-side{% endif %}{% if bst.show_border and bst.bd_b == false %} show-border{% endif %}{% if bst.show_navigation %} show_navigation {{ bst.navigation_style }}{% endif %}" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;" {{ block.shopify_attributes }}>
  <div class="block_accordion">
    <div class="nov-accordion{% if bst.first_open %} first-open{% endif %}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
  
{% schema %}
  {
    "name": "Accordion",
    "tag": null,
    "blocks": [
      {
        "type": "_accordion-item"
      },
      {
        "type": "_accordion-item-img"
      }
    ],
    "settings": [
      {
        "type": "checkbox",
        "id": "first_open",
        "label": "First item open",
        "default": true
      },
      {
        "type": "header",
        "content": "Style Accordion"
      },
      {
        "type": "select",
        "id": "style",
        "label": "Style",
        "options": [
          {
            "value": "style1",
            "label": "Style 1"
          },
          {
            "value": "style2",
            "label": "Style 2"
          },
          {
            "value": "style3",
            "label": "Style 3"
          }
        ],
        "default": "style1",
      },
      {
        "type": "select",
        "id": "title_font_weight_act",
        "label": "Active title font weight",
        "options": [
          {"value": "100","label": "Thin - 100"},
          {"value": "300","label": "Light - 300"},
          {"value": "400","label": "Regular - 400"},
          {"value": "500","label": "Medium - 500"},
          {"value": "600","label": "SemiBold - 600"},
          {"value": "700","label": "Bold - 700"},
          {"value": "800","label": "ExtraBold - 800"},
          {"value": "900","label": "Black - 900"}
        ],
        "default": "700",
        "visible_if": "{{ block.settings.style == 'style3' }}"
      },
      {
        "type": "color",
        "id": "item_bg",
        "label": "Background",
        "default": "#f2f2f2"
      },
      {
        "type": "color",
        "id": "item_bg_act",
        "label": "Background active",
        "default": "#d5d5d5"
      },
      {
        "type": "checkbox",
        "id": "show_navigation",
        "label": "Show navigation",
        "default": true,
      },
      {
        "type": "select",
        "id": "navigation_style",
        "label": "Navigation style",
        "options": [
          {
            "value": "nav1",
            "label": "Style 1"
          },
          {
            "value": "nav2",
            "label": "Style 2"
          }
        ],
        "default": "nav1",
        "visible_if": "{{ block.settings.show_navigation }}"
      },
      {
        "type": "number",
        "id": "spacing_top_text",
        "label": "Text spacing top",
        "default": 10,
        "info": "Unit: px"
      },
      {
        "type": "checkbox",
        "id": "show_border",
        "label": "Show border",
        "visible_if": "{{ block.settings.bd_b == false }}"
      },
      {
        "type": "checkbox",
        "id": "bd_side",
        "label": "Show border side"
      },
      {
        "type": "checkbox",
        "id": "bd_b",
        "label": "Show border bottom"
      },
      {
        "type": "color",
        "id": "bd_color",
        "label": "Border color",
        "default": "#DCDCDC",
      },
      {
        "type": "color",
        "id": "bd_color_act",
        "label": "Border color active",
        "default": "#000",
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px",
        "label": "Corner radius item",
        "default": 5
      },
      {
        "type": "range",
        "id": "padding_block",
        "min": 0,
        "max": 60,
        "step": 1,  
        "unit": "px",
        "label": "Padding block",
        "default": 10
      },
      {
        "type": "range",
        "id": "padding_inline",
        "min": 0,
        "max": 60,
        "step": 1,  
        "unit": "px",
        "label": "Padding inline",
        "default": 10
      },
      {
        "type": "range",
        "id": "gap",
        "min": 0,
        "max": 60,
        "step": 1,  
        "unit": "px",
        "label": "Gap",
        "default": 10
      },
      {
        "type": "number",
        "id": "max_width",
        "label": "Max width",
        "default": 1920,
        "info": "Unit: px"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 30
      }
    ],
    "presets": [
      {
        "name": "Accordion",
        "category": "Interaction",
        "blocks": {
          "accordion_item_1": {
            "type": "_accordion-item"
          },
          "accordion_item_2": {
            "type": "_accordion-item"
          },
          "accordion_item_3": {
            "type": "_accordion-item"
          }
        },
        "block_order": ["accordion_item_1", "accordion_item_2", "accordion_item_3"]
      }
    ]
  }
{% endschema %}