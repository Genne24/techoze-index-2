{%- assign bst = block.settings -%}
{% style %}
  .block-{{ block.id }} {
    --ips-radius: {{ bst.corner_radius }}px;
    --ips-gap: {{ bst.gap }}px;
    --ips-box-bg: {{ bst.box_bg }};
    --ips-box-color: {{ bst.text_color }};
    --ips-box-size: {{ bst.box_size }}px;
    --ips-box-radius: {{ bst.box_radius }}px;
    --ips-box-border-width: {{ bst.box_border_width }}px;
    --ips-box-border-color: {{ bst.box_border_color }};
    --ips-number-size: {{ bst.number_size }}px;
    --ips-subtitle-size: {{ bst.subtitle_size }}px;
  }
  .block-{{ block.id }} .ips-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ips-gap);
  }
  .block-{{ block.id }} .ips-img {
    border-radius: var(--ips-radius);
    transform: translateZ(0);
  }
  .block-{{ block.id }} .ips-img .respone_image,
  .block-{{ block.id }} .ips-img img {
    height: 100%;
  }
  .block-{{ block.id }} .ips-box {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: var(--ips-box-size);
    max-width: 50%;
    aspect-ratio: 1 / 1;
    background: var(--ips-box-bg);
    color: var(--ips-box-color);
    border: var(--ips-box-border-width) solid var(--ips-box-border-color);
    border-radius: var(--ips-box-radius);
    padding: 16px;
    z-index: 2;
  }
  .block-{{ block.id }} .ips-number {
    font-size: var(--ips-number-size);
    line-height: 1;
    margin-bottom: 10px;
    color: inherit;
  }
  .block-{{ block.id }} .ips-subtitle {
    font-size: var(--ips-subtitle-size);
    color: inherit;
  }
  @media (max-width: 575px) {
    .block-{{ block.id }} .ips-number { font-size: calc(var(--ips-number-size) * .7); }
    .block-{{ block.id }} .ips-subtitle { font-size: calc(var(--ips-subtitle-size) * .7); }
    .block-{{ block.id }} .ips-box { 
      padding: 10px;
      width: calc(var(--ips-box-size) * 0.7)
    }
  }
{% endstyle %}

<div class="block-{{ block.id }} theme-blocks-item" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;" {{ block.shopify_attributes }}>
  <div class="ips-wrap position-relative">
    <div class="ips-grid">
      <div class="ips-img overflow_hidden">
        {% if bst.image_1 != blank %}
          {% render 'nov-aspect-image', image: bst.image_1, aspect: bst.aspect_ratio %}
        {% else %}
          <div class="placeholder-image">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {% endif %}
      </div>
      <div class="ips-img overflow_hidden">
        {% if bst.image_2 != blank %}
          {% render 'nov-aspect-image', image: bst.image_2, aspect: bst.aspect_ratio %}
        {% else %}
          <div class="placeholder-image">{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {% endif %}
      </div>
    </div>

    {% if bst.number_text != blank or bst.subtitle_text != blank %}
      <div class="ips-box d-flex align-items-center justify-content-center flex-column text-center">
        {% if bst.number_text != blank %}<div class="ips-number font-600"><span class="number-animate" data-number="{{ bst.number_text }}">{{ bst.number_text }}</span>{{ bst.number_unit }}</div>{% endif %}
        {% if bst.subtitle_text != blank %}<p class="ips-subtitle">{{ bst.subtitle_text }}</p>{% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image Pair With Stat",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (left)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2 (right)"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image ratio",
      "default": "34",
      "options": [
        { "value": "34", "label": "Portrait (3:4)" },
        { "value": "11", "label": "Square (1:1)" },
        { "value": "43", "label": "Landscape (4:3)" },
        { "value": "auto", "label": "Original" }
      ]
    },
    {
      "type": "number",
      "id": "corner_radius",
      "label": "Image corner radius",
      "default": 12,
      "info": "Unit: px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between images",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Center Text Box"
    },
    {
      "type": "number",
      "id": "number_text",
      "label": "Big number",
      "default": 150
    },
    {
      "type": "text",
      "id": "number_unit",
      "label": "Unit",
      "default": "+"
    },
    {
      "type": "text",
      "id": "subtitle_text",
      "label": "Subtitle",
      "default": "Barbershops Nationwide"
    },
    {
      "type": "range",
      "id": "box_size",
      "label": "Box size",
      "min": 100,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "number",
      "id": "box_radius",
      "label": "Box corner radius",
      "default": 8,
      "info": "Unit: px"
    },
    {
      "type": "range",
      "id": "box_border_width",
      "label": "Box border width",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "box_border_color",
      "label": "Box border color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Big text size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Box background color",
      "default": "#b9764a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Box text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing Top (px)"
    },
    {
      "type": "number",
      "id": "mt_xl",
      "label": "Large laptop",
      "default": 0,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mt_lg",
      "label": "Laptop",
      "default": 0,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mt_md",
      "label": "Tablet",
      "default": 0,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mt_sm",
      "label": "Mobile",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing Bottom (px)"
    },
    {
      "type": "number",
      "id": "mb_xl",
      "label": "Large laptop",
      "default": 0,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mb_lg",
      "label": "Laptop",
      "default": 0,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mb_md",
      "label": "Tablet",
      "default": 0,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mb_sm",
      "label": "Mobile",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Image Pair With Stat",
      "category": "Content"
    }
  ]
}
{% endschema %}
