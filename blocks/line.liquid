{%- assign bst = block.settings -%}
{% if bst.align == 'left' %}
  {% assign align = 'm-right-auto' %}
{% elsif bst.align == 'right' %}
  {% assign align = 'm-left-auto' %}
{% else %}
  {% assign align = 'm-center-auto' %}
{% endif %}
<div class="theme-blocks-item line-block d-flex" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;{% if bst.show_line_second %}--lsc: {{ bst.lsc }}; --lsw: {{ bst.lsw }}%;--height: {{ bst.height }}px{% endif %}">
  <div class="{{ align }} position-relative{% if bst.show_line_second %} line-second{% endif %}" style="width: {{ bst.width }}%; border-top: {{ bst.height }}px {{ bst.style }} {{ bst.color }};"></div>
</div>

{% schema %}
  {
    "name": "Line",
    "tag": null,
    "settings": [
      {
        "type": "number",
        "id": "height",
        "label": "Height",
        "default": 1
      },
      {
        "type": "range",
        "id": "width",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "Width",
        "default": 100
      },
      {
        "type": "text_alignment",
        "id": "align",
        "label": "Align",
        "default": "center"
      },
      {
        "type": "color",
        "id": "color",
        "alpha": true,
        "label": "Colors",
        "default": "#000"
      },
      {
        "type": "select",
        "id": "style",
        "label": "Style",
        "options": [
          {
            "value": "solid",
            "label": "Solid"
          },
          {
            "value": "dashed",
            "label": "Dashed"
          },
          {
            "value": "dotted",
            "label": "Dotted"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_line_second",
        "label": "Show line second"
      },
      {
        "type": "color",
        "id": "lsc",
        "label": "Color",
        "default": "#444",
        "visible_if": "{{ block.settings.show_line_second }}"
      },
      {
        "type": "range",
        "id": "lsw",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "Width",
        "default": 30,
        "visible_if": "{{ block.settings.show_line_second }}"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 30
      }
    ],
    "presets": [
      {
        "name": "Line",
        "category": "Layout"
      }
    ]
  }
  {% endschema %}
  