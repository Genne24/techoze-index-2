{%- liquid
  assign bst = block.settings
  assign class_col = bst.class_col
  
  assign wu = bst.width_unit
  if wu == 'column'
    assign style_width_column = bst.col_xxl | append: ' ' | append: bst.col_xl | append: ' ' | append: bst.col_lg | append: ' ' | append: bst.col_md | append: ' ' | append: bst.col_sm | append: ' ' | append: bst.col_xs
  elsif wu == '%'
    assign style_width = '--w-xxl: ' | append: bst.w_xxl | append: wu | append: ';--w-xl: ' | append: bst.w_xl | append: wu | append: ';--w-lg: ' | append: bst.w_lg | append: wu | append: ';--w-md: ' | append: bst.w_md | append: wu | append: ';--w-sm: ' | append: bst.w_sm | append: wu | append: ';--w-xs: ' | append: bst.w_xs | append: wu | append: ';'
  endif

  assign class_border = ''
  if bst.bd_top != 'none'
    assign class_border = class_border | append: ' ' | append: bst.bd_top
  endif
  if bst.bd_bottom != 'none'
    assign class_border = class_border | append: ' ' | append: bst.bd_bottom
  endif
  if bst.bd_left != 'none'
    assign class_border = class_border | append: ' ' | append: bst.bd_left
  endif
  if bst.bd_right != 'none'
    assign class_border = class_border | append: ' ' | append: bst.bd_right
  endif

  assign style_padding_left = '--pl-xxl: ' | append: bst.pl_xxl | append: 'px; --pl-xl: ' | append: bst.pl_xl | append: 'px; --pl-lg: ' | append: bst.pl_lg | append: 'px; --pl-md: ' | append: bst.pl_md | append: 'px; --pl-sm: ' | append: bst.pl_sm | append: 'px; --pl-xs: ' | append: bst.pl_xs | append: 'px;'
  assign style_padding_right = '--pr-xxl: ' | append: bst.pr_xxl | append: 'px; --pr-xl: ' | append: bst.pr_xl | append: 'px; --pr-lg: ' | append: bst.pr_lg | append: 'px; --pr-md: ' | append: bst.pr_md | append: 'px; --pr-sm: ' | append: bst.pr_sm | append: 'px; --pr-xs: ' | append: bst.pr_xs | append: 'px;'

  assign class_align = ''
  if bst.align_content_enable
    assign class_align = class_align | append: ' d-flex justify-content-xl-' | append: bst.align_content_horizontal_xl | append: ' align-items-xl-' | append: bst.align_content_vertical_xl | append: ' justify-content-lg-' | append: bst.align_content_horizontal_lg | append: ' align-items-lg-' | append: bst.align_content_vertical_lg | append: ' justify-content-md-' | append: bst.align_content_horizontal_md | append: ' align-items-md-' | append: bst.align_content_vertical_md | append: ' justify-content-sm-' | append: bst.align_content_horizontal_sm | append: ' align-items-sm-' | append: bst.align_content_vertical_sm | append: ' justify-content-' | append: bst.align_content_horizontal_xs | append: ' align-items-' | append: bst.align_content_vertical_xs
  endif

  assign style_mt = '--mt-xl: ' | append: bst.mt_xl | append: 'px;--mt-lg: ' | append: bst.mt_lg | append: 'px;--mt-md: ' | append: bst.mt_md | append: 'px;--mt-sm: ' | append: bst.mt_sm | append: 'px;;--mt-xs: ' | append: bst.mt_xs | append: 'px;'
  assign style_mb = '--mb-xl: ' | append: bst.mb_xl | append: 'px;--mb-lg: ' | append: bst.mb_lg | append: 'px;--mb-md: ' | append: bst.mb_md | append: 'px;--mb-sm: ' | append: bst.mb_sm | append: 'px;--mb-xs: ' | append: bst.mb_xs | append: 'px;'
-%}
{% style %}
  #block-{{ block.id }} {
    {{ style_mt }}
    {{ style_mb }}
    --color-border: {{ bst.bd_color }};
    {% if bst.wu != 'column' %}{{ style_width }}{% endif %}
    {% if bst.align_content_enable and bst.width_type == 'custom' %}--width-content: {{ bst.width_content }}{{ bst.width_content_unit }};{% endif %}
    {% if bst.pl_enable %}{{ style_padding_left }}{% endif %}
    {% if bst.pr_enable %}{{ style_padding_right }}{% endif %}
  }
  #block-{{ block.id }} > .block-container {
    border-radius: {{ bst.corner_radius }}px;
    {% if bst.show_style %}
      background-color: {{ bst.background }};
      overflow: hidden;
      {% if bst.background_img != blank %}
        background-image: url("{{ bst.background_img | image_url: width: 960 }}");
      {% endif %}
    {% endif %}
  }
  {% if bst.enable_order %}
    @media(min-width: 1200px) {
      #block-{{ block.id }} {
        order: {{ bst.order_xl }};
      }
    }
    @media(min-width: 992px) and (max-width: 1199px) {
      #block-{{ block.id }} {
        order: {{ bst.order_lg }};
      }
    }
    @media(min-width: 768px) and (max-width: 991px) {
      #block-{{ block.id }} {
        order: {{ bst.order_md }};
      }
    }
    @media(min-width: 576px) and (max-width: 767px) {
      #block-{{ block.id }} {
        order: {{ bst.order_sm }};
      }
    }
    @media(max-width: 575px) {
      #block-{{ block.id }} {
        order: {{ bst.order_xs }};
      }
    }
  {% endif %}
{% endstyle %}

<div id="block-{{ block.id }}" class="col-block{% if wu == '%' %} unit-percent{% endif %}{% if wu == 'column' %} {{ style_width_column }}{% endif %} {{ class_col }}">
  <div class="block-container h-100{{ class_align }}{% if bst.show_border %}{{ class_border }}{% endif %} overflow-hidden position-relative">
    <div class="col-block-content position-relative{% unless bst.align_content_enable %} h-100{% endunless %}{% if bst.pl_enable %} pl{% endif %}{% if bst.pr_enable %} pr{% endif %}{% if block.settings.width_type == 'custom' and block.settings.align_content_enable %} width-custom{% endif %} duration-300">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

