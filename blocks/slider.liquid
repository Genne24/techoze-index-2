{%- liquid
  assign bst = block.settings
-%}
{%- style -%}
  #block-{{ block.id }} .slider-item-content {
    border-radius: {{ bst.item_corner_tl | append: 'px' }} {{ bst.item_corner_tr | append: 'px' }} {{ bst.item_corner_br | append: 'px' }} {{ bst.item_corner_bl | append: 'px' }};
    transform: translateZ(0);
    overflow: hidden;
    {% if bst.show_item_boxshadow and bst.show_item_boxshadow_when_hover == false %}
      box-shadow: 5px 5px 20px rgba(0,0,0, 0.1);
    {% endif %}
  }
  {% if bst.show_item_boxshadow %}
    #block-{{ block.id }} .slick-list {
      margin-block: -25px;
      padding-block: 25px;
    }
  {% endif %}
  {% if bst.show_item_boxshadow and bst.show_item_boxshadow_when_hover %}
    #block-{{ block.id }} .slider-item-content:hover {
      box-shadow: 10px 10px 25px rgba(0,0,0, 0.1);
    }
  {% endif %}
  
  {% if bst.rounded_half %}
    #block-{{ block.id }} {
      --bg: {{ bst.bg }};
    }
  {% endif %}

{%- endstyle -%}

<div id="block-{{ block.id }}" class="theme-blocks-item slider-block animate-{{ bst.text_button_animation | default: 'fade_up' }} {{ bst.dots_color }} {{ bst.arrow_color }}{% if bst.rounded_half %} rounded-half{% endif %}{% if bst.effect_mode == 'all' %} effect-all-{{ bst.global_effect | default: 'curtain' }}{% else %} effect-mode-custom{% endif %}" data-section-id="{{ section.id }}" style="--anim-duration: {{ bst.animation_duration | default: 0.8 }}s; --text-anim-delay: {{ bst.text_delay | default: 0.2 }}s; --btn-anim-delay: {{ bst.button_delay | default: 0.4 }}s; --mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;">
  <div class="custom-slide-wrapper{% if bst.hv_pause %} hv_pause{% endif %}" 
    data-custom-slideshow
    data-autoplay="{{ bst.autoplay }}" 
    data-speed="{{ bst.speed | times: '1000' }}"
    style="--h-xs: {{ bst.h_xs | default: 300 | append: 'px' }};--h-sm: {{ bst.h_sm | default: 300 | append: 'px' }};">
    <div class="custom-slides-container">
      {% content_for 'blocks' %}
    </div>

    {% if bst.show_nav %}
      <button type="button" class="custom-slider-arrow arrow-prev" aria-label="Previous Slide">
        {% render 'icon-arrow-prev' %}
      </button>
      <button type="button" class="custom-slider-arrow arrow-next" aria-label="Next Slide">
        {% render 'icon-arrow-next' %}
      </button>
    {% endif %}

    {% if bst.show_dots %}
      <div class="custom-slider-dots{% if bst.dots_on_item %} dots-on-item{% endif %}"></div>
    {% endif %}
  </div>
</div>

{% schema %}
  {
    "name": "Vinova Slider",
    "blocks": [
      {
        "type": "_slider_item"
      }
    ],
    "settings": [
      {
        "type": "checkbox",
        "id": "rounded_half",
        "label": "Rounded in half style"
      },
      {
        "type": "color",
        "id": "bg",
        "alpha": true,
        "label": "Background",
        "default": "#f2f2f2",
        "visible_if": "{{ block.settings.rounded_half }}"
      },
      {
        "type": "header",
        "content": "Transition Effects"
      },
      {
        "type": "select",
        "id": "effect_mode",
        "label": "Effect Mode",
        "default": "all",
        "options": [
          {"value": "all", "label": "All slides use 1 effect"},
          {"value": "custom", "label": "Custom effect per slide"},
          {"value": "none", "label": "No effect"}
        ]
      },
      {
        "type": "select",
        "id": "global_effect",
        "label": "Effect for all slides",
        "default": "curtain",
        "options": [
          {"value": "curtain", "label": "Model 1: Curtain Reveal"},
          {"value": "circular", "label": "Model 2: Circular Radial"},
          {"value": "stripes", "label": "Model 3: Horizontal Stripe"}
        ],
        "visible_if": "{{ block.settings.effect_mode == 'all' }}"
      },
      {
        "type": "header",
        "content": "Text & Button Slide Animations"
      },
      {
        "type": "select",
        "id": "text_button_animation",
        "label": "Text & Button Animation Effect",
        "default": "fade_up",
        "options": [
          {"value": "fade_up", "label": "Fade Up"},
          {"value": "fade_down", "label": "Fade Down"},
          {"value": "slide_left", "label": "Slide Left"},
          {"value": "slide_right", "label": "Slide Right"},
          {"value": "zoom_in", "label": "Zoom In"}
        ]
      },
      {
        "type": "range",
        "id": "animation_duration",
        "label": "Animation Duration (seconds)",
        "min": 0.3,
        "max": 2,
        "step": 0.1,
        "unit": "s",
        "default": 0.8
      },
      {
        "type": "range",
        "id": "text_delay",
        "label": "Text Animation Delay (seconds)",
        "min": 0,
        "max": 1.5,
        "step": 0.1,
        "unit": "s",
        "default": 0.2
      },
      {
        "type": "range",
        "id": "button_delay",
        "label": "Button Animation Delay (seconds)",
        "min": 0,
        "max": 1.5,
        "step": 0.1,
        "unit": "s",
        "default": 0.4
      },
      {
        "type": "header",
        "content": "Item Style"
      },
      {
        "type": "range",
        "id": "item_corner_tl",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Corner radius top left",
        "default": 0
      },
      {
        "type": "range",
        "id": "item_corner_tr",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Corner radius top right",
        "default": 0
      },
      {
        "type": "range",
        "id": "item_corner_br",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Corner radius bottom right",
        "default": 0
      },
      {
        "type": "range",
        "id": "item_corner_bl",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Corner radius bottom left",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "show_item_boxshadow",
        "label": "Show box shadow"
      },
      {
        "type": "checkbox",
        "id": "show_item_boxshadow_when_hover",
        "label": "Show box shadow when hover",
        "visible_if": "{{ block.settings.show_item_boxshadow }}"
      },
      {
        "type": "header",
        "content": "Min Height Mobile"
      },
      {
        "type": "number",
        "id": "h_sm",
        "label": "Min height slide large mobile (px) 767px ↓",
        "default": 230
      },
      {
        "type": "number",
        "id": "h_xs",
        "label": "Min height slide mobile (px) 575px ↓",
        "default": 230
      },
      {
        "type": "header",
        "content": "Slider Settings"
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay"
      },
      {
        "type": "range",
        "id": "speed",
        "label": "Speed (seconds)",
        "min": 1,
        "max": 10,
        "step": 1,
        "unit": "s",
        "default": 7,
        "visible_if": "{{ block.settings.autoplay }}"
      },
      {
        "type": "checkbox",
        "id": "hv_pause",
        "label": "Pause Hover",
        "default": true
      },
      {
        "type":  "header",
        "content": "Item Per Row"
      },
      {
        "type": "range",
        "id": "xxl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Desktop",
        "default": 3,
        "info": "Breakpoint 1441px"
      },
      {
        "type": "range",
        "id": "xl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large laptop",
        "default": 3,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "range",
        "id": "lg",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Laptop",
        "default": 3,
        "info": "Breakpoint 992px"
      },
      {
        "type": "range",
        "id": "md",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Tablet",
        "default": 3,
        "info": "Breakpoint 768px"
      },
      {
        "type": "range",
        "id": "sm",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large mobile",
        "default": 2,
        "info": "Breakpoint 576px"
      },
      {
        "type": "range",
        "id": "xs",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Mobile",
        "default": 2
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "spacing",
        "min": 0,
        "max": 70,
        "step": 5,
        "unit": "px",
        "label": "Spacing item",
        "default": 30,
        "info": "Choose the spacing between items (px)"
      },
      {
        "type": "range",
        "id": "spacing_md",
        "min": 0,
        "max": 70,
        "step": 5,
        "unit": "px",
        "label": "Spacing item tablet",
        "default": 30,
        "info": "Choose the spacing between items (px)"
      },
      {
        "type": "header",
        "content": "Dots Slider"
      },
      {
        "type": "checkbox",
        "id": "show_dots",
        "label": "Show dots",
        "default": false
      },
      {
        "type": "select",
        "id": "dots_color",
        "label": "Dots color",
        "default": "dots_on_light",
        "options": [
          {"value": "dots_on_light","label": "Dots on light background"},
          {"value": "dots_on_dark","label": "Dots on dark background"}
        ],
        "visible_if": "{{ block.settings.show_dots }}"
      },
      {
        "type": "checkbox",
        "id": "dots_on_item",
        "label": "Dots on the item",
        "visible_if": "{{ block.settings.show_dots }}"
      },
      {
        "type": "header",
        "content": "Arrow Slider"
      },
      {
        "type": "checkbox",
        "id": "show_nav",
        "label": "Show prev/next arrow",
        "default": true
      },
      {
        "type": "select",
        "id": "arrow_color",
        "label": "Arrow color",
        "default": "arrow_on_light",
        "options": [
          {"value": "arrow_on_light","label": "Arrow on light background"},
          {"value": "arrow_on_dark","label": "Arrow on dark background"},
          {"value": "arrow_on_no_bg","label": "Arrow on no background"}
        ],
        "visible_if": "{{ block.settings.show_nav }}"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 0
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Slider",
        "category": "Interaction"
      }
    ]
  }
{% endschema %}
