{%- assign bst = block.settings -%}
<div class="theme-blocks-item serpri-block color-{{ bst.color }}" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px; --corner: {{ bst.corner_radius }}px" {{ block.shopify_attributes }}>
  <div class="d-flex flex-wrap align-items-sm-center justify-content-between position-relative">
    {% if bst.img != blank %}
      <div class="serpri-img position-absolute center-center overflow_hidden">
        {% render 'nov-aspect-image', image: bst.img %}
      </div>
    {% endif %}
    <div class="ser">
      <div class="title h2 fs-20 fs-lg-16 color-title">{{ bst.title }}</div>
      {% if bst.desc != blank %}
        <div class="desc fs-14 fs-lg-12 color-text">{{ bst.desc }}</div>
      {% endif %}
    </div>
    <div class="pri fs-14 fs-lg-12 font-500 color-title">{{ bst.price }}</div>
  </div>
</div>
{% schema %}
{
  "name": "Service And Price",
  "tag": null,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color",
      "label": "Color",
      "default": "background-1"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Lorem"
    },
    {
      "type": "inline_richtext",
      "id": "desc",
      "label": "Description",
      "default": "Description"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$200"
    },
    {
      "type": "image_picker",
      "id": "img",
      "label": "Image"
    },
    {
      "type": "number",
      "id": "corner_radius",
      "label": "Corner radius",
      "default": 5,
      "visible_if": "{{ block.settings.img != blank }}"
    },
    {
      "type": "header",
      "content": "Spacing Top (px)"
    },
    {
      "type": "number",
      "id": "mt_xl",
      "label": "Large laptop",
      "default": 30,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mt_lg",
      "label": "Laptop",
      "default": 30,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mt_md",
      "label": "Tablet",
      "default": 30,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mt_sm",
      "label": "Mobile",
      "default": 30
    },
    {
      "type": "header",
      "content": "Spacing Bottom (px)"
    },
    {
      "type": "number",
      "id": "mb_xl",
      "label": "Large laptop",
      "default": 30,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mb_lg",
      "label": "Laptop",
      "default": 30,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mb_md",
      "label": "Tablet",
      "default": 30,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mb_sm",
      "label": "Mobile",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Service And Price",
      "category": "Interaction"
    }
  ]
}
{% endschema %}