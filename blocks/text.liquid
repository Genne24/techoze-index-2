      "label": "Background",
      "default": "#fff",
      "info": "Background gradient when show button see more",
      "visible_if": "{{ block.settings.show_seemore }}"
    },
    {
      "type": "range",
      "id": "height_seemore",
      "min": 100,
      "max": 300,
      "step": 5,
      "label": "Height",
      "default": 160,
      "unit": "px",
