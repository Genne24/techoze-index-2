{%- assign bst = block.settings -%}

{%- liquid
  assign class_text = bst.font_family | append: ' ' | append: bst.font_weight | append: ' fs-' | append: bst.font_size_xxl | append: ' fs-xl-' | append: bst.font_size_xl | append: ' fs-lg-' | append: bst.font_size_lg | append: ' fs-md-' | append: bst.font_size_md | append: ' fs-sm-' | append: bst.font_size_sm | append: ' fs-xs-' | append: bst.font_size_xs
-%}

<div class="theme-blocks-item text-block text-{{ bst.alignment }}{% if bst.responsive_alignment %} text-xl-{{ bst.alignment_xl }} text-lg-{{ bst.alignment_lg }} text-md-{{ bst.alignment_md }} text-sm-{{ bst.alignment_sm }}{% endif %} {{ bst.text_transform }} {{ class_text }}{% if bst.show_seemore %} nov_item_act position-relative js-height{% endif %}{% if bst.bg_text != blank %} bg{% endif %}"{% if bst.show_seemore %} data-act="{{ block.id }}"{% endif %}
  style="color: {{ bst.color }};--color-text: {{ bst.color }};--color-link: {{ bst.color_link }};--color-link-hover: {{ bst.color_link_hover }};letter-spacing: {{ bst.letter_spacing }}px;{% if bst.line_height != blank and bst.line_height == 1 %}line-height: 1;{% else %}line-height: {{ bst.line_height | append: 'px' }};{% endif %}{% if bst.line_height_mb != blank and bst.line_height_mb == 1 %}--line-height-mb: 1.5;{% else %}--line-height-mb: {{ bst.line_height_mb | append: 'px' }};{% endif %}--max-width: {{ bst.max_w }}px;--bg-seemore: {{ bst.bg_seemore }};--mt-xxl: {{ bst.mt_xxl }}px;--mt-xl: {{ bst.mt_xl }}px;--mt-lg: {{ bst.mt_lg }}px;--mt-md: {{ bst.mt_md }}px;--mt-sm: {{ bst.mt_sm }}px;--mb-xxl: {{ bst.mb_xxl }}px;--mb-xl: {{ bst.mb_xl }}px;--mb-lg: {{ bst.mb_lg }}px;--mb-md: {{ bst.mb_md }}px;--mb-sm: {{ bst.mb_sm }}px;{%- if bst.show_seemore -%}--max-height: {{ bst.height_seemore | append: 'px' }}{%- endif -%}" {{ block.shopify_attributes }}>
  <div class="text-content position-relative d-inline-flex{% if bst.show_line %} show-line{% endif %}">
    {{ bst.text | newline_to_br }}
  </div>
</div>
{% if bst.show_seemore %}
  <div class="btn-show__content font-700 fs-16 text-center mt-30 nov_btn_act color-title position-relative" data-toggle="{{ block.id }}">
    <span class="see_more pointer color-hover">{{ bst.see_more_label }}{% if bst.show_seemore_icon %}<i class="zmdi zmdi-chevron-down"></i>{% endif %}</span>
    <span class="see_less pointer color-hover">{{ bst.see_less_label }}{% if bst.show_seemore_icon %}<i class="zmdi zmdi-chevron-up"></i>{% endif %}</span>
  </div>
{% endif %}

{% schema %}
{
  "name": "Text",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Lorem ipsum dolor sit amet.</p>"
    },
    {
      "type": "color",
      "id": "color",
      "alpha": true,
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_link",
      "label": "Color link",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_link_hover",
      "label": "Color link hover",
      "default": "#000000"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "responsive_alignment",
      "label": "Responsive alignment"
    },
    {
      "type": "text_alignment",
      "id": "alignment_xl",
      "label": "Large laptop",
      "info": "Breakpoint 1200px ↑",
      "visible_if": "{{ block.settings.responsive_alignment }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment_lg",
      "label": "Laptop",
      "info": "Breakpoint 992px ↑",
      "visible_if": "{{ block.settings.responsive_alignment }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment_md",
      "label": "Tablet",
      "info": "Breakpoint 768px ↑",
      "visible_if": "{{ block.settings.responsive_alignment }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment_sm",
      "label": "Large mobile",
      "info": "Breakpoint 576px ↑",
      "visible_if": "{{ block.settings.responsive_alignment }}"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font family",
      "options": [
        { "value": "f_df", "label": "Body font" },
        { "value": "f_pr", "label": "Heading font" }
      ],
      "default": "f_df"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {"value": "font-100","label": "Thin - 100"},
        {"value": "font-300","label": "Light - 300"},
        {"value": "font-400","label": "Regular - 400"},
        {"value": "font-500","label": "Medium - 500"},
        {"value": "font-600","label": "SemiBold - 600"},
        {"value": "font-700","label": "Bold - 700"},
        {"value": "font-800","label": "ExtraBold - 800"},
        {"value": "font-900","label": "Black - 900"}
      ],
      "default": "font-400"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        { "value": "text-capitalize", "label": "Capitalize" },
        { "value": "text-uppercase", "label": "Uppercase" },
        { "value": "none", "label": "None" }
      ],
      "default": "none"
    },
    {
      "type": "number",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "default": 0
    },
    {
      "type": "number",
      "id": "line_height",
      "label": "Line height",
      "default": 1
    },
    {
      "type": "number",
      "id": "line_height_mb",
      "label": "Line height mobile",
      "default": 1
    },
    {
      "type": "number",
      "id": "max_w",
      "label": "Max width",
      "default": 960,
      "info": "Unit: px"
    },
    {
      "type": "header",
      "content": "Font Size",
      "info": "Unit: px"
    },
    {
      "type": "range",
      "id": "font_size_xxl",
      "label": "Desktop",
      "info": "Breakpoint 1441px ↑",
      "min": 10,
      "max": 110,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_xl",
      "label": "Large laptop",
      "info": "Breakpoint 1200px ↑",
      "min": 10,
      "max": 110,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_lg",
      "label": "Laptop",
      "info": "Breakpoint 992px ↑",
      "min": 10,
      "max": 110,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_md",
      "label": "Tablet",
      "info": "Breakpoint 768px ↑",
      "min": 7,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_sm",
      "label": "Large mobile",
      "info": "Breakpoint 576px ↑",
      "min": 7,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_xs",
      "label": "Mobile",
      "min": 7,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
