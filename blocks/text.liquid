      "content": "Spacing Bottom (px)"
    },
    {
      "type": "number",
      "id": "mb_xxl",
      "label": "Desktop",
      "default": 10,
      "info": "Breakpoint 1441px"
    },
    {
      "type": "number",
      "id": "mb_xl",
      "label": "Large laptop",
      "default": 10,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mb_lg",
      "label": "Laptop",
      "default": 10,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
