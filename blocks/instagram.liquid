
{%- liquid
  assign bst = block.settings
-%}
<div class="insta-block position-relative nov-sh-image-2" style="border-radius: {{ bst.image_radius }}px" {{ block.shopify_attributes }}>
  {% if bst.image != blank %}
    {% if bst.link != blank %}
      <a href="{{ bst.link }}" class="d-block w-100">
    {% endif %}
    {% render 'nov-aspect-image', image: bst.image %}
    {% if bst.link != blank %}
      </a>
    {% endif %}
  {% else %}
    <div class="placeholder-image">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {% endif %}
  
</div>

{% schema %}
  {
    "name": "Instagram",
    "tag": null,
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      },
      {
        "type": "header",
        "content": "Image Config"
      },
      {
        "type": "number",
        "id": "image_radius",
        "label": "Image radius",
        "default": 5,
        "info": "Unit: px"
      }
    ],
    "presets": [
      {
        "name": "Instagram",
        "category": "Basic"
      }
    ]
  }
{% endschema %}