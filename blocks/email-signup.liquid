{%- assign bst = block.settings -%}
{% style %}
  #block-{{ block.id }} {
    --input-color: {{ bst.input_color }};
    --input-place-color: {{ bst.input_place_color }};
    --input-bg: {{ bst.input_bg }};
    --input-border-color: {{ bst.input_border_color }};
    --input-height: {{ bst.input_height }}px;
    --input-radius: {{ bst.input_radius }}px;
    --btn-width: {{ bst.btn_width }}px;
    --btn-label-font-size: {{ bst.btn_label_font_size }}px;
    --max-width: {{ bst.max_width }}px;
    --color-link: {{ bst.color_link }};
    --color-hover: {{ bst.color_hover }};
    --gap: {{ bst.gap }}px;
  }
{% endstyle %}
<div id="block-{{ block.id }}" class="theme-blocks-item email-signup-block{% if bst.style_line_bottom %} style-line-bottom{% endif %}{% if bst.button_position == 'btn_on_input' %} btn-on-input{% endif %}{% if bst.show_max_width %} max-width m-{{ bst.align }}{% endif %}" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;" {{ block.shopify_attributes }}>
  {% form 'customer', id: block.id %}
    <div class="input-group position-relative{% if bst.button_position == 'btn_bottom_input' %} d-block{% endif %}">
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email"
        name="contact[email]"
        class="form-control{% if bst.shadow_input %} shadow-input{% endif %}"
        value="{% if customer %}{{ customer.email }}{% endif %}"
        placeholder="{{ 'general.newsletter_form.email_newsletter' | t }}"
        required
      >
      <button type="submit" name="commit" aria-label="submit" class="pointer{% if bst.btn_type == 'text' %} link f_pr font-500{% else %} btn color-{{ bst.submit_color }} {{ bst.submit_btn_type }}{% endif %} btn-alternate">
        <span class="position-relative d-flex align-items-center justify-content-center">
          {%- if bst.btn_text_arrow == 'text' or bst.btn_text_arrow == 'text_arrow' %}
            {{ bst.btn_label }}
          {% endif %}
          {% if bst.btn_text_arrow == 'arrow' or bst.btn_text_arrow == 'text_arrow' %}
            <i class="zmdi zmdi-long-arrow-right"></i>
          {% endif -%}
        </span>
      </button>
    </div>
    {% if form.posted_successfully? %}
      <p class="form--success text-center">{{ 'general.newsletter_form.confirmation' | t }}</p>
    {% endif %}
    {%- if form.errors -%}
      {{ form.errors | default_errors }}
    {% endif %}
  {% endform %}
  </div>
{% schema %}
  {
    "name": "Email Signup",
    "tag": null,
    "settings": [
      {
        "type": "checkbox",
        "id": "style_line_bottom",
        "label": "Style line bottom"
      },
      {
        "type": "color",
        "id": "input_color",
        "label": "Input color",
        "default": "#000"
      },
      {
        "type": "color",
        "id": "input_place_color",
        "label": "Input placeholder color",
        "default": "#666"
      },
      {
        "type": "color",
        "id": "input_bg",
        "label": "Input background",
        "default": "#d2d2d2"
      },
      {
        "type": "color",
        "id": "input_border_color",
        "label": "Border color",
        "default": "#d2d2d2"
      },
      {
        "type": "checkbox",
        "id": "shadow_input",
        "label": "Show shadow input",
        "default": false
      },
      {
        "type": "number",
        "id": "input_height",
        "label": "Input height",
        "default": 60,
        "info": "Unit: px"
      },
      {
        "type": "number",
        "id": "input_radius",
        "label": "Input radius",
        "default": 3,
        "info": "Unit: px"
      },
      {
        "type": "header",
        "content": "Button"
      },
      {
        "type": "select",
        "id": "button_position",
        "label": "Button position",
        "options": [
          {
            "value": "btn_on_input",
            "label": "On input"
          },
          {
            "value": "btn_bottom_input",
            "label": "Bottom input"
          },
          {
            "value": "btn_inline_input",
            "label": "Inline input"
          }
        ],
        "default": "btn_on_input"
      },
      {
        "type": "number",
        "id": "gap",
        "label": "Gap",
        "default": 5,
        "info": "Unit: px",
        "visible_if": "{{ block.settings.button_position != 'btn_on_input' }}"
      },
      {
        "type": "select",
        "id": "btn_type",
        "label": "Button type",
        "options": [
          { "value": "btn", "label": "Button" },
          { "value": "text", "label": "Text" }
        ],
        "default": "btn"
      },
      {
        "type": "number",
        "id": "btn_width",
        "label": "Button width",
        "default": 90,
        "info": "Unit: px",
        "visible_if": "{{ block.settings.btn_type == 'btn' }}"
      },
      {
        "type": "color_scheme",
        "id": "submit_color",
        "label": "Button submit color",
        "default": "background-1",
        "visible_if": "{{ block.settings.btn_type == 'btn' }}"
      },
      {
        "type": "select",
        "id": "submit_btn_type",
        "label": "Submit type color",
        "default": "btn-primary",
        "options": [
          { "value": "btn-primary", "label": "Primary" },
          { "value": "btn-secondary", "label": "Secondary" }
        ],
        "visible_if": "{{ block.settings.btn_type == 'btn' }}"
      },
      {
        "type": "color",
        "id": "color_link",
        "label": "Color link",
        "default": "#000",
        "visible_if": "{{ block.settings.btn_type == 'text' }}"
      },
      {
        "type": "color",
        "id": "color_hover",
        "label": "Color hover",
        "default": "#000",
        "visible_if": "{{ block.settings.btn_type == 'text' }}"
      },
      {
        "type": "select",
        "id": "btn_text_arrow",
        "label": "Button text or arrow",
        "options": [
          { "value": "text", "label": "Text" },
          { "value": "arrow", "label": "Arrow" },
          { "value": "text_arrow", "label": "Text and Arrow" }
        ],
        "default": "text"
      },
      {
        "type": "text",
        "id": "btn_label",
        "label": "Button label",
        "default": "Subscribe"
      },
      {
        "type": "number",
        "id": "btn_label_font_size",
        "label": "Label font size",
        "default": 13,
        "info": "Unit: px"
      },
      {
        "type": "header",
        "content": "Max width"
      },
      {
        "type": "checkbox",
        "id": "show_max_width",
        "label": "Show max width",
        "default": false
      },
      {
        "type": "number",
        "id": "max_width",
        "label": "Max width",
        "default": 670,
        "info": "Unit: px",
        "visible_if": "{{ block.settings.show_max_width }}"
      },
      {
        "type": "text_alignment",
        "id": "align",
        "label": "Alignment",
        "default": "left",
        "visible_if": "{{ block.settings.show_max_width }}"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 0
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Email Signup",
        "category": "Form"
      }
    ]
  }
  {% endschema %}
  