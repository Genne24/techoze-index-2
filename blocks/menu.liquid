{%- assign bst = block.settings -%}
<div class="theme-blocks-item menu-block color-{{ bst.color_scheme }} text-{{ bst.text_alignment }}{% if bst.responsive_alignment %} text-xl-{{ bst.alignment_xl }} text-lg-{{ bst.alignment_lg }} text-md-{{ bst.alignment_md }} text-sm-{{ bst.alignment_sm }}{% endif %} type-{{ bst.type }}" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px;--mt-xs: {{ bst.mt_xs }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;--mb-xs: {{ bst.mb_xs }}px; --gap-title: {{ bst.title_gap_bottom }}px; --gap-bottom: {{ bst.gap_bottom }}px; --gap-bottom-lg: {{ bst.gap_bottom_lg }}px;{% if bst.type == 'horizontal' %} --max-width: {{ bst.max_width }}px{% endif %}" {{ block.shopify_attributes }}>
  {% if bst.block_title != blank %}
    <div class="title-block color-title fs-{{ bst.title_font_size }} {{ bst.title_font_weight }} f_pr position-relative{% if bst.h_t %} d-sm-none{% endif %}{% if bst.show_title_border %} bd-b{% endif %}">
      {{ bst.block_title }}
      {% if bst.mobile_acc and bst.type == 'vertical' %}
        <span class="f_btn_sl d-sm-none"><i class="zmdi zmdi-plus"></i></span>
      {% endif %}
    </div>
  {% endif %}
  <div class="block-content{% if bst.block_title != blank and bst.mobile_acc and bst.type == 'vertical' %} h_t{% endif %}{% if settings.animate %} scroll-trigger animate--slide-in{% endif %}{% if bst.hover_effect %} hover_effect{% endif %}">
    {%- assign footer_linklist = bst.menu_handle -%}
    {% if linklists[footer_linklist].links.size > 0 %}
      <ul class="linklist list-unstyled text-{{ bst.link_text_transform }} fs-{{ bst.link_font_size }} fs-lg-{{ bst.link_font_size_lg }} fs-md-{{ bst.link_font_size_lg }} fs-sm-{{ bst.link_font_size_sm }} fs-xs-{{ bst.link_font_size_xs }} {{ bst.link_font_weight }}{% if bst.mobile_acc and bst.type == 'vertical' %} pb-xs-30{% endif %}">
        {% for link in linklists[footer_linklist].links %}
          <li class="linklist-item">
            <a href="{{ link.url }}" class="{{ bst.color_link }} color-hover d-inline-flex relative">
              <span>{{ link.title }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

