{%- assign bst = block.settings -%}
{% style %}
.block-{{ block.id }} {
    --mt-xl: {{ bst.mt_xl }}px;
    --mt-lg: {{ bst.mt_lg }}px;
    --mt-md: {{ bst.mt_md }}px;
    --mt-sm: {{ bst.mt_sm }}px;
    --mb-xl: {{ bst.mb_xl }}px;
    --mb-lg: {{ bst.mb_lg }}px; 
    --mb-md: {{ bst.mb_md }}px;
    --mb-sm: {{ bst.mb_sm }}px;
    max-width: {{ bst.mw }}px;
  }
{% endstyle %}
<div class="block-{{ block.id }} theme-blocks-item image-masonry-block" {{ block.shopify_attributes }}> 
  <div class="row align-items-center jutify-content-{{ bst.alignment }} spacing-10 js-observe-act">
    <div class="col-8">
      <div class="d-flex align-items-end">
        <div class="img-item img-1">
          {% render 'nov-aspect-image', image: bst.img1 %}
        </div>
        <div class="img-item img-2">
          {% render 'nov-aspect-image', image: bst.img2 %}
        </div>
      </div>
      <div class="d-flex mt-10 justify-content-end">
        <div class="img-item img-4">
          {% render 'nov-aspect-image', image: bst.img4 %}
        </div>
        <div class="img-item img-5">
          {% render 'nov-aspect-image', image: bst.img5 %}
        </div>
      </div>
    </div>
    <div class="col-4">
      <div class="img-item img-3 mb-10">
        {% render 'nov-aspect-image', image: bst.img3 %}
      </div>
      <div class="img-item img-6">
        {% render 'nov-aspect-image', image: bst.img6 %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Image Masonry Layout",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "img2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "img3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "img4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "img5",
      "label": "Image 5"
    },
    {
      "type": "image_picker",
      "id": "img6",
      "label": "Image 6"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "number",
      "id": "mw",
      "label": "Max width",
      "default": 960
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing Top (px)"
    },
    {
      "type": "number",
      "id": "mt_xl",
      "label": "Large laptop",
      "default": 0,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mt_lg",
      "label": "Laptop",
      "default": 0,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mt_md",
      "label": "Tablet",
      "default": 0,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mt_sm",
      "label": "Mobile",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing Bottom (px)"
    },
    {
      "type": "number",
      "id": "mb_xl",
      "label": "Large laptop",
      "default": 0,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mb_lg",
      "label": "Laptop",
      "default": 0,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mb_md",
      "label": "Tablet",
      "default": 0,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mb_sm",
      "label": "Mobile",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Image Masonry Layout",
      "category": "Content"
    }
  ]
}
{% endschema %}