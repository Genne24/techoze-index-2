      },
      {
        "type": "number",
        "id": "pl_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px",
        "visible_if": "{{ block.settings.pl_enable }}"
      },
      {
        "type": "number",
        "id": "pl_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px",
        "visible_if": "{{ block.settings.pl_enable }}"
      },
      {
        "type": "number",
