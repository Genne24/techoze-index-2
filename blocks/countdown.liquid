      },
      {
        "type": "number",
        "id": "number_font_size_md",
        "label": "Font size",
        "default": 18,
        "info": "Breakpoint 768px ↑"
      },
      {
        "type": "number",
        "id": "number_font_size_sm",
        "label": "Font size",
        "default": 16,
        "info": "Breakpoint 425px ↑"
      },
      {
        "type": "number",
        "id": "number_font_size_xs",
