{%- assign bst = block.settings -%}
{% style %}
  #block-{{ block.id }} {
    --gap: {{ bst.gap }}px;
    --size-xl: {{ bst.size_xl | divided_by: 10.0 | append: 'rem' }};
    --size-md: {{ bst.size_md | divided_by: 10.0 | append: 'rem' }};
    --size-sm: {{ bst.size_sm | divided_by: 10.0 | append: 'rem' }};
    --size-xs: {{ bst.size_xs | divided_by: 10.0 | append: 'rem' }};
    --number-font-size-xl: {{ bst.number_font_size_xl | divided_by: 10.0 | append: 'rem' }};
    --number-font-size-md: {{ bst.number_font_size_md | divided_by: 10.0 | append: 'rem' }};
    --number-font-size-sm: {{ bst.number_font_size_sm | divided_by: 10.0 | append: 'rem' }};
    --number-font-size-xs: {{ bst.number_font_size_xs | divided_by: 10.0 | append: 'rem' }};
    --label-font-size-xl: {{ bst.label_font_size_xl }}px;
    --label-font-size-md: {{ bst.label_font_size_md }}px;
    --label-font-size-sm: {{ bst.label_font_size_sm }}px;
    --label-font-size-xs: {{ bst.label_font_size_xs }}px;
    --bg: {{ bst.bg_cd }};
    --bd-color: {{ bst.bd_cd }};
    --corner: {{ bst.border_radius }}px;
    --dot-color: {{ bst.dot_color }};
  }
  #block-{{ block.id }} .data-number {
    color: {{ bst.color_number }};
  }
  #block-{{ block.id }} .name-time {
    color: {{ bst.color_label }};
    text-transform: {{ bst.tt_label }};
    margin-top: {{bst.label_spacing_top }}px;
  }
{% endstyle %}
<div id="block-{{ block.id }}" class="theme-blocks-item countdown-block text-{{ bst.block_alignment }} {{ bst.style }}{% if bst.show_dots %} show-dot{% endif %}" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;" {{ block.shopify_attributes }}>
  {% if bst.countdown_timeend != blank %}
    <div class="countdownfree d-inline-flex text-{{ bst.text_alignment }}{% if bst.show_shadow %} shadow{% endif %}" data-countdown="{{ bst.countdown_timeend }}" data-show-days="{{ settings.show_day }}" data-restart="{{ settings.restart }}"></div>
  {% else %}
    <div class="countdownfree d-inline-flex text-{{ bst.text_alignment }}{% if bst.show_shadow %} shadow{% endif %}">
      <div class="item-time"><span class="data-number">24</span><span class="name-time">Days</span></div>
      <div class="item-time"><span class="data-number">09</span><span class="name-time">Hours</span></div>
      <div class="item-time"><span class="data-number">28</span><span class="name-time">Mins</span></div>
      <div class="item-time"><span class="data-number">21</span><span class="name-time">Secs</span></div>
    </div>
  {% endif %}
</div>
  
{% schema %}
  {
    "name": "Countdown",
    "tag": null,
    "settings": [
      {
        "type": "text",
        "id": "countdown_timeend",
        "label": "Time end",
        "placeholder": "YYYY-MM-DD"
      },
      {
        "type": "paragraph",
        "content": "Format: 'Year-Month-Day'"
      },
      {
        "type": "paragraph",
        "content": "Example: '2022-01-30'"
      },
      {
        "type": "header",
        "content": "Style"
      },
      {
        "type": "select",
        "id": "style",
        "label": "Style",
        "options": [
          {
          "value": "style1",
          "label": "Style 1"
          },
          {
            "value": "style2",
            "label": "Style 2"
          },
          {
            "value": "style3",
            "label": "Style 3"
          }
        ],
        "default": "style1"
      },
      {
        "type": "range",
        "id": "gap",
        "min": 0,
        "max": 70,
        "step": 1,
        "unit": "px",
        "label": "Gap",
        "default": 10
      },
      {
        "type": "checkbox",
        "id": "show_dots",
        "label": "Show dot",
        "default": false
      },
      {
        "type": "color",
        "id": "dot_color",
        "label": "Dot color",
        "default": "#222",
        "visible_if": "{{ block.settings.show_dots }}"
      },
      {
        "type": "range",
        "id": "border_radius",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Border radius",
        "default": 0,
        "visible_if": "{{ block.settings.style != 'style3' }}"
      },
      {
        "type": "color",
        "id": "bg_cd",
        "label": "Background",
        "default": "#f2f2f2",
        "visible_if": "{{ block.settings.style != 'style3' }}"
      },
      {
        "type": "color",
        "id": "bd_cd",
        "label": "Border color",
        "default": "#EAEAEA",
        "visible_if": "{{ block.settings.style != 'style3' }}"
      },
      {
        "type": "checkbox",
        "id": "show_shadow",
        "label": "Show shadow",
        "visible_if": "{{ block.settings.style != 'style3' }}"
      },
      {
        "type": "header",
        "content": "Size",
        "visible_if": "{{ block.settings.style != 'style3' }}"
      },
      {
        "type": "range",
        "id": "size_xl",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Large laptop",
        "default": 40,
        "info": "Breakpoint 1200px ↑",
        "visible_if": "{{ block.settings.style != 'style3' }}"
      },
      {
        "type": "range",
        "id": "size_md",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Tablet",
        "default": 40,
        "info": "Breakpoint 768px ↑",
        "visible_if": "{{ block.settings.style != 'style3' }}"
      },
      {
        "type": "range",
        "id": "size_sm",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Mobile",
        "default": 40,
        "info": "Breakpoint 425px ↑",
        "visible_if": "{{ block.settings.style != 'style3' }}"
      },
      {
        "type": "range",
        "id": "size_xs",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Small mobile",
        "default": 40,
