{%- assign bst = block.settings -%}
{% style %}
  .block-{{ block.id }} {
    --mt-xl: {{ bst.mt_xl }}px;
    --mt-lg: {{ bst.mt_lg }}px;
    --mt-md: {{ bst.mt_md }}px;
    --mt-sm: {{ bst.mt_sm }}px;
    --mb-xl: {{ bst.mb_xl }}px;
    --mb-lg: {{ bst.mb_lg }}px; 
    --mb-md: {{ bst.mb_md }}px;
    --mb-sm: {{ bst.mb_sm }}px;
  }
  .block-{{ block.id }} .image-wrapper {
    border-radius: {{ bst.corner }}px;
    transform: translateZ(0);
  }
{% endstyle %}
<div id="" class="theme-blocks-item lookbook-block block-{{ block.id }} position-relative" {{ block.shopify_attributes }}>
  <div class="image-wrapper overflow_hidden">
    {% if bst.lookbook_image != blank %}
      {% render 'nov-aspect-image', image: bst.lookbook_image %}
    {% else %}
      {%- capture current -%}{% cycle 1, 2, 3 %}{%- endcapture -%}
      {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>
    {% content_for 'blocks' %}
</div>
  
{% schema %}
  {
    "name": "LookBook",
    "tag": null,
    "blocks": [
      {
        "type": "_lookbook-item"
      }
    ],
    "settings": [
      {
        "type": "image_picker",
        "id": "lookbook_image",
        "label": "Image"
      },
      {
        "type": "number",
        "id": "corner",
        "label": "Corner radius (px)",
        "default": 0
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 0
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "LookBook",
        "category": "Interaction",
        "blocks": {
          "lookbook": {
            "type": "_lookbook-item"
          }
        },
        "block_order": ["lookbook"]
      }
    ]
  }
{% endschema %}