{%- assign bst = block.settings -%}
{% style %}
.block-{{ block.id }} {
    --mt-xl: {{ bst.mt_xl }}px;
    --mt-lg: {{ bst.mt_lg }}px;
    --mt-md: {{ bst.mt_md }}px;
    --mt-sm: {{ bst.mt_sm }}px;
    --mb-xl: {{ bst.mb_xl }}px;
    --mb-lg: {{ bst.mb_lg }}px; 
    --mb-md: {{ bst.mb_md }}px;
    --mb-sm: {{ bst.mb_sm }}px;
    --corner-radius: {{ bst.corner_radius }}px;
  }
{% endstyle %}
<div class="block-{{ block.id }} theme-blocks-item tiwrt-block" {{ block.shopify_attributes }}> 
  <div class="row spacing-30 spacing-xs-10">
    <div class="col-6">
      <div class="img-item img-1">
        {% render 'nov-aspect-image', image: bst.img1 %}
      </div>
    </div>
    <div class="col-6">
      <div class="img-item img-2">
        {% render 'nov-aspect-image', image: bst.img2 %}
      </div>
    </div>
  </div>
  <div class="position-relative mt-30 mt-xs-10">
    <div class="img-item img-3">
      {% render 'nov-aspect-image', image: bst.img3 %}
    </div>
    <div class="bp position-absolute d-flex align-items-center justify-content-center">
      <div class="bp-img">
        {% render 'nov-aspect-image', image: bst.bp_img %}
      </div>
      <svg class="svg-text-cricle position-absolute center-center" width="270" height="270" viewBox="0 0 270 270" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <path id="circlePath{{ block.id }}" d="M 135,30 a 105,105 0 1,1 0,210 a 105,105 0 1,1 0,-210" />
        </defs>
        <text>
          <textPath href="#circlePath{{ block.id }}" textLength="655">
            {{ bst.text }}&nbsp;
          </textPath>
        </text>
      </svg>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "3 Image - Rotating Text",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "img2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "img3",
      "label": "Image 3"
    },
    {
      "type": "number",
      "id": "corner_radius",
      "label": "Corner radius",
      "default": 10,
      "info": "Unit: px"
    },
    {
      "type": "header",
      "content": "Block Text"
    },
    {
      "type": "image_picker",
      "id": "bp_img",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Spacing Top (px)"
    },
    {
      "type": "number",
      "id": "mt_xl",
      "label": "Large laptop",
      "default": 0,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mt_lg",
      "label": "Laptop",
      "default": 0,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mt_md",
      "label": "Tablet",
      "default": 0,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mt_sm",
      "label": "Mobile",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing Bottom (px)"
    },
    {
      "type": "number",
      "id": "mb_xl",
      "label": "Large laptop",
      "default": 0,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mb_lg",
      "label": "Laptop",
      "default": 0,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mb_md",
      "label": "Tablet",
      "default": 0,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mb_sm",
      "label": "Mobile",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Three Images With Rotating Text",
      "category": "Content"
    }
  ]
}
{% endschema %}