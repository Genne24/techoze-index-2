
{%- liquid
  assign bst = block.settings
  assign aspect = bst.aspect
  if aspect == 'custom'
    assign aspect = bst.aspect_custom
  endif
  assign class = 'no-ef'
  if bst.img_loading_animation
    assign class = ''
  endif

  assign style_width = ''
  assign style_height = ''
  assign wu = bst.image_width_unit
  assign hu = bst.image_height_unit

  if bst.width_custom
    assign style_width = '--image-width:' | append: bst.image_width | append: wu | append: ';'
  endif
  if bst.height_custom
    assign style_height = '--image-height:' | append: bst.image_height | append: hu | append: ';--image-height-xl:' | append: bst.image_height_xl | append: hu | append: ';--image-height-lg:' | append: bst.image_height_lg | append: hu | append: ';--image-height-md:' | append: bst.image_height_md | append: hu | append: ';--image-height-sm:' | append: bst.image_height_sm | append: hu | append: ';--image-height-xs:' | append: bst.image_height_xs | append: hu | append: ';'
  endif

  assign style_mt = '--mt-xxl: ' | append: bst.mt_xxl | append: 'px;--mt-xl: ' | append: bst.mt_xl | append: 'px;--mt-lg: ' | append: bst.mt_lg | append: 'px;--mt-md: ' | append: bst.mt_md | append: 'px;--mt-sm: ' | append: bst.mt_sm | append: 'px;'
  assign style_mb = '--mb-xxl: ' | append: bst.mb_xxl | append: 'px;--mb-xl: ' | append: bst.mb_xl | append: 'px;--mb-lg: ' | append: bst.mb_lg | append: 'px;--mb-md: ' | append: bst.mb_md | append: 'px;--mb-sm: ' | append: bst.mb_sm | append: 'px;'

  assign style_object_fit = '--object-fit: ' | append: bst.image_object_fit | append: ';'
  assign style_radius = '--image-radius: ' | append: bst.image_radius | append: 'px;'

  assign image_style = style_width | append: style_height | append: style_object_fit | append: style_radius | append: style_mt | append: style_mb
-%}
<div class="theme-blocks-item block-{{ block.id }} image-block position-relative{% if bst.parallax %} block__parallax{% endif %}{% if bst.img_animation != 'nov-sh-image-2' %} {{ bst.img_animation }}{% endif %}{% if bst.width_custom %} custom-width align-{{ bst.align }}{% endif %}{% if bst.height_custom %} custom-height{% endif %}" style="{{ image_style }}" {{ block.shopify_attributes }}>
  {% if bst.image != blank %}
    <div class="image-wrapper position-relative overflow_hidden{% if bst.parallax %} js-img-parallax js-observe-act{% endif %}{% if bst.img_animation == 'nov-sh-image-2' %} {{ bst.img_animation }}{% endif %}" data-section-id="{{ block.id }}">
      {% render 'nov-imgset', image: bst.image, aspect: aspect, class: class %}
      {% if bst.link != blank %}<a href="{{ bst.link }}" class="d-block absolute t-0 l-0 w-100 h-100" title="{{ bst.image.alt }}"></a>{% endif %}
    </div>
    {% if bst.content %}
      <div class="img-blocks-content position-absolute {{ bst.content_position }} {{ bst.content_visibility }}{% if bst.content_visibility == 'content-partial-reveal' %} js-height{% endif %}{% if bst.display_flex %} d-flex align-items-center justify-content-between{% endif %}" style="--horizontal: {{ bst.content_position_horizontal }}%;--vertical: {{ bst.content_position_vertical }}%; width: {{ bst.content_width }}%; --width-md: {{ bst.content_width_md }}%; --width-xs: {{ bst.content_width_xs }}%; --bg: {{ bst.content_bg }}; --corner: {{ bst.content_corner }}px; --padding: {{ bst.content_padding }}px; --blur: {{ bst.content_blur }}px;{% if bst.content_shadow %} box-shadow: 0 8px 20px rgba(0,0,0,0.08){% endif %}">
        {% content_for 'blocks' %}
      </div>
    {% endif %}
  {% else %}
    <div class="placeholder-image">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {% endif %}
  
  {% for i in (1..3) %}
    {%- liquid
      assign pattern_image_id = 'pattern_image' | append: i
      assign pattern_image_animation_id = 'pattern_image_animation' | append: i
      assign pattern_position_id = 'pattern_position' | append: i
      assign pattern_position_horizontal_id = 'pattern_position_horizontal' | append: i
      assign pattern_position_vertical_id = 'pattern_position_vertical' | append: i
      assign pattern_width_id = 'pattern_width' | append: i
      assign pattern_index_id = 'pattern_index' | append: i
      assign hover_rotation_effect_id = 'hover_rotation_effect' | append: i
    -%}
    {% if bst[pattern_image_id] != blank %}
      <div class="pattern-image position-absolute overflow_hidden {{ bst.img_animation }} {{ bst[pattern_position_id] }}{% if bst[hover_rotation_effect_id] %} rotate-effect{% endif %}" style="--horizontal: {{ bst[pattern_position_horizontal_id] }}%;--vertical: {{ bst[pattern_position_vertical_id] }}%; width: {{ bst[pattern_width_id] }}%;border-radius: {{ bst.image_radius }}px;{% if bst[pattern_index_id] == 'up' %} z-index: 2;{% endif %}">
        {% if bst[pattern_image_animation_id] %}
          <div class="img_animate">
            <div class="layer" data-depth="{{ forloop.index | plus: 5 | times: 0.1 }}">
              {% render 'nov-imgset', image: bst[pattern_image_id], class: 'no-ef' %}
            </div>
          </div>
        {% else %}
          {% render 'nov-imgset', image: bst[pattern_image_id], class: 'no-ef' %}
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>

