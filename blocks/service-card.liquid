{%- assign bst = block.settings -%}
<div class="theme-blocks-item sercard-block text-center color-{{ bst.color }}{% if bst.style_hover %} style-hover{% endif %}" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;--bg: {{ bst.bg }}; --corner: {{ bst.corner_radius }}px; --icon-size: {{ bst.icon_size }}px; --icon-c: {{ bst.icon_color }};{% if bst.style_hover %} --bgh: {{ bst.bg_h }};--icon-ch: {{ bst.icon_colorh }}; --title-ch: {{ bst.title_ch }};--desc-ch: {{ bst.desc_ch }}; --btn-ch: {{ bst.btn_ch }};--btn-bgh: {{ bst.btn_bgh }};--btn-bdh: {{ bst.btn_bdh }}{% endif %}" {{ block.shopify_attributes }}>
  {% if bst.icon != blank or bst.icon_svg != blank %}
    <div class="icon m-center-auto mb-35">
      {%- if bst.icon != blank -%}
        {% render 'nov-aspect-image', image: bst.icon, aspect: bst.aspect, class: 'no-ef' %}
      {%- elsif bst.icon_svg != blank -%}
        {{ bst.icon_svg }}
      {%- endif -%}
    </div>
  {% endif %}
  <div class="title h2 fs-20 fs-lg-16 color-title">{{ bst.title }}</div>
  {% if bst.desc != blank %}
    <div class="desc fs-14 fs-lg-12 color-text mt-25">{{ bst.desc }}</div>
  {% endif %}
  {% if bst.btn_label != blank and bst.btn_link != blank %}
    <a href="{{ bst.btn_link }}" class="btn mt-35">
      <span>{{ bst.btn_label }}</span>
      <i class="zmdi zmdi-long-arrow-right"></i>
    </a>
  {% endif %}
</div>
{% schema %}
{
  "name": "Service Card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "html",
      "id": "icon_svg",
      "label": "Icon SVG",
      "info": "Replace fill and stroke color with 'currentColor' to use custom color",
      "default": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z\"/></svg>"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#444444",
      "visible_if": "{{ block.settings.icon_svg != blank }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Icon size",
      "default": 30
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Lorem"
    },
    {
      "type": "inline_richtext",
      "id": "desc",
      "label": "Description",
      "default": "Description"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#fff"
    },
    {
      "type": "color_scheme",
      "id": "color",
      "label": "Color",
      "default": "background-1"
    },
    {
      "type": "number",
      "id": "corner_radius",
      "label": "Corner radius",
      "default": 5
    },
    {
      "type": "header",
      "content": "Style Hover"
    },
    {
      "type": "checkbox",
      "id": "style_hover",
      "label": "Enable style hover"
    },
    {
      "type": "color",
      "id": "bg_h",
      "label": "Background",
      "default": "#fff",
      "visible_if": "{{ block.settings.style_hover }}"
    },
    {
      "type": "color",
      "id": "icon_colorh",
      "label": "Icon color",
      "default": "#222",
      "visible_if": "{{ block.settings.icon_svg != blank and block.settings.style_hover }}"
    },
    {
      "type": "color",
      "id": "title_ch",
      "label": "Title color",
      "default": "#222",
      "visible_if": "{{ block.settings.style_hover }}"
    },
    {
      "type": "color",
      "id": "desc_ch",
      "label": "Description color",
      "default": "#444",
      "visible_if": "{{ block.settings.style_hover }}"
    },
    {
      "type": "color",
      "id": "btn_ch",
      "label": "Button color",
      "default": "#fff",
      "visible_if": "{{ block.settings.style_hover }}"
    },
    {
      "type": "color",
      "id": "btn_bgh",
      "label": "Button background",
      "default": "#444",
      "visible_if": "{{ block.settings.style_hover }}"
    },
    {
      "type": "color",
      "id": "btn_bdh",
      "label": "Button border",
      "default": "#eaeaea",
      "visible_if": "{{ block.settings.style_hover }}"
    },
    {
      "type": "header",
      "content": "Spacing Top (px)"
    },
    {
      "type": "number",
      "id": "mt_xl",
      "label": "Large laptop",
      "default": 30,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mt_lg",
      "label": "Laptop",
      "default": 30,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mt_md",
      "label": "Tablet",
      "default": 30,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mt_sm",
      "label": "Mobile",
      "default": 30
    },
    {
      "type": "header",
      "content": "Spacing Bottom (px)"
    },
    {
      "type": "number",
      "id": "mb_xl",
      "label": "Large laptop",
      "default": 30,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mb_lg",
      "label": "Laptop",
      "default": 30,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mb_md",
      "label": "Tablet",
      "default": 30,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mb_sm",
      "label": "Mobile",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Service Card",
      "category": "Interaction"
    }
  ]
}
{% endschema %}