{%- assign bst = block.settings -%}
{% style %}
  #block-{{ block.id }} {
    --title-color: {{ bst.title_color }};
    --input-color: {{ bst.input_color }};
    --input-place-color: {{ bst.input_place_color }};
    --input-bg: {{ bst.input_bg }};
    --input-border-color: {{ bst.input_border_color }};
    --input-height: {{ bst.input_height }}px;
    --input-radius: {{ bst.input_radius }}px;
    --textarea-radius: {{ bst.textarea_radius }}px;
    --btn-width: {{ bst.btn_width }}px;
    --btn-label-font-size: {{ bst.btn_label_font_size }}px;
    --max-width: {{ bst.max_width }}px;
    --color-link: {{ bst.color_link }};
    --color-hover: {{ bst.color_hover }};
    --gap-horizontal: {{ bst.gap_horizontal }}px;
    --gap-vertical: {{ bst.gap_vertical }}px;
  }
{% endstyle %}
<div id="block-{{ block.id }}" class="theme-blocks-item contact-form-block{% if bst.show_max_width %} max-width{% endif %}" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;" {{ block.shopify_attributes }}>

  {% form 'contact', id: block.id %}   
    {% if form.posted_successfully? %}
      <p class="note form-success mb-30">
        {{ 'page.contact.form.post_success' | t }}
      </p>
    {% endif %}
    
    {{ form.errors | default_errors }}
    
    <div class="form-group row">

      <div class="item{% render 'number-to-col', md: bst.md %}">
        {% if bst.show_title %}
          <div class="form-title">{{ 'page.contact.form.name' | t }}</div>
        {% endif %}
        <input type="text" name="contact[name]" value="{% if form.fields.name %}{{ form.fields.name }}{% elsif customer %}{{ customer.name }}{% endif %}" class="mb-0 {% if form.errors contains 'name' %}input--error{% endif %}" placeholder="{{ 'page.contact.form.name' | t }}" required>
      </div>

      <div class="item{% render 'number-to-col', md: bst.md %}">
        {% if bst.show_title %}
          <div class="form-title">{{ 'page.contact.form.email' | t }}</div>
        {% endif %}
        <input type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" class="mb-0 {% if form.errors contains 'email' %}input--error{% endif %}" placeholder="{{ 'page.contact.form.email' | t }}" required>
      </div>

      <div class="item {% unless bst.enable_custom_form1 or bst.enable_custom_form2 or bst.enable_custom_form3 %}col-12{% else %}{% render 'number-to-col', md: bst.md %}{% endunless %}">
        {% if bst.show_title %}
          <div class="form-title">{{ 'page.contact.form.phone' | t }}</div>
        {% endif %}
        <input type="tel" name="contact[phone]" pattern="[0-9\-]*" value="{% if form.fields.phone %}{{ form.fields.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" class="mb-0 {% if form.errors contains 'phone' %}input--error{% endif %}" placeholder="{{ 'page.contact.form.phone' | t }}">
      </div>

      {% for i in (1..3) %}
        {%- liquid
          assign enable_custom_form_id = 'enable_custom_form' | append: i
          assign enable_custom_form_title_id = 'enable_custom_form_title' | append: i
        -%}
        {% if bst[enable_custom_form_id] %}
          <div class="item{% render 'number-to-col', md: bst.md %}">
            {% if bst.show_title %}
              <div class="form-title">{{ bst[enable_custom_form_title_id] }}</div>
            {% endif %}
            <select name="contact[{{ bst[enable_custom_form_title_id] }}]" class="pointer" required>
              <option disabled hidden selected value="">{{ bst[enable_custom_form_title_id] }}</option>
              {% for n in (1..6) %}
                {% assign custom_form_value_id = 'custom_form_value' | append: i | append: n %}
                {% if bst[custom_form_value_id] != blank %}
                  <option value="{{ bst[custom_form_value_id] }}">{{ bst[custom_form_value_id] }}</option>
                {% endif %}
              {% endfor %}
            </select>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    {% if bst.show_title %}
      <div class="form-title">{{ 'page.contact.form.message' | t }}</div>
    {% endif %}
    <textarea rows="9" cols="50" name="contact[body]" placeholder="{{ 'page.contact.form.message' | t }}">{% if form.body %}{{ form.body }}{% endif %}</textarea>

    <div class="form-button text-{{ bst.btn_alignment }}">
      <button type="submit" class="pointer{% if bst.btn_type == 'text' %} link f_pr font-700{% else %} btn color-{{ bst.submit_color }} {{ bst.submit_btn_type }}{% if bst.full_width %} w-100{% endif %}{% endif %}">
        <span class="position-relative d-flex align-items-center justify-content-center">
          {% if bst.btn_text_arrow == 'text' or bst.btn_text_arrow == 'text_arrow' %}
            {{ bst.btn_label }}
          {% endif %}
          {% if bst.btn_text_arrow == 'arrow' or bst.btn_text_arrow == 'text_arrow' %}
            <i class="zmdi zmdi-long-arrow-right"></i>
          {% endif %}
        </span>
      </button>
    </div>
  {% endform %}
</div>
