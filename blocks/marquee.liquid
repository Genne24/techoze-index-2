      }
    ],
    "presets": [
      {
        "name": "Marquee",
        "category": "Content",
        "blocks": [
          {
            "type": "text"
          },
          {
            "type": "text"
          },
          {
            "type": "text"
          }
        ]
      }
    ]
  }
  {% endschema %}
  