{%- assign bst = block.settings -%}
{% style %}
  #block-{{ block.id }} {
    --mt-xl: {{ bst.mt_xl }}px;
    --mt-lg: {{ bst.mt_lg }}px;
    --mt-md: {{ bst.mt_md }}px;
    --mt-sm: {{ bst.mt_sm }}px;
    --mb-xl: {{ bst.mb_xl }}px;
    --mb-lg: {{ bst.mb_lg }}px;
    --mb-md: {{ bst.mb_md }}px;
    --mb-sm: {{ bst.mb_sm }}px;
    {% if bst.enable_custom_style %}
      --product-color-border: {{ bst.product_border_color }};
      --product-corner-radius: {{ bst.product_corner }}px
      {% endif %}
    {% if bst.product_bg_enable %}
    --product-color-background: {{ bst.product_background_color }};
    {% endif %}
    {% if bst.show_nav %}
      --slider-arrow-color: {{ bst.slider_arrow_color }};
      --slider-arrow-color-act: {{ bst.slider_arrow_color_act }};
    {% endif %}
  }
{% endstyle %}
<div id="block-{{ block.id }}" class="theme-blocks-item product-list-block position-relative {{ bst.arrow_color }} {{ bst.dots_color }}{% if bst.disable_rating %} dis-ratings{% endif %}{% if bst.disable_type %} dis-type{% endif %}{% if bst.enable_custom_style %}{% if bst.product_border_enable %} item-product-show-bd{% endif %}{% if bst.product_bg_enable %} item-product-show-bg{% endif %}{% endif %}" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div class="{% if bst.product_item_style == 'grid' %}grid--view-items{% else %}list--view-items{% endif %} nov-slick-carousel{% if settings.product_shadow_hv %} hv_box_shadow{% endif %} spacing-{{ bst.spacing }} spacing-sm-15{% if bst.right_overflow %} overflow-right{% endif %}"
    data-autoplay="false"
    data-autoplayTimeout="6000"
    data-loop="{{ bst.loop }}"
    data-dots="{{ bst.show_dots }}"
    data-nav="false"
    data-items_xxl="{{ bst.xxl }}"
    data-items_xl="{{ bst.xl }}"
    data-items_lg="{{ bst.lg }}"
    data-items_md="{{ bst.md }}"
    data-items_sm="{{ bst.sm }}"
    data-items_xs="{{ bst.xs }}"
    data-row="{{ bst.row_number }}"
    data-row_mobile="{{ bst.row_number }}"
    style="--spacing: {{ bst.spacing | append: 'px' }}">
    {% for product in collections[bst.collection].products limit: bst.limit %}
      <div class="sp-item item {{ bst.spacing | prepend: 'mb-' }}">
        {% if bst.product_item_style == 'grid' %}
          {% render 'product-grid-item-style-1', product: product, section_id: section.id %}
        {% else %}
          {% render 'product-list-item-style-1', product: product, section_id: section.id %}
        {% endif %}
      </div>
    {% else %}
      {%- for i in (1..6) -%}
        {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
        <div class="sp-item item">
          {{ 'product-apparel-' | append: current | placeholder_svg_tag : 'placeholder-svg' }}
        </div>
      {%- endfor -%}
    {% endfor %}
  </div>
  {% if bst.show_nav or bst.bst.show_dots %}
    <div class="d-flex align-items-center mt-60 mt-sm-30">
      {% if bst.show_nav %}<div class="nav-arrow nav-prev pointer">{% render 'icon-arrow-prev' %}</div>{% endif %}
      {% if bst.show_dots %}<div class="append-dots"></div>{% endif %}
      {% if bst.show_nav %}<div class="nav-arrow nav-next pointer">{% render 'icon-arrow-next' %}</div>{% endif %}
    </div>
  {% endif %}
</div>
  
{% schema %}
  {
    "name": "Product List",
    "tag": null,
    "settings": [
      {
        "type":  "header",
        "content": "Block Product"
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      },
      {
        "type": "select",
        "id": "product_item_style",
        "label": "Product item style",
        "options": [
          {
            "value": "grid",
            "label": "Grid"
          },
          {
            "value": "list",
            "label": "List"
          }
        ],
        "default": "grid"
      },
      {
        "type": "range",
        "id": "limit",
        "min": 1,
        "max": 30,
        "step": 1,
        "label": "Limit",
        "default": 10,
        "info": "Select number limit products"
      },
      {
        "type": "range",
        "id": "spacing",
        "min": 0,
        "max": 70,
        "step": 5,
        "unit": "px",
        "label": "Spacing item",
        "default": 30
      },
      {
        "type": "header",
        "content": "Slider Options"
      },
      {
        "type": "checkbox",
        "id": "loop",
        "label": "Loop"
      },
      {
        "type": "range",
        "id": "row_number",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Number row",
        "default": 1
      },
      {
        "type": "checkbox",
        "id": "show_dots",
        "label": "Show dots"
      },
      {
        "type": "select",
        "id": "dots_color",
        "label": "Dots color",
        "default": "dots_on_light",
        "options": [
          {"value": "dots_on_light","label": "Dots on light background"},
          {"value": "dots_on_dark","label": "Dots on dark background"}
        ],
        "visible_if": "{{ block.settings.show_dots }}"
      },
      {
        "type": "checkbox",
        "id": "show_nav",
        "label": "Show prev/next arrow"
      },
      {
        "type": "color",
        "id": "slider_arrow_color",
        "label": "Color",
        "default": "#222",
        "visible_if": "{{ block.settings.show_nav }}"
      },
      {
        "type": "color",
        "id": "slider_arrow_color_act",
        "label": "Color hover",
        "default": "#666",
        "visible_if": "{{ block.settings.show_nav }}"
      },
      {
        "type": "checkbox",
        "id": "right_overflow",
        "label": "Right overflow",
        "info": "Enable to show the right overflow"
      },
      {
        "type":  "header",
        "content": "Product Item Per Row"
      },
      {
        "type": "range",
        "id": "xxl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Desktop",
        "default": 3,
        "info": "Breakpoint 1441px"
      },
      {
        "type": "range",
        "id": "xl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large laptop",
        "default": 3,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "range",
        "id": "lg",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Laptop",
        "default": 3,
        "info": "Breakpoint 992px"
      },
      {
        "type": "range",
        "id": "md",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Tablet",
        "default": 3,
        "info": "Breakpoint 768px"
      },
      {
        "type": "range",
        "id": "sm",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large mobile",
        "default": 2,
        "info": "Breakpoint 576px"
      },
      {
        "type": "range",
        "id": "xs",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Mobile",
        "default": 2,
        "info": "Breakpoint"
      },
      {
        "type": "header",
        "content": "Ratings"
      },
      {
        "type": "checkbox",
        "id": "disable_rating",
        "label": "Disable rating"
      },
      {
        "type": "header",
        "content": "Type"
      },
      {
        "type": "checkbox",
        "id": "disable_type",
        "label": "Disable type"
      },
      {
        "type": "header",
        "content": "Product Item Custom Style"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom style"
      },
      {
        "type": "range",
        "id": "product_corner",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Corner radius",
        "default": 0,
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "checkbox",
        "id": "product_border_enable",
        "label": "Show border",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "product_border_color",
        "label": "Border color",
        "default": "#d2d2d2",
        "visible_if": "{{ block.settings.enable_custom_style and block.settings.product_border_enable }}"
      },
      {
        "type": "checkbox",
        "id": "product_bg_enable",
        "label": "Show background",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "product_background_color",
        "label": "Background color",
        "default": "#d4d4d4",
        "visible_if": "{{ block.settings.enable_custom_style and block.settings.product_bg_enable }}"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 0
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Product List",
        "category": "Product"
      }
    ]
  }
{% endschema %}