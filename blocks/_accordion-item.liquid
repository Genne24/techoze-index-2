<div class="nov-accordion__item position-relative">
  <div class="nov-accordion__title h3 d-flex color-title d-flex align-items-center position-relative mb-0 nov-slick-dot" data-index="">
    {% content_for 'block', type: "text", id: "title" %}
    {% if block.settings.show_arrow %}
      <a href="{{ block.settings.arrow_link }}" class="link m-left-auto"><i class="zmdi zmdi-long-arrow-right"></i></a>
    {% endif %}
  </div>
  <div class="nov-accordion__content">
    <div class="block color-text position-relative">{% content_for 'block', type: "text", id: "content" %}</div>
  </div>
</div>

{% schema %}
  {
    "name": "Accordion Item",
    "tag": null,
    "settings": [
      {
        "type": "checkbox",
        "id": "show_arrow",
        "label": "Show icon arrow"
      },
      {
        "type": "url",
        "id": "arrow_link",
        "label": "Link arrow"
      }
    ],
    "presets": [
      {
        "name": "Accordion Item"
      }
    ]
  }
{% endschema %}
  