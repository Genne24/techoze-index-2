<!doctype html>
<!-- Techoze 2 v.1.0.0 -->
{%- liquid
  assign rtl_languages = 'ar,he,fa,ur,dv,ps,ku,yi'
  assign rtl_list = rtl_languages | split: ','
  assign current_lang = request.locale.iso_code | downcase

  assign iso_rtl = false
  if rtl_list contains current_lang
    assign iso_rtl = true
  endif
-%}
<html class="no-js{% if iso_rtl %} lang-rtl{% endif %}"{% if iso_rtl %} dir="rtl"{% endif %} lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'nov-meta-head' %}
    {% render 'social-meta-tags' %}
    {{ content_for_header }}
    {% render 'font-icon' %}
    {% render 'css-variables' %}
    {% render 'nov-head-css' %}
    {% render 'nov-head-js' %}
    {% render 'variant-options' %}
  </head>
  
  <body class="template-{{ template | split: '.' | first }}{% if template.name == "page" %} {{ page.handle }}{% endif %}">
    {% if template.name != "index" and settings.enable_loadpage %}
      <div class="preloader_nov">
        <div class="nov_load">
          {% render 'nov-aspect-image', image: settings.icon_loadpage, class: 'no-ef' %}
        </div>
      </div>
    {% endif %}

    {% if template.name == "index" %}
      {% sections 'nov-system-group' %}
    {% endif %}
    
    <div class="wb-wp">
      {% case settings.header_layout %}
        {% when 'header-1' %}
          {% sections 'header-group-1' %}
        {% when 'header-2' %}
          {% sections 'header-group-2' %}
        {% when 'header-3' %}
          {% sections 'header-group-3' %}
        {% when 'header-4' %}
          {% sections 'header-group-4' %}
        {% when 'header-5' %}
          {% sections 'header-group-5' %}
        {% when 'header-6' %}
          {% sections 'header-group-6' %}
        {% when 'header-7' %}
          {% sections 'header-group-7' %}
        {% when 'header-8' %}
          {% sections 'header-group-8' %}
        {% when 'header-9' %}
          {% sections 'header-group-9' %}
      {% endcase %}
      <!-- BEGIN sections: Breadcrumb -->
      {% if template.name != 'index' %}
        {%- liquid
          if settings.breadcrumbs_enable
            unless "index 404 password gift_card" contains template.name
              render 'nov-breadcrumb', collection: collection, product: product, blog: blog, article: article
            endunless
          endif
        -%}
      {% endif %}
      <!-- END sections: Breadcrumb -->
      
      <main class="main-content" id="MainContent">
        {{ content_for_layout }}
      </main>
      
      {% case settings.footer_layout %}
        {% when 'footer-1' %}
          {% sections 'footer-group-1' %}
        {% when 'footer-2' %}
          {% sections 'footer-group-2' %}
        {% when 'footer-3' %}
          {% sections 'footer-group-3' %}
        {% when 'footer-4' %}
          {% sections 'footer-group-4' %}
        {% when 'footer-5' %}
          {% sections 'footer-group-5' %}
        {% when 'footer-6' %}
          {% sections 'footer-group-6' %}
        {% when 'footer-7' %}
          {% sections 'footer-group-7' %}
        {% when 'footer-8' %}
          {% sections 'footer-group-8' %}
        {% when 'footer-9' %}
          {% sections 'footer-group-9' %}
      {% endcase %}
    </div>
    {% comment %} <loading-wrapper class="loading-bar d-block fixed t-0 l-0 w-100 h-100 overflow-hidden pointer-events-none" style="background-color: #000000;z-index: 99;"></loading-wrapper> {% endcomment %}
    <div class="sidebar-overlay"></div>
    {% if settings.cart_enable %}
      {% render 'nov-cart-canvas' %}
    {% endif %}
    {% if settings.show_newsletter_popup %}
      {% render 'nov-popup-newsletter' %}
    {% endif %}
    {% render 'nov-popup-video' %}
    {% render 'nov-product-soldout-newsletter' %}
    {% render 'nov-cart-empty' %}
    {% if shop.customer_accounts_enabled %}
      {% render 'nov-block-account' %}
    {% endif %}
    <div class="canvas-menu-top"></div>
    <div id="MobileVerticalMenu"></div>
    {% if settings.enable_stickymenu_mobile %}
      {% render 'nov-stickymenu-mobile' %}
    {% endif %}
    {% if settings.show_fake_order_inner_page %}
      {% render 'nov-popup-fake-order' %}
    {% else %}
      {% if template.name == 'index' %}
        {% render 'nov-popup-fake-order' %}
      {% endif %}
    {% endif %}
    {% if settings.wishlist_enable and settings.show_popup_wishlist %}
      {% render 'nov-popup-wishlist' %}
    {% endif %}
    {% if settings.back_top_enable %}
      {% render 'nov-back-to-top' %}
    {% endif %}
    <script src="{{ 'js-product-variants.js' | asset_url }}" defer></script>
    <script src="{{ 'js-nuranium.js' | asset_url }}" defer></script>
    <script>
      window.addEventListener('load', function() {
        var loader = document.querySelector('.preloader_nov');
        if (loader) {
          window.addEventListener('beforeunload', function() {
            loader.style.transition = 'opacity 0.5s';
            loader.style.opacity = '1';
          });

          setTimeout(function() {
            loader.style.transition = 'opacity 1.5s';
            loader.style.opacity = '0';
          }, 0);
        }
      });
      {% if template.name == "index" %}
        var hasVerticalMenu = document.querySelector('.shopify-section-group-nov-system-group.section-vertical-menu');
        var wbWp = document.querySelector('.btn-vertical-desktop');
        var wbMb = document.querySelector('.btn-vertical-mobile');
        if (hasVerticalMenu) {
          if (wbWp) wbWp.classList.add('open');
          if (wbMb) wbMb.classList.add('active');
        }
      {% endif %}
      document.querySelectorAll('.btn-alternate').forEach((btn) => {
        btn.addEventListener('mouseenter', () => {
            btn.classList.remove('is-leave');
            btn.classList.add('is-hover');
        });
        btn.addEventListener('mouseleave', () => {
            btn.classList.remove('is-hover');
            btn.classList.add('is-leave');
        });
      });
    </script>
  </body>
</html>